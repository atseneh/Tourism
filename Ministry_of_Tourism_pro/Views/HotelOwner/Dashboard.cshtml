            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-rc.0/js/select2.min.js"></script>
    <script>
    function switchTab(tabName) {
        $('.tab-link').removeClass('active');
        $(`.tab-link[data-tab="${tabName}"]`).addClass('active');
        $('.tab-content').hide();
        $(`#${tabName}Tab`).show();
        
        if (tabName === 'overview') {
            $('#dynamicSubTitle').text('Manage your property branches and registry information');
            $('#registrySidebarContainer').hide();
        }
        
        if (tabName === 'editor') {
            $('.dashboard-header').addClass('active-form');
            $('#registrySidebarContainer').show();
            initMap();
            
            // Check if there is an active unit loaded in the form
            const activeUnitId = $('#editorConsigneeUnitId').val();
            if (!activeUnitId) {
                // No branch loaded in form yet, let's load the active/first branch
                const targetUnitId = _currentSummaryUnitId || Object.keys(window.allBranchesData || {})[0];
                if (targetUnitId) {
                    const branchObj = window.allBranchesData[targetUnitId];
                    if (branchObj) {
                        loadBranchRegistry(branchObj.ConsigneeUnitDescription || branchObj.TradeName, branchObj.Code, branchObj.TIN, targetUnitId);
                    }
                }
            } else {
                // A branch is already loaded, make sure its sidebar subnav is correct
                updateSidebarNav(0);
            }
            
            if ($(window).width() <= 425) {
                $('.collapsible-content').hide();
                $('.collapsible-card').removeClass('active');
                $('#toggleSectionsText').text('Expand All');
                $('#toggleSectionsIcon').removeClass('fa-compress-arrows-alt').addClass('fa-expand-arrows-alt');
            }
            setTimeout(() => { if (map) map.invalidateSize(); }, 200);
        } else {
            $('.dashboard-header').removeClass('active-form');
        }
    }

    function toggleAllSections() {
        const anyClosed = $('.collapsible-card').not('.active').length > 0;
        const btn = $('#toggleSectionsBtn');
        const icon = $('#toggleSectionsIcon');
        const text = $('#toggleSectionsText');

        if (anyClosed) {
            // Expand All
            $('.collapsible-card').addClass('active').find('.collapsible-content').slideDown(300);
            icon.removeClass('fa-expand-arrows-alt').addClass('fa-compress-arrows-alt');
            text.text('Collapse All');
        } else {
            // Collapse All
            $('.collapsible-card').removeClass('active').find('.collapsible-content').slideUp(300);
            icon.removeClass('fa-compress-arrows-alt').addClass('fa-expand-arrows-alt');
            text.text('Expand All');
        }
    }

    $(function() {
        $('#sectionJumpDropdown').on('change', function() {
            const section = $(this).val();
            if (!section) return;
            const $target = $('#section-' + section);
            if ($target.length) {
                $('.collapsible-card').removeClass('active').find('.collapsible-content').slideUp(300);
                $target.addClass('active').find('.collapsible-content').slideDown(300);
                $('html, body').animate({ scrollTop: $target.offset().top - 120 }, 500);
            }
        });

        $('.tab-link').click(function() {
            switchTab($(this).data('tab'));
        });

        $('.update').on('click', function() {
            switchTab('editor');
        });

        // Ensure tables are populated for the initial branch on load
        initStructuredLists(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(hotel)));
        loadAttachments(@hotel.Id);
    });



    function calculateAccommodationTotals() {
        let totals = { rooms: 0, beds: 0 };
        $('.room-count-input').each(function() {
            const val = parseInt($(this).val()) || 0;
            totals.rooms += val;
            
            const id = $(this).attr('id');
            if (id.includes('twin')) {
                totals.beds += (val * 2);
            } else if (id.includes('form-suites')) {
                totals.beds += (val * 3);
            } else if (id.includes('pres-suites')) {
                totals.beds += (val * 3);
            } else if (id.includes('junior-suites')) {
                totals.beds += val;
            } else {
                totals.beds += val;
            }
        });
        $('#form-total-rooms').val(totals.rooms);
        $('#form-total-beds').val(totals.beds);
    }

    function calculateStaffTotals() {
        let total = 0;
        $('.staff-input').each(function() {
            total += parseInt($(this).val()) || 0;
        });
        $('#form-total-staff').val(total);
    }

    $(document).on('input', '.room-count-input', calculateAccommodationTotals);
    $(document).on('input', '.staff-input', calculateStaffTotals);

    // Dimension recalculation for meeting rooms
    $(document).on('input', '.room-dim-input', function() {
        const w = parseFloat($('#meetWidth').val()) || 0;
        const l = parseFloat($('#meetLength').val()) || 0;
        $('#meetAreaSize').val((w * l).toFixed(1));
    });

    function resetMeetingRoomModal() {
        $('#meetHallName').val('');
        $('#meetSetting').val('Indoor');
        $('#meetType').val('');
        $('#meetWidth').val('');
        $('#meetLength').val('');
        $('#meetCeiling').val('');
        $('#meetAreaSize').val('');
        $('#meetMaxCap').val('');
        $('#meetSoundSystem, #meetHVAC, #meetScreen, #meetInterpreter').prop('checked', false);
    }
    function resetRestaurantModal() {
        $('#restName').val('');
        $('#restType').val('All-Day Dining');
        $('#restCapacity').val('');
        $('#restCuisine').val('');
        $('#restHalal, #restVegan').prop('checked', false);
    }
    function resetShopModal() {
        $('#shopName').val('');
        $('#shopType').val('Souvenir');
        $('#shopLocation').val('');
        $('#shopHours').val('');
        $('#shopNotes').val('');
    }

    // Global Branch Data Store for real-time UI synchronization
    window.allBranchesData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ToDictionary(b => b.ConsigneeUnitId.ToString().ToLower(), b => new {
        b.TradeName, b.ConsigneeUnitDescription, b.Code, b.TIN, b.ConsigneeUnitId, b.City, b.Subcity, b.StarCategory, b.RegistrationName, b.SpecificAddress,
        b.TotalRooms, b.TotalBeds, b.KingSizeRooms, b.TwinBedRooms, b.JuniorSuites, b.Suites, b.PresidentialSuites, b.AccessibleRooms,
        b.AllDayDining, b.AllDayDiningSeats, b.SpecialtyRestaurants, b.CoffeeShop, b.BarsCount, b.NightClub, b.SouvenirShops, b.DelegationCatering, b.DelegationCateringMaxPax,
        b.MeetingRoomsCount, b.LargestRoomCapacityTheatre, b.LargestRoomCapacityClassroom, b.LargestRoomCapacityBanquet, b.TotalMeetingSpaceSqm, b.MeetingRooms,
        b.InternetBandwidthDown, b.InternetBandwidthUp, b.LobbyAreaSqm, b.GreenAreaSqm, b.PoolAvailable, b.PoolType, b.SpaAvailable, b.SpaGender, b.MassageService, b.ChildrensPlayground, b.ChildrenDayCare, b.StaffCanteen,
        b.WheelchairRamps, b.ElevatorsCount, b.ElevatorsWheelchairSized, b.PublicAccessibleBathroom,
        b.CCTVPublicAreas, b.FireExtinguishersLastInspection, b.HoseReels, b.SmokeDetectorsInRooms, b.SmokeDetectorsInPublicAreas, b.SprinklerCoverage, b.FireAlarmControlPanel, b.EmergencyExitsCount, b.BagScanner, b.WalkThroughScanner, b.HandScanner,
        b.ParkingSpacesCount, b.BusParkingCount, b.ValetParking, b.ParkingWithin100m, b.ShuttleToAirport, b.PublicTransportWithin500m, b.EvChargingPoints, b.EvChargerTypes,
        b.WifiPropertyWide, b.WifiAvgSpeed, b.InHouseLaundry, b.Reception24hr, b.VipCheckIn, b.PassportScanner, b.CurrencyScanner,
        b.StandbyGeneratorCapacityKva, b.StandbyGeneratorCoverage, b.WaterTreatment, b.WasteSegregation, b.Recycling, b.HazardousWasteHandling,
        b.SustainabilityCertification, b.OtherEcoLabels, b.FoodWasteProgram, b.SustainabilityRefillWaterStations,
        b.TourismServiceCompetenceLicenseCertificate, b.FireSafetyCertificate, b.EnvironmentalClearanceCertificate, b.FoodSafetyAndHygieneCertificate, b.IsoCertification,
        b.TotalStaff, b.LineStaff, b.ManagementStaff, b.InternationalLanguagesFrontDesk,
        Identifications = b.RawIdentifications.Select(id => new { id.Description, id.IdNumber })
    })));

    // Checkbox Sync Logic
    $(document).on('change', '.sync-checkbox', function() {
        const isChecked = $(this).is(':checked');
        const targetId = $(this).data('target');
        const callback = $(this).data('toggle-callback');

        // Update hidden input
        $('#' + targetId).val(isChecked ? "true" : "false");

        // Special callbacks
        if (callback && typeof window[callback] === 'function') {
            window[callback](isChecked);
        }
    });

    // Toggle Group Logic
    $(document).on('click', '.toggle-item', function() {
        const value = $(this).data('value');
        const $group = $(this).closest('.toggle-group');
        const targetId = $group.data('target');
        const callback = $group.data('toggle-callback');

        // Update visual state
        $group.find('.toggle-item').removeClass('active');
        $(this).addClass('active');

        // Update hidden input
        $('#' + targetId).val(value);

        // Special callbacks
        if (callback && typeof window[callback] === 'function') {
            window[callback](value);
        }
    });

    function togglePoolType(val) {
        const isTrue = (val === true || val === "true");
        $('#poolTypeGroup').toggle(isTrue);
    }

    function toggleSpaGender(val) {
        const isTrue = (val === true || val === "true");
        $('#spaGenderGroup').toggle(isTrue);
    }

    function syncToggleGroups() {
        // Sync checkboxes
        $('.sync-checkbox').each(function() {
            const $chk = $(this);
            const targetId = $chk.data('target');
            const value = $('#' + targetId).val();
            const isChecked = (value === 'true' || value === true);
            
            $chk.prop('checked', isChecked);
            
            // Trigger callbacks
            const callback = $chk.data('toggle-callback');
            if (callback && typeof window[callback] === 'function') {
                window[callback](isChecked);
            }
        });

        // Sync old-style toggle groups
        $('.toggle-group').each(function() {
            const $group = $(this);
            const targetId = $group.data('target');
            const value = $('#' + targetId).val();
            
            $group.find('.toggle-item').removeClass('active');
            $group.find(`.toggle-item[data-value="${value}"]`).addClass('active');
            
            const callback = $group.data('toggle-callback');
            if (callback && typeof window[callback] === 'function') {
                window[callback](value);
            }
        });
    }

    async function loadBranchRegistry(branchDescription, branchCode, tin, unitId) {
        if (unitId) unitId = (unitId + '').toLowerCase().trim();
        if (typeof hideBranchSummary === 'function') hideBranchSummary();
        $('#sidebarBranchName').text(branchDescription);
        $('#registrySidebarContainer').show();

        // Update Mobile Editor Header
        $('#mobileEditorName').text(branchDescription);
        $('#mobileEditorTin').text('TIN: ' + (tin || '...'));
        $('#mobileEditorIcon').text((branchDescription || '??').substring(0, 2).toUpperCase());

        $('#editorConsigneeUnitId').val(unitId);
        $('#dynamicSubTitle').text('Editing Branch: ' + branchDescription);
        $('#editorConsigneeId').val(@Json.Serialize(hotel.Id));
        $('#editorTradeName').val(@Json.Serialize(hotel.TradeName));
        
        switchTab('editor');

        $('.collapsible-content').hide();
        $('.collapsible-card').removeClass('active');
        if ($(window).width() <= 425) {
            $('#toggleSectionsText').text('Expand All');
            $('#toggleSectionsIcon').removeClass('fa-compress-arrows-alt').addClass('fa-expand-arrows-alt');
        }
        
        // If desktop, open first section
        if ($(window).width() > 425) {
            $('.collapsible-card:first-child').addClass('active').find('.collapsible-content').show();
        }

        try {
            const response = await fetch(`/HotelOwner/GetBranchRegistry?consigneeUnitId=${unitId}`);
            if (response.ok) {
                const hotel = await response.json();
                
                $('#editorConsigneeId').val(hotel.id);
                $('#editorConsigneeUnitId').val(hotel.consigneeUnitId);
                $('#editorTradeName').val(hotel.name);

                $('#form-trade-name').val(hotel.name);
                $('#form-address-general').val("Addis Ababa");
                $('#form-registration-name').val(hotel.registrationName);
                $('#form-address').val(hotel.specificAddress);
                $('#form-subcity-basic').val(hotel.subcity);
                $('#form-star-cat').val(hotel.starCategory);
                $('#form-total-rooms').val(hotel.totalRooms);
                $('#form-total-beds').val(hotel.totalBeds);
                $('#form-contact-info').val(hotel.contactInformation);
                $('#form-res-contact').val(hotel.reservationsContact);
                $('#form-sust-focal').val(hotel.sustainabilityFocalPoint);

                $('#form-king-rooms').val(hotel.kingSizeRooms);
                $('#form-twin-rooms').val(hotel.twinBedRooms);
                $('#form-junior-suites').val(hotel.juniorSuites);
                $('#form-suites').val(hotel.suites);
                $('#form-pres-suites').val(hotel.presidentialSuites);
                $('#form-acc-rooms').val(hotel.accessibleRooms);
                calculateAccommodationTotals();

                $('#form-all-day-dining').val(String(hotel.allDayDining));
                $('#form-dining-seats').val(hotel.allDayDiningSeats);
                $('#form-spec-rest').val(hotel.specialtyRestaurants);
                $('#form-coffee-shop').val(String(hotel.coffeeShop));
                $('#form-bars-count').val(hotel.barsCount);
                $('#form-night-club').val(String(hotel.nightClub));
                $('#form-shops-count').val(hotel.souvenirShops);
                $('#form-del-cat').val(String(hotel.delegationCatering));
                $('#form-del-cat-max').val(hotel.delegationCateringMaxPax);

                $('#form-meeting-rooms').val(hotel.meetingRoomsCount);
                $('#form-total-meeting-sqm').val(hotel.totalMeetingSpaceSqm);

                $('#form-net-down').val(hotel.internetBandwidthDown);
                $('#form-net-up').val(hotel.internetBandwidthUp);
                $('#form-lobby-sqm').val(hotel.lobbyAreaSqm);
                $('#form-green-sqm').val(hotel.greenAreaSqm);
                $('#form-pool-avail').val(String(hotel.poolAvailable)).trigger('change');
                $('#form-pool-type').val(hotel.poolType);
                $('#form-spa-avail').val(String(hotel.spaAvailable)).trigger('change');
                $('#form-spa-gender').val(hotel.spaGender);
                $('#form-massage').val(String(hotel.massageService));
                $('#form-playground').val(String(hotel.childrensPlayground));

                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Column 2: Voluntary Standards (Lime tint) -->
                        <div style="background: #f7fee7; padding: 1.5rem;">
                            <h4 style="font-size: 0.85rem; font-weight: 800; color: #3f6212; margin-bottom: 1.5rem; text-transform: uppercase; letter-spacing: 0.5px;">Voluntary Standards</h4>
                            
                            <div style="display: flex; flex-direction: column; gap: 0.85rem;">
                                <div class="form-group-inline">
                                    <label class="form-label" style="color: #3f6212;">Other Eco-labels</label>
                                    <input type="text" name="OtherEcoLabels" id="form-eco-labels" value="@hotel.OtherEcoLabels" class="form-control" placeholder="e.g. Green Key..." style="background: white;" />
                                </div>
                                <div class="form-group-inline">
                                    <label class="form-label" style="color: #4d7c0f;">Sustainability Focal</label>
                                    <input type="text" name="SustainabilityFocalPoint" id="form-sust-focal" value="@hotel.SustainabilityFocalPoint" class="form-control" style="background: white;" />
                                </div>
                                <div class="form-group-inline">
                                    <label class="form-label" style="color: #4d7c0f;">Refill Water Stations</label>
                                    <input type="hidden" name="SustainabilityRefillWaterStations" id="form-sust-refill" value="@(hotel.SustainabilityRefillWaterStations == true ? "true" : "false")" />
                                    <label class="premium-checkbox">
                                        <input type="checkbox" class="sync-checkbox" data-target="form-sust-refill" checked="@(hotel.SustainabilityRefillWaterStations == true)" />
                                        <span class="checkbox-text" style="color: #4d7c0f;">Available</span>
                                        <div class="checkbox-box" style="border-color: #65a30d; background: #65a30d;"><i class="fas fa-check" style="color: white;"></i></div>
                                    </label>
                                </div>
                                <div class="form-group-inline">
                                    <label class="form-label" style="color: #3f6212;">Food Waste Program</label>
                                    <input type="hidden" name="FoodWasteProgram" id="form-waste-prog" value="@(hotel.FoodWasteProgram == true ? "true" : "false")" />
                                    <label class="premium-checkbox">
                                        <input type="checkbox" class="sync-checkbox" data-target="form-waste-prog" checked="@(hotel.FoodWasteProgram == true)" />
                                        <span class="checkbox-text" style="color: #4d7c0f;">Enabled</span>
                                        <div class="checkbox-box" style="border-color: #65a30d; background: #65a30d;"><i class="fas fa-check" style="color: white;"></i></div>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn-mobile-save mobile-only" onclick="saveRegistry(this, 'sustainability')">
                        <i class="fas fa-cloud-arrow-up"></i> SAVE SUSTAINABILITY
                    </button>
                </div>
            </div>

            <!-- 12. Staffing & Languages -->
            <div class="collapsible-card" id="section-staffing">
                <div class="collapsible-header" onclick="toggleCollapsible(this)">
                    <h3><i class="fas fa-users" style="color: var(--primary-color);"></i> <span class="section-num">12.</span> STAFFING & LANGUAGES</h3>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <button type="button" class="btn-save-section" onclick="event.stopPropagation(); saveRegistry(this, 'staffing')" title="Update Section">
                            <i class="fas fa-cloud-arrow-up"></i>
                        </button>
                        <i class="fas fa-chevron-down chevron"></i>
                    </div>
                </div>
                <div class="collapsible-content" style="padding: 0;">
                    <div class="form-flex-col-2" style="min-height: 250px; grid-template-columns: 1fr 1.2fr;">
                        <!-- Column 1: Workforce Distribution (Slate tint) -->
                        <div style="background: #f8fafc; padding: 1.5rem; border-right: 1.5px solid var(--border-color);">
                            <h4 style="font-size: 0.85rem; font-weight: 800; color: var(--navy-deep); margin-bottom: 1.5rem; text-transform: uppercase; letter-spacing: 0.5px;">Workforce Distribution</h4>
                            
                            <div style="display: flex; flex-direction: column; gap: 0.85rem;">
                                <div class="form-group-inline">
                                    <label class="form-label">Line Staff</label>
                                    <input type="number" name="LineStaff" id="form-line-staff" value="@hotel.LineStaff" class="form-control staff-input" style="width: 100px; text-align: center; font-weight: 700; background: white;" />
                                </div>
                                <div class="form-group-inline">
                                    <label class="form-label">Management Staff</label>
                                    <input type="number" name="ManagementStaff" id="form-mgmt-staff" value="@hotel.ManagementStaff" class="form-control staff-input" style="width: 100px; text-align: center; font-weight: 700; background: white;" />
                                </div>
                                <div class="form-group-inline" style="margin-top: 0.5rem; padding-top: 1rem; border-top: 1px dashed var(--border-color);">
                                    <label class="form-label" style="color: var(--primary-color);">Total Staff</label>
                                    <input type="number" name="TotalStaff" id="form-total-staff" value="@hotel.TotalStaff" class="form-control" style="width: 100px; text-align: center; font-weight: 800; background: white; border-color: var(--primary-color); color: var(--primary-color);" readonly />
                                </div>
                            </div>
                        </div>

                        <!-- Column 2: International Languages (Indigo tint) -->
                        <div style="background: #eef2ff; padding: 1.5rem;">
                                <div class="form-group-inline" style="margin-bottom: 1rem;">
                                    <label class="form-label" style="font-weight: 800; color: #3730a3; text-transform: uppercase;">Front Desk Languages</label>
                                    <div style="flex: 1;">
                                        <select id="langSelect" multiple="multiple" class="form-control select2-multiple">
                                            @foreach (var lang in new[] { "English", "French", "Swahili", "Chinese (Mandarin)", "Spanish", "German", "Italian", "Portuguese" })
                                            {
                                                <option value="@lang">@lang</option>
                                            }
                                        </select>
                                    </div>
                                    <input type="hidden" name="InternationalLanguagesFrontDesk" id="form-languages-hidden" value="@hotel.InternationalLanguagesFrontDesk" />
                                </div>

                                <div style="margin-top: 1rem; padding: 0.5rem 0;">
                                    <label style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer; font-size: 0.85rem; font-weight: 600; color: #4338ca;">
                                        <input type="checkbox" id="lang-other-checkbox" style="width: 18px; height: 18px; accent-color: #4338ca;" />
                                        Other Languages
                                    </label>
                                </div>

                                <div id="other-languages-container" style="display: none; margin-top: 0.5rem; background: white; padding: 0.75rem; border-radius: 8px; border: 1px solid #c7d2fe;">
                                    <label class="form-label" style="font-size: 0.75rem; color: #4338ca;">Specify Other Languages</label>
                                    <input type="text" id="lang-other-input" class="form-control" placeholder="e.g. Arabic, Russian" style="height: 32px; font-size: 0.85rem;" />
                                </div>
                        </div>
                    </div>
                    <button type="button" class="btn-mobile-save mobile-only" onclick="saveRegistry(this, 'staffing')">
                        <i class="fas fa-cloud-arrow-up"></i> SAVE STAFFING & LANGS
                    </button>
                </div>
            </div>

            <!-- 12. Attachment Registry -->
            <div class="collapsible-card" id="section-attachments" style="margin-top: 2rem;">
                <div class="collapsible-header" onclick="toggleCollapsible(this)">
                    <h3><i class="fas fa-paperclip" style="color: var(--primary-color);"></i> <span class="section-num">13.</span> ATTACHMENT REGISTRY</h3>
                    <i class="fas fa-chevron-down chevron"></i>
                </div>
                <div class="collapsible-content" style="display: none;">
                    <div class="form-flex-col-2" style="min-height: 380px; border: 1.5px solid var(--border-color); border-radius: 1rem; overflow: hidden; grid-template-columns: 220px 1fr;">
                        <div style="background: var(--bg-muted); border-right: 1px solid var(--border-color); padding: 1rem 0;">
                            @foreach (var (cat, idx) in CNET_WebConstantes.AttachmentCategories.Select((c, i) => (c, i)))
                            {
                                <button type="button" class="attach-cat-btn @(idx == 0 ? "active" : "")" data-cat-index="@idx" onclick="switchAttachCategory(@idx)">
                                    <i class="fas fa-folder" style="margin-right: 0.5rem; opacity: 0.6;"></i>@cat
                                </button>
                            }
                        </div>
                        <div style="flex: 1; padding: 2rem;">
                            @foreach (var (cat, idx) in CNET_WebConstantes.AttachmentCategories.Select((c, i) => (c, i)))
                            {
                                <div id="attachPanel_@idx" class="attach-panel" style="display: @(idx == 0 ? "block" : "none");">
                                    <div class="attach-dropzone" id="dropzone_@idx" onclick="document.getElementById('fileInput_@idx').click()">
                                        <i class="fas fa-cloud-arrow-up" style="font-size: 2.5rem; color: var(--primary-color); margin-bottom: 1rem;"></i>
                                        <h5 style="font-weight: 700;">Upload @cat</h5>
                                        <p>Click or drag files here.</p>
                                    </div>
                                    <input type="file" id="fileInput_@idx" data-cat-index="@idx" style="display:none;" onchange="handleAttachFileSelect(this)" multiple />
                                    <div class="attach-file-list" id="fileList_@idx"></div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="registry-footer-actions" style="margin-top: 3rem; display: flex; gap: 1rem; justify-content: flex-end; padding-bottom: 3rem;">
                <button type="button" onclick="switchTab('overview')" class="btn-premium btn-secondary" style="width: auto; padding: 0.8rem 2.5rem;">Discard</button>
                <button type="button" onclick="saveRegistry(this, 'all')" class="btn-premium" style="width: auto; padding: 0.8rem 3rem;">Commit All Changes</button>
            </div>
                </div> <!-- End registry-sections-container -->
            </div> <!-- End registry-layout -->
        </form>
    </div>

    <!-- Asset Registration Modal -->
    <div id="assetModal" class="modal-overlay">
        <div class="glass-card modal-content-animate" style="width: 100%; max-width: 700px; padding: 1.5rem; border: none; box-shadow: var(--shadow-2xl);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                <div>
                    <h3 id="modalTitle" style="margin: 0; color: var(--navy-deep); font-weight: 800; font-size: 1.25rem;">Add Asset</h3>
                    <p id="modalSubtitle" style="margin: 0.25rem 0 0; color: var(--text-muted); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Infrastructure Category</p>
                </div>
                <button type="button" onclick="closeAssetModal()" style="background: var(--bg-muted); border: none; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--text-muted); cursor: pointer; transition: all 0.2s;">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            
            <input type="hidden" id="modalSectionId" />
            
            <div style="max-height: 60vh; overflow-y: auto; padding-right: 10px;">
                <!-- Universal Fields (Used for simple assets) -->
                <div id="simpleAssetFields" class="form-grid" style="grid-template-columns: 1fr; margin-bottom: 1.5rem;">
                    <div class="form-group">
                        <label class="form-label" id="assetTypeLabel">Asset Name/Type</label>
                        <input type="text" id="assetTypeName" class="form-control" placeholder="e.g. WiFi Router, HVAC Unit..." />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Total Quantity</label>
                        <input type="number" id="assetCount" class="form-control" value="1" min="1" />
                    </div>
                </div>

                <!-- 1. Accommodation Specific Fields -->
                <div id="accommodationFields" style="display: none; border-top: 1px solid var(--border-color); padding-top: 1.5rem; margin-top: 1rem;">
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">Room Type</label>
                            <select id="accRoomType" class="form-control">
                                <option>Single Room</option>
                                <option>Double Room</option>
                                <option>Twin Room</option>
                                <option>Deluxe Room</option>
                                <option>Suite</option>
                                <option>Family Room</option>
                                <option>Other</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Number of Rooms</label>
                            <input type="number" id="accNumRooms" value="1" min="1" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Bed Type</label>
                            <select id="accBedType" class="form-control">
                                <option>Single Bed</option>
                                <option>Double Bed</option>
                                <option>King Bed</option>
                                <option>Queen Bed</option>
                                <option>Twin Beds</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Max Occupancy</label>
                            <input type="number" id="accOccupancy" value="2" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Room Size (sqm)</label>
                            <input type="text" id="accSize" placeholder="25" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Price per Night (ETB)</label>
                            <input type="number" id="accPrice" placeholder="1500" class="form-control" />
                        </div>
                        <div class="form-group full-width">
                            <label class="form-label">Amenities (Comma separated)</label>
                            <input type="text" id="accAmenities" placeholder="WiFi, AC, TV, Mini-bar" class="form-control" />
                        </div>
                    </div>
                </div>

                <!-- 2. Venue Specific Fields -->
                <div id="venueFields" style="display: none; border-top: 1px solid var(--border-color); padding-top: 1.5rem; margin-top: 1rem;">
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">Venue Type</label>
                            <select id="venType" class="form-control">
                                <option>Conference Hall</option>
                                <option>Meeting Room</option>
                                <option>Ballroom</option>
                                <option>Outdoor Area</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Max Seating</label>
                            <input type="number" id="venSeating" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Standing Capacity</label>
                            <input type="number" id="venStanding" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Area (sqm)</label>
                            <input type="number" id="venArea" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Ceiling Height (m)</label>
                            <input type="number" id="venCeiling" class="form-control" />
                        </div>
                        <div class="form-group full-width">
                            <label class="form-label">Table Arrangements</label>
                            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                                @foreach (var t in new[] { "Theater", "Classroom", "U-Shape", "Banquet", "Boardroom" }) {
                                    <label style="font-size: 0.75rem;"><input type="checkbox" name="venTables" value="@t"> @t</label>
                                }
                            </div>
                        </div>
                        <div class="form-group full-width">
                            <label class="form-label">Facilities (AV, etc.)</label>
                            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                                @foreach (var f in new[] { "Projector", "Microphone", "WiFi", "Stage", "Lighting", "Parking", "Accessibility" }) {
                                    <label style="font-size: 0.75rem;"><input type="checkbox" name="venFacilities" value="@f"> @f</label>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Dining Specific Fields -->
                <div id="diningFields" style="display: none; border-top: 1px solid var(--border-color); padding-top: 1.5rem; margin-top: 1rem;">
                    <div class="form-grid">
                        <div class="form-group full-width">
                            <label class="form-label">Dining Type</label>
                            <select id="dinSpec" class="form-control" onchange="$('.catering-details').toggle($(this).val() !== 'Regular Restaurant')">
                                <option>Regular Restaurant</option>
                                <option>Catering Service</option>
                                <option>Both Catering and Restaurant</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Cuisine Type</label>
                            <input type="text" id="dinCuisine" placeholder="Ethiopian, Italian..." class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Seating Capacity</label>
                            <input type="number" id="dinCapacity" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Operating Hours</label>
                            <input type="text" id="dinHours" placeholder="e.g. 7 AM - 10 PM" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Dining Setting</label>
                            <select id="dinSetting" class="form-control"><option>Indoor</option><option>Outdoor</option><option>Both</option></select>
                        </div>
                        <div class="catering-details form-group full-width" style="display: none; background: var(--bg-muted); padding: 1rem; border-radius: 0.5rem; border-left: 4px solid var(--primary-color);">
                            <label class="form-label" style="color: var(--primary-color);">Catering Information</label>
                            <div class="form-grid">
                                <div class="form-group"><label class="form-label">Max Catering Cap.</label><input type="number" id="dinCatCap" class="form-control" /></div>
                                <div class="form-group"><label class="form-label">Service Types</label><input type="text" id="dinCatService" placeholder="Buffet, Set Menu..." class="form-control" /></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                <button type="button" onclick="closeAssetModal()" class="btn-premium btn-secondary" style="flex: 1;">Cancel</button>
                <button type="button" onclick="addAsset()" class="btn-premium" style="flex: 2;">Add to Registry</button>
            </div>
        </div>
    </div>
</div>


<!-- Specialty Restaurant Modal -->
<div id="restaurantModal" class="modal-overlay">
    <div class="modal-content-animate" style="max-width: 650px;">
        <div class="glass-card" style="padding: 2rem; position: relative; border-top: 4px solid var(--primary-color);">
            <button onclick="closeRestaurantModal()" style="position: absolute; top: 1rem; right: 1rem; background: transparent; border: none; font-size: 1.25rem; color: var(--text-muted); cursor: pointer;"><i class="fas fa-times"></i></button>
            <h2 style="margin-bottom: 0.5rem; color: var(--navy-deep);"><i class="fas fa-utensils"></i> Add Specialty Restaurant</h2>
            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 2rem;">Register details for your establishment's specialized dining facilities.</p>

            <div class="form-grid">
                <div class="form-group full-width">
                    <label class="form-label">Restaurant Type</label>
                    <select id="restType" class="form-control" onchange="autoFillCuisine(this.value)">

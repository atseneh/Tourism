                formData.append('PassportScanner', $('#form-pass-scanner').val());
                formData.append('CurrencyScanner', $('#form-curr-scanner').val());
            }

            // 10. Utilities
            if (mode === 'utilities_resilience' || mode === 'all') {
                formData.append('StandbyGeneratorCapacityKva', $('#form-gen-cap').val());
                formData.append('StandbyGeneratorCoverage', $('#form-gen-cov').val());
                formData.append('WaterTreatment', $('#form-water').val());
                formData.append('WasteSegregation', $('#form-waste-seg').val());
                formData.append('Recycling', $('#form-recycling').val());
                formData.append('HazardousWasteHandling', $('#form-haz-waste').val());
            }

            // 11. Sustainability
            if (mode === 'sustainability' || mode === 'all') {
                formData.append('SustainabilityFocalPoint', $('#form-sust-focal').val());
                formData.append('SustainabilityCertification', $('#form-sust-cert').val());
                formData.append('OtherEcoLabels', $('#form-eco-labels').val());
                formData.append('FoodWasteProgram', $('#form-waste-prog').val());
                formData.append('SustainabilityRefillWaterStations', $('#form-sust-refill').val());
                formData.append('TourismServiceCompetenceLicenseCertificate', $('#form-tour-competence').val());
                formData.append('FireSafetyCertificate', $('#form-fire-safety-cert').val());
                formData.append('EnvironmentalClearanceCertificate', $('#form-env-clearance').val());
                formData.append('FoodSafetyAndHygieneCertificate', $('#form-food-safety-hygiene').val());
                formData.append('IsoCertification', $('#form-iso-cert').val());
            }

            // 12. Staffing
            if (mode === 'staffing' || mode === 'all') {
                // Ensure total is updated before sending
                calculateStaffTotals();
                formData.append('TotalStaff', $('#form-total-staff').val());
                formData.append('LineStaff', $('#form-line-staff').val());
                formData.append('ManagementStaff', $('#form-mgmt-staff').val());
                formData.append('InternationalLanguagesFrontDesk', $('#form-languages-hidden').val());
            }

            const response = await fetch('/HotelOwner/CommitRegistry', {
                method: 'POST',
                body: formData
            });

            if (response.ok) {
                const result = await response.json();
                if (result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: 'Registry updated successfully.',
                        timer: 1500,
                        showConfirmButton: false
                    });

                    // Update Local State for immediate visibility
                    syncLocalStateOnSave(mode);
                    if (mode === 'meetings_events' || mode === 'all') {
                        renderMeetingRooms(); // Re-render editor table
                    }
                } else {
                    Swal.fire('Error', result.message || 'Failed to update registry.', 'error');
                }
            } else {
                Swal.fire('Error', 'Server communication error.', 'error');
            }
        } catch (error) {
            console.error('Save error:', error);
            Swal.fire('Error', 'An unexpected error occurred.', 'error');
        } finally {
            btn.innerHTML = btnText;
            btn.disabled = false;
        }
    }

    function syncLocalStateOnSave(mode) {
        const unitId = $('#editorConsigneeUnitId').val();
        const data = window.allBranchesData[unitId];
        if (!data) return;

        // 1. Update Global Data Object
        data.TradeName = $('#form-trade-name').val();
        data.RegistrationName = $('#form-registration-name').val();
        data.City = $('#form-address').val().split(',').pop().trim(); 
        data.TotalRooms = $('#form-total-rooms').val();
        data.TotalBeds = $('#form-total-beds').val();
        data.StarCategory = $('#form-star-cat').val();

        // Sync Identifications in global data
        const formFields = $('#registryForm').serializeArray();
        const updatedIds = [...(data.Identifications || [])];
        
        formFields.forEach(field => {
            const existing = updatedIds.find(id => id.Description === field.name);
            if (existing) {
                existing.IdNumber = field.value;
            } else if (field.value && field.name !== "__RequestVerificationToken" && !field.name.includes("Consignee")) {
                updatedIds.push({
                    Description: field.name,
                    IdNumber: field.value
                });
            }
        });
        
        // Explicitly sync MeetingRooms JSON string to Identifications for the dynamic summary
        if (mode === 'meetings_events' || mode === 'all') {
            const mrJson = JSON.stringify(meetingRoomList);
            const existing = updatedIds.find(id => id.Description === 'MeetingRooms');
            if (existing) existing.IdNumber = mrJson;
            else updatedIds.push({ Description: 'MeetingRooms', IdNumber: mrJson });
        }

        data.Identifications = updatedIds;

        // 2. Update Portfolio Card in Overview Tab
        const card = $(`#branch-card-${unitId}`);
        if (card.length) {
            card.find('.branch-card-name').text(data.TradeName + ' - ' + data.ConsigneeUnitDescription);
            card.find('.branch-card-city').html('<i class="fas fa-location-dot"></i> ' + data.City);
            // Optionally update TIN if it was in the form
        }

        // 3. Update the displayed summary panel if it matches
        if (_currentSummaryUnitId === unitId) {
            _currentIdentifications = updatedIds;
            $('#summaryTradeName').text(data.TradeName);
            $('#summaryRooms').text(data.TotalRooms + ' Units');

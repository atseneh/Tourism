            meetingRoomList.forEach(room => {
                let equipment = [];
                if (room.hasSoundSystem) equipment.push('<span class="badge" style="background:#e0f2fe; color:#0369a1;">Sound</span>');
                if (room.hasHVAC) equipment.push('<span class="badge" style="background:#f0fdf4; color:#15803d;">HVAC</span>');
                if (room.hasScreen) equipment.push('<span class="badge" style="background:#faf5ff; color:#7e22ce;">Screen</span>');
                if (room.hasInterpreter) equipment.push('<span class="badge" style="background:#fff7ed; color:#c2410c;">Interp</span>');

                container.append(`
                    <tr>
                        <td style="padding: 0.75rem;"><div style="font-weight: 700; color: var(--navy-deep);">${room.name}</div><div style="font-size:0.7rem; color:var(--text-muted); font-weight:700; text-transform:uppercase;">${room.setting || 'Indoor'}</div></td>
                        <td style="padding: 0.75rem;">${room.type ? `<span class="badge" style="background: var(--bg-muted); color: var(--navy-deep); font-weight: 700;">${room.type}</span>` : ''}</td>
                        <td style="padding: 0.75rem;">${room.width} x ${room.length} x ${room.ceilingHeight} m</td>
                        <td style="padding: 0.75rem;">${room.capacity} Pax</td>
                        <td style="padding: 0.75rem; display: flex; gap: 0.3rem; flex-wrap: wrap;">${equipment.join('')}</td>
                        <td style="padding: 0.75rem; text-align: center;">
                            <button type="button" class="btn-save-section" style="background: #fee2e2; color: #dc2626; border: none; padding: 0.4rem;" onclick="removeMeetingRoom(${room.id})">

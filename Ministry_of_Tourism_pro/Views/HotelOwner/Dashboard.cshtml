@model IEnumerable<Ministry_of_Tourism_pro.Application.DTOs.HotelDto>
@using Ministry_of_Tourism_pro.WebConstants
@{
    var hotel = Model.FirstOrDefault() ?? new Ministry_of_Tourism_pro.Application.DTOs.HotelDto();
    ViewData["Title"] = $"{hotel.Name} • Registry Profile";

    var categoryId = User.FindFirst("PreferenceParentId")?.Value;
    bool isHotel = categoryId == "14";
    bool isRestaurant = categoryId == "15";
    bool isMice = categoryId == "16";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-rc.0/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    /* AATC Inspiration Theme Overrides */
    :root, body, .theme-hotels, .theme-restaurants, .theme-mice {
        --primary-color: #10383A !important;
        --primary-dark: #0a2425 !important;
        --navy-deep: #10383A !important;
        --accent-color: #DAA112 !important;
        --accent-hover: #b9840c !important;
        --border-color: rgba(16, 56, 58, 0.08) !important;
        --bg-muted: rgba(16, 56, 58, 0.03) !important;
        --bg-light: #F4F5F6 !important;
    }

    body {
        background: radial-gradient(at 0% 0%, rgba(218, 161, 18, 0.04) 0px, transparent 50%), 
                    radial-gradient(at 100% 100%, rgba(16, 56, 58, 0.03) 0px, transparent 50%), 
                    #f4f5f6 !important;
    }

    ::selection {
        background-color: rgba(218, 161, 18, 0.25) !important;
        color: #10383A !important;
    }
    
    ::-moz-selection {
        background-color: rgba(218, 161, 18, 0.25) !important;
        color: #10383A !important;
    }

    /* Glassmorphism Cards Override */
    .glass-card, .card {
        background: rgba(255, 255, 255, 0.8) !important;
        backdrop-filter: blur(16px) !important;
        -webkit-backdrop-filter: blur(16px) !important;
        border: 1px solid rgba(16, 56, 58, 0.08) !important;
        border-radius: 16px !important;
        box-shadow: 0 10px 30px rgba(16, 56, 58, 0.02), 
                    inset 0 1px 0 rgba(255, 255, 255, 0.6) !important;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
    }
    
    .glass-card:hover, .card:hover {
        transform: translateY(-3px) !important;
        box-shadow: 0 20px 40px rgba(16, 56, 58, 0.06), 
                    inset 0 1px 0 rgba(255, 255, 255, 0.8) !important;
        border-color: rgba(218, 161, 18, 0.35) !important;
    }

    /* Branch Cards Override */
    .btn-branch-long {
        background: rgba(255, 255, 255, 0.85) !important;
        border: 1px solid rgba(16, 56, 58, 0.08) !important;
        border-radius: 16px !important;
        padding: 1.1rem 1.5rem !important;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
        box-shadow: 0 4px 15px rgba(16, 56, 58, 0.02) !important;
        border-left: 4px solid rgba(16, 56, 58, 0.2) !important;
    }
    
    .btn-branch-long:hover {
        border-color: var(--primary-color) !important;
        border-left-color: var(--accent-color) !important;
        background: white !important;
        transform: translateY(-3px) !important;
        box-shadow: 0 15px 30px rgba(16, 56, 58, 0.06) !important;
    }
    
    .btn-branch-long .branch-icon {
        width: 48px !important;
        height: 48px !important;
        background: rgba(218, 161, 18, 0.08) !important;
        border: 1px solid rgba(218, 161, 18, 0.15) !important;
        color: var(--accent-color) !important;
        font-size: 1rem !important;
        font-weight: 800 !important;
        border-radius: 50% !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        transition: all 0.3s ease !important;
    }
    
    .btn-branch-long:hover .branch-icon {
        background: var(--primary-color) !important;
        border-color: var(--primary-color) !important;
        color: white !important;
        transform: scale(1.05) rotate(5deg) !important;
    }

    /* Interactive Premium Buttons */
    .btn-action-small {
        padding: 0.55rem 1.1rem !important;
        border-radius: 8px !important;
        font-weight: 700 !important;
        letter-spacing: 0.3px !important;
        transition: all 0.2s ease !important;
    }
    
    .btn-action-small.see {
        background: rgba(16, 56, 58, 0.05) !important;
        color: var(--primary-color) !important;
        border: 1px solid rgba(16, 56, 58, 0.08) !important;
    }
    
    .btn-action-small.see:hover {
        background: rgba(16, 56, 58, 0.1) !important;
        transform: translateY(-1px) !important;
    }
    
    .btn-action-small.update {
        background: linear-gradient(135deg, var(--accent-color) 0%, #c4900f 100%) !important;
        color: white !important;
        box-shadow: 0 4px 10px rgba(218, 161, 18, 0.15) !important;
        border: none !important;
    }
    
    .btn-action-small.update:hover {
        box-shadow: 0 6px 14px rgba(218, 161, 18, 0.25) !important;
        transform: translateY(-1px) !important;
    }

    .btn-create-branch {
        border: 2px dashed rgba(218, 161, 18, 0.3) !important;
        background: rgba(255, 255, 255, 0.5) !important;
        color: var(--primary-color) !important;
        border-radius: 16px !important;
        padding: 1.25rem !important;
        transition: all 0.2s ease !important;
    }
    
    .btn-create-branch:hover {
        border-color: var(--primary-color) !important;
        background: rgba(218, 161, 18, 0.05) !important;
        color: var(--accent-color) !important;
        box-shadow: 0 8px 20px rgba(16, 56, 58, 0.04) !important;
    }

    /* Form Fields Styling */
    .form-control {
        border-radius: 8px !important;
        border: 1.5px solid rgba(16, 56, 58, 0.12) !important;
        padding: 0.45rem 0.85rem !important;
        background-color: rgba(255, 255, 255, 0.6) !important;
        transition: all 0.2s ease !important;
        font-size: 0.88rem !important;
    }
    
    .form-control:focus {
        background-color: white !important;
        border-color: var(--accent-color) !important;
        box-shadow: 0 0 0 3px rgba(218, 161, 18, 0.15) !important;
        outline: none !important;
    }

    /* Collapsible Form Cards Styling */
    .collapsible-card {
        background: rgba(255, 255, 255, 0.7) !important;
        backdrop-filter: blur(8px) !important;
        -webkit-backdrop-filter: blur(8px) !important;
        border-radius: 12px !important;
        border: 1px solid rgba(16, 56, 58, 0.06) !important;
        margin-bottom: 0.85rem !important;
        overflow: hidden !important;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
        box-shadow: 0 4px 12px rgba(16, 56, 58, 0.01) !important;
    }
    
    .collapsible-card.active {
        border-color: var(--primary-color) !important;
        box-shadow: 0 12px 25px rgba(16, 56, 58, 0.05) !important;
        background: rgba(255, 255, 255, 0.95) !important;
    }
    
    .collapsible-header {
        padding: 1.1rem 1.5rem !important;
        background: transparent !important;
        transition: background 0.2s ease !important;
    }
    
    .collapsible-header h3 {
        color: var(--navy-deep) !important;
        font-weight: 700 !important;
        letter-spacing: 0.3px !important;
    }
    
    .collapsible-header:hover {
        background: rgba(16, 56, 58, 0.02) !important;
    }
    
    .collapsible-card.active .collapsible-header {
        background: linear-gradient(90deg, rgba(16, 56, 58, 0.03) 0%, rgba(255, 255, 255, 0) 100%) !important;
        border-bottom: 1px solid rgba(16, 56, 58, 0.05) !important;
    }
    
    .collapsible-content {
        border-top: 1px solid rgba(16, 56, 58, 0.05) !important;
        padding: 1.25rem 1.5rem !important;
    }

    /* Tabs Styling */
    .dashboard-tabs {
        border-bottom: 2px solid rgba(16, 56, 58, 0.06) !important;
        padding-bottom: 0 !important;
        margin-bottom: 2rem !important;
        gap: 0.5rem !important;
    }
    
    .tab-link {
        border-radius: 8px 8px 0 0 !important;
        font-weight: 700 !important;
        font-size: 0.85rem !important;
        text-transform: uppercase !important;
        letter-spacing: 0.05em !important;
        padding: 0.85rem 1.5rem !important;
        color: var(--text-muted) !important;
        transition: all 0.2s ease !important;
        border: none !important;
    }
    
    .tab-link:hover {
        color: var(--primary-color) !important;
        background: rgba(16, 56, 58, 0.02) !important;
    }
    
    .tab-link.active {
        color: var(--primary-color) !important;
        background: white !important;
        border: 1px solid rgba(16, 56, 58, 0.08) !important;
        border-bottom-color: transparent !important;
        box-shadow: 0 -2px 10px rgba(16, 56, 58, 0.01) !important;
    }
    
    .tab-link.active::after {
        background: var(--accent-color) !important;
        height: 3px !important;
        bottom: -2px !important;
    }

    /* Premium Checkbox Styling */
    .premium-checkbox {
        border-radius: 8px !important;
        border: 1.5px solid rgba(16, 56, 58, 0.12) !important;
        padding: 0.45rem 0.75rem !important;
        background: white !important;
        transition: all 0.2s ease !important;
    }
    
    .premium-checkbox:hover {
        border-color: var(--accent-color) !important;
        box-shadow: 0 2px 8px rgba(218, 161, 18, 0.1) !important;
    }
    
    .checkbox-box {
        border-radius: 4px !important;
    }

    .profile-tab-animate {
        animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Left Sidebar Overrides */
    body .sidebar {
        background: linear-gradient(180deg, #10383A 0%, #0a2425 100%) !important;
        border-right: 1.5px solid rgba(218, 161, 18, 0.25) !important;
        color: rgba(255, 255, 255, 0.8) !important;
    }
    body .sidebar-header {
        border-bottom: 2px solid rgba(218, 161, 18, 0.15) !important;
        background: #10383A !important;
    }
    body .sidebar-header .brand-name {
        color: #ffffff !important;
        font-weight: 800 !important;
    }
    body .sidebar .nav-section-title {
        color: rgba(255, 255, 255, 0.4) !important;
        font-weight: 700 !important;
        font-size: 0.65rem !important;
        letter-spacing: 0.05em !important;
    }
    body .sidebar .nav-link {
        color: rgba(255, 255, 255, 0.7) !important;
        font-weight: 600 !important;
        transition: all 0.2s ease !important;
    }
    body .sidebar .nav-link i {
        color: rgba(255, 255, 255, 0.5) !important;
        transition: color 0.2s ease !important;
    }
    body .sidebar .nav-link.active {
        background: rgba(255, 255, 255, 0.08) !important;
        color: #DAA112 !important;
        box-shadow: inset 4px 0 0 #DAA112 !important;
        border-radius: 0 8px 8px 0 !important;
        font-weight: 700 !important;
    }
    body .sidebar .nav-link.active i {
        color: #DAA112 !important;
    }
    body .sidebar .nav-link:hover {
        background-color: rgba(255, 255, 255, 0.04) !important;
        color: #ffffff !important;
        transform: translateX(4px) !important;
    }
    body .sidebar .nav-link:hover i {
        color: #ffffff !important;
    }
    body .sidebar footer {
        border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
    }
    body .sidebar footer .text-muted {
        color: rgba(255, 255, 255, 0.4) !important;
    }
    body .sidebar #closeSidebar {
        color: rgba(255, 255, 255, 0.7) !important;
    }
    body .sidebar #closeSidebar:hover {
        color: #ffffff !important;
    }

    /* Form Subnav Overrides */
    .registry-subnav {
        border-left: 2px solid rgba(218, 161, 18, 0.3) !important;
        margin-left: 1.5rem !important;
        padding-left: 0.75rem !important;
    }
    .registry-nav-item {
        padding: 0.55rem 0.85rem !important;
        font-size: 0.78rem !important;
        font-weight: 600 !important;
        color: rgba(255, 255, 255, 0.65) !important;
        transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
        border-left: 3px solid transparent !important;
        border-radius: 0 8px 8px 0 !important;
    }
    .registry-nav-item:hover {
        background: rgba(255, 255, 255, 0.04) !important;
        color: #ffffff !important;
        border-left-color: rgba(255, 255, 255, 0.2) !important;
        padding-left: 1rem !important;
    }
    .registry-nav-item.active {
        background: rgba(255, 255, 255, 0.08) !important;
        color: #DAA112 !important;
        font-weight: 700 !important;
        border-left: 3px solid #DAA112 !important;
        padding-left: 1rem !important;
        box-shadow: 0 2px 8px rgba(16, 56, 58, 0.03) !important;
    }

    /* Details Drawer Overrides */
    .detail-backdrop {
        background: rgba(10, 36, 37, 0.3) !important;
        backdrop-filter: blur(8px) !important;
        -webkit-backdrop-filter: blur(8px) !important;
    }
    .detail-overlay {
        background: rgba(255, 255, 255, 0.95) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px) !important;
        border-left: 1.5px solid rgba(218, 161, 18, 0.15) !important;
        box-shadow: -15px 0 45px rgba(10, 36, 37, 0.08) !important;
        width: 450px !important;
        max-width: 100vw !important;
    }
    .detail-panel-header {
        background: rgba(255, 255, 255, 0.8) !important;
        backdrop-filter: blur(10px) !important;
        border-bottom: 1.5px solid rgba(16, 56, 58, 0.08) !important;
    }
    .detail-cat-card {
        border: 1px solid rgba(16, 56, 58, 0.08) !important;
        border-radius: 12px !important;
        margin-bottom: 0.85rem !important;
        background: rgba(255, 255, 255, 0.5) !important;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
        overflow: hidden !important;
    }
    .detail-cat-card.open {
        border-color: rgba(16, 56, 58, 0.15) !important;
        box-shadow: 0 8px 20px rgba(16, 56, 58, 0.03) !important;
        background: white !important;
    }
    .detail-cat-header {
        background: rgba(16, 56, 58, 0.02) !important;
        padding: 0.8rem 1.25rem !important;
        transition: all 0.2s ease !important;
        border-left: 3px solid transparent !important;
    }
    .detail-cat-header:hover {
        background: rgba(16, 56, 58, 0.04) !important;
    }
    .detail-cat-card.open .detail-cat-header {
        background: linear-gradient(90deg, rgba(16, 56, 58, 0.04) 0%, rgba(255, 255, 255, 0) 100%) !important;
        border-left-color: #DAA112 !important;
        border-bottom: 1px solid rgba(16, 56, 58, 0.05) !important;
    }
    .detail-chip {
        padding: 0.35rem 0.95rem !important;
        border-radius: 999px !important;
        font-size: 0.72rem !important;
        font-weight: 700 !important;
        border: 1.5px solid rgba(16, 56, 58, 0.1) !important;
        transition: all 0.2s ease !important;
        background: white !important;
        color: var(--text-muted) !important;
    }
    .detail-chip:hover {
        border-color: #DAA112 !important;
        color: #10383A !important;
        background: rgba(218, 161, 18, 0.05) !important;
    }
    .detail-chip.active {
        background: #10383A !important;
        color: white !important;
        border-color: #10383A !important;
        box-shadow: 0 4px 10px rgba(16, 56, 58, 0.15) !important;
    }

    /* AATC Top Nav Style Overrides (Desktop Only) */
    @@media (min-width: 426px) {
        .dashboard-header {
            position: sticky !important;
            top: 64px !important;
            z-index: 998 !important;
            background: rgba(255, 255, 255, 0.85) !important;
            backdrop-filter: blur(20px) !important;
            -webkit-backdrop-filter: blur(20px) !important;
            border-bottom: 2.5px solid #DAA112 !important;
            box-shadow: 0 8px 32px rgba(16, 56, 58, 0.04) !important;
            border-radius: 0 0 16px 16px !important;
            padding: 1rem 2rem !important;
            margin-bottom: 2rem !important;
        }
        
        .desktop-only.dashboard-tabs {
            display: flex !important;
            gap: 0.35rem !important;
            border-bottom: none !important;
            margin-bottom: 0 !important;
            padding: 4px !important;
            background: rgba(16, 56, 58, 0.04) !important;
            backdrop-filter: blur(8px) !important;
            -webkit-backdrop-filter: blur(8px) !important;
            border: 1px solid rgba(16, 56, 58, 0.06) !important;
            border-radius: 30px !important;
        }
        
        .desktop-only.dashboard-tabs .tab-link {
            background: transparent !important;
            border: none !important;
            color: #556677 !important;
            font-size: 0.8rem !important;
            font-weight: 800 !important;
            text-transform: uppercase !important;
            letter-spacing: 0.05em !important;
            padding: 0.5rem 1.25rem !important;
            position: relative !important;
            transition: all 0.25s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
            cursor: pointer !important;
            display: flex !important;
            align-items: center !important;
            border-radius: 20px !important;
        }
        
        .desktop-only.dashboard-tabs .tab-link:hover {
            color: var(--primary-color) !important;
            background: rgba(16, 56, 58, 0.05) !important;
        }
        
        .desktop-only.dashboard-tabs .tab-link.active {
            color: #ffffff !important;
            background: var(--primary-color) !important;
            box-shadow: 0 4px 12px rgba(16, 56, 58, 0.2) !important;
        }
        
        .desktop-only.dashboard-tabs .tab-link.active::after {
            display: none !important;
        }
    }

    @@keyframes pulse {
        0% { transform: scale(0.95); opacity: 0.5; }
        50% { transform: scale(1.05); opacity: 1; }
        100% { transform: scale(0.95); opacity: 0.5; }
    }

    /* Property Showcase Cards (Desktop Grid) */
    @@media (min-width: 426px) {
        .property-grid-desktop {
            display: grid !important;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)) !important;
            gap: 1.5rem !important;
        }

        .property-card-premium {
            background: rgba(255, 255, 255, 0.85) !important;
            backdrop-filter: blur(12px) !important;
            border: 1px solid rgba(16, 56, 58, 0.08) !important;
            border-radius: 20px !important;
            padding: 1.5rem !important;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
            position: relative !important;
            overflow: hidden !important;
            display: flex !important;
            flex-direction: column !important;
            justify-content: space-between !important;
            box-shadow: 0 4px 15px rgba(16, 56, 58, 0.02) !important;
            min-height: 200px !important;
            cursor: pointer !important;
        }

        .property-card-premium:hover {
            transform: translateY(-5px) !important;
            border-color: rgba(218, 161, 18, 0.35) !important;
            box-shadow: 0 20px 40px rgba(16, 56, 58, 0.06) !important;
            background: white !important;
        }

        .property-card-premium.active-card {
            border-color: var(--accent-color) !important;
            box-shadow: 0 10px 25px rgba(218, 161, 18, 0.15) !important;
            background: white !important;
        }

        .property-card-premium::before {
            content: '' !important;
            position: absolute !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            height: 4px !important;
            background: linear-gradient(90deg, var(--primary-color) 0%, var(--accent-color) 100%) !important;
            opacity: 0.8 !important;
        }

        .property-card-badge {
            position: absolute !important;
            top: 1.5rem !important;
            right: 1.5rem !important;
            width: 36px !important;
            height: 36px !important;
            background: rgba(218, 161, 18, 0.08) !important;
            border: 1.5px solid rgba(218, 161, 18, 0.15) !important;
            border-radius: 50% !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            font-size: 0.8rem !important;
            font-weight: 800 !important;
            color: var(--accent-color) !important;
            transition: all 0.3s ease !important;
        }

        .property-card-premium:hover .property-card-badge {
            background: var(--primary-color) !important;
            color: white !important;
            border-color: var(--primary-color) !important;
            transform: scale(1.1) rotate(360deg) !important;
        }

        .property-card-icon-area {
            width: 48px !important;
            height: 48px !important;
            background: rgba(16, 56, 58, 0.05) !important;
            border-radius: 12px !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            color: var(--primary-color) !important;
            font-size: 1.25rem !important;
            margin-bottom: 1rem !important;
        }
    }

    /* Optimization for laptops and smaller screens (up to 1400px) */
    @@media (min-width: 426px) and (max-width: 1400px) {
        body {
            zoom: 0.9;
        }
        .form-group-inline .form-label { flex: 0 0 220px; font-size: 0.8rem; }
        .registry-layout { grid-template-columns: 240px 1fr; gap: 1.5rem; }
        .collapsible-header h3 { font-size: 1rem; }
    }
    
    h3 {
        font-size: 0.95rem;
        font-weight: 600;
        margin: 0;
    }
    
    .collapsible-card {
        background: white;
        border-radius: 16px;
        border: 1px solid var(--border-color);
        margin-bottom: 0.85rem;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        box-shadow: 0 4px 20px rgba(16, 56, 58, 0.02);
    }
    
    .collapsible-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(16, 56, 58, 0.05);
        border-color: rgba(16, 56, 58, 0.15);
    }
    
    .collapsible-card.active {
        box-shadow: 0 12px 35px rgba(16, 56, 58, 0.08);
        border-color: var(--primary-color);
    }
    
    .collapsible-header {
        padding: 1.1rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        background: #ffffff;
        user-select: none;
        transition: all 0.2s ease;
        border-left: 0px solid var(--accent-color);
    }
    
    .collapsible-header:hover {
        background: rgba(16, 56, 58, 0.015);
    }
    
    .collapsible-card.active .collapsible-header {
        background: rgba(16, 56, 58, 0.02);
        border-left: 4px solid var(--accent-color);
        padding-left: calc(1.5rem - 4px);

        function initStructuredLists(hotel) {
            try {
                // Safely handle both PascalCase (Razor) and camelCase (Fetch)
                const specRest = hotel.specialtyRestaurants || hotel.SpecialtyRestaurants || "[]";
                const shops = hotel.souvenirShops || hotel.SouvenirShops || "[]";
                const rooms = hotel.meetingRooms || hotel.MeetingRooms || "[]";

                restaurantList = (typeof specRest === 'string') ? JSON.parse(specRest || "[]") : (specRest || []);
                shopList = (typeof shops === 'string') ? JSON.parse(shops || "[]") : (shops || []);
                meetingRoomList = (typeof rooms === 'string') ? JSON.parse(rooms || "[]") : (rooms || []);

                renderRestaurants();
                renderShops();
                renderMeetingRooms();
            } catch (e) { 
                console.error("Error parsing structured lists:", e); 
                // Initialize as empty on error to avoid undefined crashes
                restaurantList = []; shopList = []; meetingRoomList = [];
                renderRestaurants(); renderShops(); renderMeetingRooms();
            }
        }


    <script>
        // --- Navigation & Scroll Logic ---
        function scrollToSection(index) {
            const sections = $('.collapsible-card');
            if (index >= sections.length) return;
            
            const target = $(sections[index]);
            
            // Expand if collapsed
            if (!target.hasClass('active')) {
                toggleCollapsible(target.find('.collapsible-header')[0]);
            }
            
            // Scroll with offset for header/tabs
            const offset = target.offset().top - 150;
            $('html, body').animate({ scrollTop: offset }, 600);
            
            // Update sidebar active state
            updateSidebarNav(index);
        }

        function updateSidebarNav(index) {
            $('.registry-nav-item').removeClass('active');
            $('.registry-nav-item').eq(index).addClass('active');
        }

        // Scroll Spy Implementation
        $(window).scroll(function() {
            if ($('#editorTab').is(':visible')) {
                const scrollPos = $(document).scrollTop() + 200;
                $('.collapsible-card').each(function(i) {
                    const top = $(this).offset().top;
                    const bottom = top + $(this).outerHeight();
                    if (scrollPos >= top && scrollPos <= bottom) {
                        updateSidebarNav(i);
                    }
                });
            }
        });

        // --- Branch Summary Logic ---
        // Category label mapping
        const catMeta = {
            basic:             { label: 'Basic Info',           icon: 'fas fa-id-card' },
            accommodation:     { label: 'Accommodation',        icon: 'fas fa-bed' },
            food_beverage:     { label: 'Food & Beverage',      icon: 'fas fa-utensils' },
            meetings_events:   { label: 'Meetings & Events',    icon: 'fas fa-handshake' },
            public_facilities: { label: 'Public Facilities',    icon: 'fas fa-building' },
            accessibility:     { label: 'Accessibility',        icon: 'fas fa-wheelchair' },
            safety_security:   { label: 'Safety & Security',    icon: 'fas fa-shield-halved' },
            transport_parking: { label: 'Transport & Parking',  icon: 'fas fa-car' },
            ict_services:      { label: 'ICT & Guest Services', icon: 'fas fa-wifi' },
            utilities_resilience: { label: 'Utilities & Resilience', icon: 'fas fa-bolt' },
            sustainability:    { label: 'Sustainability',       icon: 'fas fa-leaf' },
            staffing:          { label: 'Staffing & Languages', icon: 'fas fa-users' }
        };

        // Map IdentificationDTO Description -> category key using CNET_WebConstantes category IDs
        const fieldCatMap = {
            RegistrationName:'basic', SubCity:'basic', SpecificAddress:'basic', DistanceFromAirport:'basic', StarCategory:'basic', TotalRooms:'basic', TotalBeds:'basic', ContactInformation:'basic', ReservationsContact:'basic', SustainabilityFocalPoint:'basic',
            KingSizeRooms:'accommodation', TwinBedRooms:'accommodation', JuniorSuites:'accommodation', Suites:'accommodation', PresidentialSuites:'accommodation', AccessibleRooms:'accommodation',
            AllDayDining:'food_beverage', AllDayDiningSeats:'food_beverage', SpecialtyRestaurants:'food_beverage', CoffeeShop:'food_beverage', BarsCount:'food_beverage', NightClub:'food_beverage', SouvenirShops:'food_beverage', DelegationCatering:'food_beverage', DelegationCateringMaxPax:'food_beverage', RefillWaterStations:'food_beverage', VegVeganOptions:'food_beverage', NoSingleUsePlastics:'food_beverage',
            MeetingRoomsCount:'meetings_events', LargestRoomCapacityTheatre:'meetings_events', LargestRoomCapacityClassroom:'meetings_events', LargestRoomCapacityBanquet:'meetings_events', TotalMeetingSpaceSqm:'meetings_events', MeetingRooms:'meetings_events',
            InternetBandwidthDown:'public_facilities', InternetBandwidthUp:'public_facilities', LobbyAreaSqm:'public_facilities', GreenAreaSqm:'public_facilities', PoolAvailable:'public_facilities', PoolType:'public_facilities', SpaAvailable:'public_facilities', SpaGender:'public_facilities', MassageService:'public_facilities', ChildrensPlayground:'public_facilities', ChildrenDayCare:'public_facilities', StaffCanteen:'public_facilities',
            WheelchairRamps:'accessibility', ElevatorsCount:'accessibility', ElevatorsWheelchairSized:'accessibility', PublicAccessibleBathroom:'accessibility',
            CCTVPublicAreas:'security_safety', FireExtinguishersLastInspection:'security_safety', HoseReels:'security_safety', SmokeDetectorsInRooms:'security_safety', SmokeDetectorsInPublicAreas:'security_safety', SprinklerCoverage:'security_safety', FireAlarmControlPanel:'security_safety', EmergencyExitsCount:'security_safety', BagScanner:'security_safety', WalkThroughScanner:'security_safety', HandScanner:'security_safety',
            ParkingSpacesCount:'transport_parking', BusParkingCount:'transport_parking', ValetParking:'transport_parking', ParkingWithin100m:'transport_parking', ShuttleToAirport:'transport_parking', PublicTransportWithin500m:'transport_parking', EvChargingPoints:'transport_parking', EvChargerTypes:'transport_parking',
            WifiPropertyWide:'ict_services', WifiAvgSpeed:'ict_services', InHouseLaundry:'ict_services', Reception24hr:'ict_services', VipCheckIn:'ict_services', PassportScanner:'ict_services', CurrencyScanner:'ict_services',
            StandbyGeneratorCapacityKva:'utilities_resilience', StandbyGeneratorCoverage:'utilities_resilience', WaterTreatment:'utilities_resilience', WasteSegregation:'utilities_resilience', Recycling:'utilities_resilience', HazardousWasteHandling:'utilities_resilience',
            SustainabilityCertification:'sustainability', OtherEcoLabels:'sustainability', FoodWasteProgram:'sustainability', SustainabilityRefillWaterStations:'sustainability',
            TourismServiceCompetenceLicenseCertificate:'sustainability', FireSafetyCertificate:'sustainability', EnvironmentalClearanceCertificate:'sustainability', FoodSafetyAndHygieneCertificate:'sustainability',
            TotalStaff:'staffing', InternationalLanguagesFrontDesk:'staffing'
        };

        let _currentIdentifications = [];
        let _currentSummaryUnitId = '';
        let _currentSummaryUnitCode = '';
        let _currentSummaryUnitTin = '';
        let _currentSummaryUnitDesc = '';

        function showBranchSummary(unitId) {
            const data = window.allBranchesData[unitId];
            if (!data) return;

            _currentIdentifications = data.Identifications || [];
            _currentSummaryUnitId = unitId;
            _currentSummaryUnitCode = data.Code;
            _currentSummaryUnitTin = data.TIN;
            _currentSummaryUnitDesc = data.ConsigneeUnitDescription;

            $('#summaryTradeName').text(data.TradeName);
            $('#summaryUnitDesc').text(data.ConsigneeUnitDescription);
            $('#summaryCode').text(data.Code || 'N/A');
            $('#summaryTin').text('TIN: ' + (data.TIN || 'N/A'));
            $('#summaryLocation').text(data.City || 'Addis Ababa');
            $('#summaryCategory').text(data.StarCategory || 'General Sector');
            $('#summaryRooms').text((data.TotalRooms || '0') + ' Units');
            $('#summaryBeds').text((data.TotalBeds || '0') + ' Units');
            
           
            // Reset filter chips and search
            $('#summarySearchInput').val('');
            $('.detail-chip').removeClass('active');
            $('.detail-chip[data-cat="all"]').addClass('active');

            renderDynamicSections('all', '');

            $('#detailBackdrop').fadeIn(300);
            $('#branchSummaryPanel').addClass('active');
            $('body').css('overflow', 'hidden');
        }

        function renderDynamicSections(activeCat) {
            const container = $('#summaryDynamicSections');
            container.empty();
            
            // 1. Gather existing data Map
            const dataMap = {};
            const hData = window.allBranchesData[_currentSummaryUnitId] || {};
            
            (_currentIdentifications || []).forEach(id => {
                dataMap[id.Description] = id.IdNumber;
            });

            // Ensure core fields are included if not present in identifications
            if (!dataMap['SubCity']) dataMap['SubCity'] = hData.SubCity || hData.Subcity || "";
            if (!dataMap['SpecificAddress']) dataMap['SpecificAddress'] = hData.SpecificAddress || "";
            if (!dataMap['RegistrationName']) dataMap['RegistrationName'] = hData.RegistrationName || "";

            // 2. Group all fields from fieldCatMap (the master list)
            const grouped = {};
            Object.keys(fieldCatMap).forEach(fieldName => {
                const catKey = fieldCatMap[fieldName];
                if (!grouped[catKey]) grouped[catKey] = [];
                
                let rawVal = dataMap[fieldName];
                let displayVal = '';
                
                if (rawVal === undefined || rawVal === null || rawVal === '') {
                    // Fallback logic for hidden/zero fields
                    if (fieldName.toLowerCase().includes('count') || fieldName.toLowerCase().includes('rooms') || fieldName.toLowerCase().includes('beds') || fieldName.toLowerCase().includes('capacity')) {
                        displayVal = '0';
                    } else {
                        displayVal = '<span style="color:#94a3b8; font-style:italic;">Not Specified</span>';
                    }
                } else if (rawVal === 'True') {
                    displayVal = '<span style="color:#059669;font-weight:800;"><i class="fas fa-check-circle"></i> Yes</span>';
                } else if (rawVal === 'False') {
                    displayVal = '<span style="color:#94a3b8;font-weight:700;"><i class="fas fa-minus-circle"></i> No</span>';
                } else if (typeof rawVal === 'string' && (rawVal.startsWith('[') || rawVal.startsWith('{'))) {
                    // Try to parse JSON for specialty lists
                    try {
                        const list = JSON.parse(rawVal);
                        if (Array.isArray(list) && list.length > 0) {
                            displayVal = `<ul style="margin: 0.25rem 0 0; padding-left: 1.1rem; list-style-type: disc;">` + 
                                list.map(item => `<li style="margin-bottom: 0.15rem; font-weight:700;">${item.name || item.type || 'Unnamed'}</li>`).join('') + 
                                `</ul>`;
                        } else {
                            displayVal = '0';
                        }
                    } catch(e) { displayVal = rawVal; }
                } else {
                    displayVal = rawVal;
                }

                const labelDisplay = fieldName.replace(/([A-Z])/g, ' $1').trim();
                
                grouped[catKey].push({
                    label: labelDisplay,
                    value: displayVal
                });
            });

            // 3. Render Categories following the display order in catMeta
            Object.keys(catMeta).forEach(catKey => {
                const items = grouped[catKey] || [];
                if (items.length === 0) return;

                // Category filter
                if (activeCat !== 'all' && catKey !== activeCat) return;

                const meta = catMeta[catKey];
                let rowsHtml = items.map(item => `
                    <div class="detail-row">
                        <span class="detail-label" style="font-size:0.8rem;">${item.label}</span>
                        <span class="detail-value" style="font-size:0.8rem;">${item.value}</span>
                    </div>`).join('');

                container.append(`
                    <div class="detail-cat-card open" data-category="${catKey}">
                        <div class="detail-cat-header" onclick="toggleDetailCat(this)">
                            <span class="detail-cat-title"><i class="${meta.icon}"></i> ${meta.label}</span>
                            <i class="fas fa-chevron-down detail-cat-chevron"></i>
                        </div>
                        <div class="detail-cat-body" style="display:block;">${rowsHtml}</div>
                    </div>
                `);
            });
            // Reset collapse/expand button state
            $('#toggleAllCardsText').text('Collapse All');
            $('#toggleAllCardsIcon').removeClass('fa-expand-alt').addClass('fa-compress-alt');

            if (container.children().length === 0) {
                container.html(`<div style="text-align:center; padding: 2rem; color: var(--text-muted); font-size:0.85rem;">No fields found</div>`);
            }
        }

        function filterByCategoryDropdown(val) {
            if (val === 'all') {
                renderDynamicSections('all');
            } else {
                // Re-render but only show selected category card
                renderDynamicSections('all');
                $('#summaryDynamicSections .detail-cat-card').each(function() {
                    if ($(this).data('category') !== val) {
                        $(this).hide();
                    } else {
                        $(this).show();
                        // Ensure it stays open
                        $(this).addClass('open');
                        $(this).find('.detail-cat-body').show();
                        $(this).find('.detail-cat-chevron').css('transform', 'rotate(180deg)');
                    }
                });
            }
        }



        function toggleDetailCat(header) {
            const card = $(header).closest('.detail-cat-card');
            const body = card.find('.detail-cat-body');
            const chevron = card.find('.detail-cat-chevron');
            if (card.hasClass('open')) {
                card.removeClass('open');
                body.slideUp(200);
                chevron.css('transform', 'rotate(0deg)').css('color', 'var(--text-muted)');
            } else {
                card.addClass('open');
                body.slideDown(200);
                chevron.css('transform', 'rotate(180deg)').css('color', 'var(--primary-color)');
            }
        }

        function toggleAllDetailCats() {
            const cards = $('#summaryDynamicSections .detail-cat-card:visible');
            const anyOpen = cards.filter('.open').length > 0;
            if (anyOpen) {
                // Collapse all
                cards.each(function() {
                    $(this).removeClass('open');
                    $(this).find('.detail-cat-body').slideUp(200);
                    $(this).find('.detail-cat-chevron').css('transform', 'rotate(0deg)').css('color', 'var(--text-muted)');
                });
                $('#toggleAllCardsText').text('Expand All');
                $('#toggleAllCardsIcon').removeClass('fa-compress-alt').addClass('fa-expand-alt');
            } else {
                // Expand all
                cards.each(function() {
                    $(this).addClass('open');
                    $(this).find('.detail-cat-body').slideDown(200);
                    $(this).find('.detail-cat-chevron').css('transform', 'rotate(180deg)').css('color', 'var(--primary-color)');
                });
                $('#toggleAllCardsText').text('Collapse All');
                $('#toggleAllCardsIcon').removeClass('fa-expand-alt').addClass('fa-compress-alt');
            }
        }


        function hideBranchSummary() {
            $('#detailBackdrop').fadeOut(300);
            $('#branchSummaryPanel').removeClass('active');
            $('body').css('overflow', '');
        }

        // Override original loadBranchRegistry to handle UI transitions and sidebar
        const originalLoadRegistry = loadBranchRegistry;
        loadBranchRegistry = async function(branchDescription, branchCode, tin, unitId) {
            hideBranchSummary();
            $('#sidebarBranchName').text(branchDescription);
            $('#registrySidebarContainer').show(); // Show sidebar in global nav
            await originalLoadRegistry(branchDescription, branchCode, tin, unitId);
            updateSidebarNav(0);
        };

        $(document).ready(function() {
            $('.tab-link').on('click', function() { switchTab($(this).data('tab')); });
            
            // If we want to hide the branch header when switching back manually
            $('.tab-link[data-tab="overview"]').on('click', function() {
                $('#branchEditorHeader').hide();
            });

            syncToggleGroups();
        });
    </script>

                <div class="form-group">
                    <label class="form-label">Cuisine Category</label>
                    <input type="text" id="restCuisine" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label">Options</label>
                    <div style="display: flex; gap: 1rem; margin-top: 0.5rem;">
                        <label style="font-size: 0.8rem; font-weight: 600; display: flex; align-items: center; gap: 0.4rem;">
                            <input type="checkbox" id="restHalal" /> Halal
                        </label>
                        <label style="font-size: 0.8rem; font-weight: 600; display: flex; align-items: center; gap: 0.4rem;">
                            <input type="checkbox" id="restVegan" /> Vegan
                        </label>
                    </div>
                </div>
                <div class="form-group full-width">
                    <label class="form-label">Notes</label>
                    <textarea id="restNotes" class="form-control" rows="2" placeholder="Any special features..."></textarea>
                </div>
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                <button type="button" onclick="closeRestaurantModal()" class="btn-premium btn-secondary" style="flex: 1;">Cancel</button>
                <button type="button" onclick="addRestaurant()" class="btn-premium" style="flex: 2;">Add Restaurant</button>
            </div>
        </div>
    </div>
</div>

<!-- Souvenir Shop Modal -->
<div id="shopModal" class="modal-overlay">
    <div class="modal-content-animate" style="max-width: 600px;">
        <div class="glass-card" style="padding: 2rem; position: relative; border-top: 4px solid var(--primary-color);">
            <button onclick="closeShopModal()" style="position: absolute; top: 1rem; right: 1rem; background: transparent; border: none; font-size: 1.25rem; color: var(--text-muted); cursor: pointer;"><i class="fas fa-times"></i></button>
            <h2 style="margin-bottom: 0.5rem; color: var(--navy-deep);"><i class="fas fa-shopping-bag"></i> Add  Shop</h2>
            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 2rem;">Add details for retail facilities within the property.</p>

            <div class="form-grid">
                <div class="form-group full-width">
                    <label class="form-label">Shop Type</label>
                    <select id="shopType" class="form-control">
                        <option>Handicrafts</option>
                        <option>Cultural Items</option>
                        <option>Local Products</option>
                        <option>Laundry</option>
                        <option>Luxury Gifts</option>
                        <option>Books & Stationery</option>
                        <option>Clothing & Textiles</option>
                        <option>Jewelry</option>
                        <option>Food & Snacks</option>
                        <option>Beauty Salon</option>
                        <option>Other</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Shop Name</label>
                    <input type="text" id="shopName" placeholder="e.g. Heritage Crafts" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label">Category</label>
                    <input type="text" id="shopCategory" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label">Operating Hours</label>
                    <input type="text" id="shopHours" placeholder="e.g. 9 AM - 8 PM" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label">Location (Optional)</label>
                    <input type="text" id="shopLocation" placeholder="e.g. Ground Floor" class="form-control" />
                </div>
                <div class="form-group full-width">
                    <label class="form-label">Notes</label>

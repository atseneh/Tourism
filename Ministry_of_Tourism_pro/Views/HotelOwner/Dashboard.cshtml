                                                    <td style="padding: 0.75rem;">@room.width x @room.length x @room.ceilingHeight m</td>
                                                    <td style="padding: 0.75rem;">@room.capacity Pax</td>
                                                    <td style="padding: 0.75rem; text-align: center;">
                                                        <button type="button" class="btn-remove-asset" onclick="removeMeetingRoom(@room.id)">
                                                            <i class="fas fa-trash-alt"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }

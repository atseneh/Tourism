                    displayVal = rawVal;
                }
 
                let labelDisplay = fieldName.replace(/([A-Z])/g, ' $1').trim();
                if (fieldName === 'SouvenirShops') labelDisplay = 'Shops';
                
                grouped[catKey].push({
                    label: labelDisplay,
                    value: displayVal
                });
            });

            Object.keys(catMeta).forEach(catKey => {
                const items = grouped[catKey] || [];
                if (items.length === 0) return;

                const meta = catMeta[catKey];
                let rowsHtml = items.map(item => `
                    <div class="sidebar-detail-row">
                        <span class="sidebar-detail-label">${item.label}</span>
                        <span class="sidebar-detail-value">${item.value}</span>
                    </div>`).join('');

                container.append(`
                    <div class="sidebar-cat-card" data-category="${catKey}">
                        <div class="sidebar-cat-header" onclick="toggleSidebarDetailCat(this)">
                            <span class="sidebar-cat-title"><i class="${meta.icon}"></i> ${meta.label}</span>
                            <i class="fas fa-chevron-down sidebar-cat-chevron"></i>
                        </div>
                        <div class="sidebar-cat-body">${rowsHtml}</div>
                    </div>
                `);
            });
        }

        function showBranchSummary(unitId) {
            if (unitId) unitId = (unitId + '').toLowerCase().trim();
            const data = window.allBranchesData[unitId];
            if (!data) return;

            _currentIdentifications = data.Identifications || [];
            _currentSummaryUnitId = unitId;
            _currentSummaryUnitCode = data.Code;
            _currentSummaryUnitTin = data.TIN;
            _currentSummaryUnitDesc = data.ConsigneeUnitDescription;

            $('#summaryTradeName').text(data.TradeName);
            $('#summaryUnitDesc').text(data.ConsigneeUnitDescription);
            $('#summaryCode').text(data.Code || 'N/A');
            $('#summaryTin').text('TIN: ' + (data.TIN || 'N/A'));
            $('#summaryLocation').text(data.City || 'Addis Ababa');
            $('#summaryCategory').text(data.StarCategory || 'General Sector');
            $('#summaryRooms').text((data.TotalRooms || '0') + ' Units');
            $('#summaryBeds').text((data.TotalBeds || '0') + ' Units');
            
            // Sync sidebar as well
            renderSidebarDynamicSections(unitId);
           
            // Reset filter chips and search
            $('#summarySearchInput').val('');
            $('.detail-chip').removeClass('active');
            $('.detail-chip[data-cat="all"]').addClass('active');

            renderDynamicSections('all', '');

            $('#detailBackdrop').fadeIn(300);
            $('#branchSummaryPanel').addClass('active');
            $('body').css('overflow', 'hidden');
        }

        function renderDynamicSections(activeCat) {
            const container = $('#summaryDynamicSections');
            container.empty();
            
            // 1. Gather existing data Map
            const dataMap = {};
            const hData = window.allBranchesData[_currentSummaryUnitId] || {};
            
            // Merge all fields from hData into dataMap (handles new infrastructure profile data)
            Object.keys(hData).forEach(key => {
                dataMap[key] = hData[key];
            });

            // Legacy support: merge from Identifications
            (_currentIdentifications || []).forEach(id => {
                dataMap[id.Description] = id.IdNumber;
            });

            const getValueCaseInsensitive = (obj, key) => {
                if (!obj) return undefined;
                const lowerKey = key.toLowerCase();
                const foundKey = Object.keys(obj).find(k => k.toLowerCase() === lowerKey);
                return foundKey ? obj[foundKey] : undefined;
            };

            // 2. Group all fields from fieldCatMap (the master list)
            const grouped = {};
            Object.keys(fieldCatMap).forEach(fieldName => {
                const catKey = fieldCatMap[fieldName];
                if (!grouped[catKey]) grouped[catKey] = [];
                
                let rawVal = getValueCaseInsensitive(dataMap, fieldName);
                let displayVal = '';
                
                if (rawVal === undefined || rawVal === null || rawVal === '') {
                    // Fallback logic for hidden/zero fields
                    if (fieldName.toLowerCase().includes('count') || fieldName.toLowerCase().includes('rooms') || fieldName.toLowerCase().includes('beds') || fieldName.toLowerCase().includes('capacity')) {
                        displayVal = '0';
                    } else {
                        displayVal = '<span style="color:#94a3b8; font-style:italic;">Not Specified</span>';
                    }
                } else if (rawVal === true || rawVal === 'True') {
                    displayVal = '<span style="color:#059669;font-weight:800;"><i class="fas fa-check-circle"></i> Yes</span>';
                } else if (rawVal === false || rawVal === 'False') {
                    displayVal = '<span style="color:#94a3b8;font-weight:700;"><i class="fas fa-minus-circle"></i> No</span>';
                } else if (fieldName.toLowerCase() === 'subcity') {
                    const subcities = {
                        "16": "Addis Ababa", "17": "Addis Ketema", "18": "Akaky Kaliti", "19": "Arada",
                        "20": "Bole", "21": "Gullele", "22": "Kirkos", "23": "Kolfe Keranio",
                        "24": "Lideta", "25": "Nifas Silk-Lafto", "26": "Yeka", "27": "Lemi kura"
                    };
                    displayVal = subcities[rawVal] || rawVal || '<span style="color:#94a3b8; font-style:italic;">Not Specified</span>';
                } else if (typeof rawVal === 'string' && (rawVal.startsWith('[') || rawVal.startsWith('{'))) {
                    // Try to parse JSON for specialty lists
                    try {
                        const list = JSON.parse(rawVal);
                        if (Array.isArray(list)) {
                            if (fieldName === 'MeetingRooms') {
                                displayVal = `<span style="color:var(--primary-color); font-weight:800;">${list.length} Halls</span>`;
                                if (list.length > 0) {
                                    displayVal += `<ul style="margin: 0.25rem 0 0; padding-left: 1.1rem; list-style-type: disc; font-size: 0.75rem;">` + 
                                        list.map(m => `<li>${m.name} (${m.capacity} Pax)</li>`).join('') + 
                                        `</ul>`;
                                }
                            } else if (fieldName === 'SpecialtyRestaurants' || fieldName === 'SouvenirShops') {
                                displayVal = `<span style="font-weight:800; color:var(--navy-deep);">${list.length} Units</span>`;
                                if (list.length > 0) {
                                    const categories = [...new Set(list.map(x => x.cuisine || x.type || x.category || 'General'))].filter(x => x);
                                    displayVal += `<div style="font-size:0.7rem; color:var(--text-muted); margin-top:0.2rem; font-weight:700;">Categories: ${categories.join(', ')}</div>`;
                                }
                            } else if (list.length > 0) {
                                displayVal = `<ul style="margin: 0.25rem 0 0; padding-left: 1.1rem; list-style-type: disc;">` + 
                                    list.map(item => `<li style="margin-bottom: 0.15rem; font-weight:700;">${item.name || item.type || 'Unnamed'}</li>`).join('') + 
                                    `</ul>`;
                            } else {
                                displayVal = '0';
                            }
                        } else {
                            displayVal = '0';
                        }
                    } catch(e) { displayVal = rawVal; }
                } else {
                    displayVal = rawVal;
                }

                let labelDisplay = fieldName.replace(/([A-Z])/g, ' $1').trim();
                if (fieldName === 'SouvenirShops') labelDisplay = 'Shops';
                
                grouped[catKey].push({
                    label: labelDisplay,
                    value: displayVal
                });
            });

            // 3. Render Categories following the display order in catMeta
            Object.keys(catMeta).forEach(catKey => {
                const items = grouped[catKey] || [];
                if (items.length === 0) return;

                // Category filter
                if (activeCat !== 'all' && catKey !== activeCat) return;

                const meta = catMeta[catKey];
                let rowsHtml = items.map(item => `
                    <div class="detail-row">
                        <span class="detail-label" style="font-size:0.8rem;">${item.label}</span>
                        <span class="detail-value" style="font-size:0.8rem;">${item.value}</span>
                    </div>`).join('');

                container.append(`
                    <div class="detail-cat-card open" data-category="${catKey}">
                        <div class="detail-cat-header" onclick="toggleDetailCat(this)">
                            <span class="detail-cat-title"><i class="${meta.icon}"></i> ${meta.label}</span>
                            <i class="fas fa-chevron-down detail-cat-chevron"></i>
                        </div>
                        <div class="detail-cat-body" style="display:block;">${rowsHtml}</div>
                    </div>
                `);
            });
            // Reset collapse/expand button state
            $('#toggleAllCardsText').text('Collapse All');
            $('#toggleAllCardsIcon').removeClass('fa-expand-alt').addClass('fa-compress-alt');

            if (container.children().length === 0) {
                container.html(`<div style="text-align:center; padding: 2rem; color: var(--text-muted); font-size:0.85rem;">No fields found</div>`);
            }
        }

        function filterByCategoryDropdown(val) {
            if (val === 'all') {
                renderDynamicSections('all');
            } else {
                // Re-render but only show selected category card
                renderDynamicSections('all');
                $('#summaryDynamicSections .detail-cat-card').each(function() {
                    if ($(this).data('category') !== val) {
                        $(this).hide();
                    } else {
                        $(this).show();
                        // Ensure it stays open
                        $(this).addClass('open');
                        $(this).find('.detail-cat-body').show();
                        $(this).find('.detail-cat-chevron').css('transform', 'rotate(180deg)');
                    }
                });
            }
        }



        function toggleDetailCat(header) {
            const card = $(header).closest('.detail-cat-card');
            const body = card.find('.detail-cat-body');
            const chevron = card.find('.detail-cat-chevron');
            if (card.hasClass('open')) {
                card.removeClass('open');
                body.slideUp(200);
                chevron.css('transform', 'rotate(0deg)').css('color', 'var(--text-muted)');
            } else {
                card.addClass('open');
                body.slideDown(200);
                chevron.css('transform', 'rotate(180deg)').css('color', 'var(--primary-color)');
            }
        }
        window.toggleDetailCat = toggleDetailCat;

        function toggleSidebarDetailCat(header) {
            const card = $(header).closest('.sidebar-cat-card');
            const body = card.find('.sidebar-cat-body');
            if (card.hasClass('open')) {
                card.removeClass('open');
                body.slideUp(200);
            } else {
                card.addClass('open');
                body.slideDown(200);
            }
        }
        window.toggleSidebarDetailCat = toggleSidebarDetailCat;

        function toggleAllDetailCats() {
            const cards = $('#summaryDynamicSections .detail-cat-card:visible');
            const anyOpen = cards.filter('.open').length > 0;
            if (anyOpen) {
                // Collapse all
                cards.each(function() {
                    $(this).removeClass('open');
                    $(this).find('.detail-cat-body').slideUp(200);
                    $(this).find('.detail-cat-chevron').css('transform', 'rotate(0deg)').css('color', 'var(--text-muted)');
                });
                $('#toggleAllCardsText').text('Expand All');
                $('#toggleAllCardsIcon').removeClass('fa-compress-alt').addClass('fa-expand-alt');
            } else {
                // Expand all
                cards.each(function() {
                    $(this).addClass('open');
                    $(this).find('.detail-cat-body').slideDown(200);
                    $(this).find('.detail-cat-chevron').css('transform', 'rotate(180deg)').css('color', 'var(--primary-color)');
                });
                $('#toggleAllCardsText').text('Collapse All');
                $('#toggleAllCardsIcon').removeClass('fa-expand-alt').addClass('fa-compress-alt');
            }
        }


        function hideBranchSummary() {
            $('#detailBackdrop').fadeOut(300);
            $('#branchSummaryPanel').removeClass('active');
            $('body').css('overflow', '');
        }

        $(document).ready(function() {
            $('.tab-link').on('click', function() { switchTab($(this).data('tab')); });
            
            $('.tab-link[data-tab="overview"]').on('click', function() {
                $('#branchEditorHeader').hide();
            });

            syncToggleGroups();

            // Click handler for branch card to show its details in the sidebar Details card
            $('.property-card-premium').on('click', function(e) {
                // Ignore if clicking on action buttons or inside the actions container
                if ($(e.target).closest('.desktop-card-actions, button').length) {
                    return;
                }
                const unitId = ($(this).data('unit-id') + '').toLowerCase().trim();
                if (unitId && window.allBranchesData[unitId]) {
                    $('.property-card-premium').removeClass('active-card');
                    $(this).addClass('active-card');
                    
                    const data = window.allBranchesData[unitId];
                    _currentSummaryUnitId = unitId;
                    _currentSummaryUnitCode = data.Code;
                    _currentSummaryUnitTin = data.TIN;
                    _currentSummaryUnitDesc = data.ConsigneeUnitDescription;
                    
                    renderSidebarDynamicSections(unitId);
                }
            });

            // Initialize sidebar branch details with the first branch
            const keys = Object.keys(window.allBranchesData || {});
            if (keys.length > 0) {
                const firstUnitId = keys[0].toLowerCase().trim();
                const data = window.allBranchesData[firstUnitId];
                _currentSummaryUnitId = firstUnitId;
                _currentSummaryUnitCode = data.Code;
                _currentSummaryUnitTin = data.TIN;
                _currentSummaryUnitDesc = data.ConsigneeUnitDescription;

                renderSidebarDynamicSections(firstUnitId);
                $(`#branch-card-${firstUnitId}`).addClass('active-card');
            } else {
                renderSidebarDynamicSections(null);
            }
        });
    </script>
}

</div>

<!-- Meeting Room Modal -->
<div id="meetingRoomModal" class="modal-overlay">
    <div class="modal-content-animate" style="max-width: 600px;">
        <div class="glass-card" style="padding: 1.5rem; position: relative; border-top: 4px solid var(--primary-color); max-height: 90vh; overflow-y: auto;">
            <button type="button" onclick="closeMeetingRoomModal()" style="position: absolute; top: 1rem; right: 1rem; background: transparent; border: none; font-size: 1.25rem; color: var(--text-muted); cursor: pointer;"><i class="fas fa-times"></i></button>
            <h2 style="margin-bottom: 0.5rem; color: var(--navy-deep);"><i class="fas fa-handshake"></i> Add Meeting Room / Event Hall</h2>
            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 2rem;">Register technical specifications for your event spaces.</p>

            <div class="form-grid" style="gap: 1rem;">
                <div class="form-group full-width">
                    <label class="form-label">Hall / Room Name</label>
                    <input type="text" id="meetHallName" placeholder="e.g. Grand Ballroom, Boardroom A" class="form-control" />
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;" class="full-width">
                    <div class="form-group">
                        <label class="form-label">Room Setting</label>
                        <select id="meetSetting" class="form-control">
                            <option value="Indoor">Indoor</option>
                            <option value="Open Air">Open Air</option>
                            <option value="Semi-Outdoor">Semi-Outdoor</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Type</label>
                        <select id="meetType" class="form-control">
                            <option value=""></option>
                            <option value="Theater">Theater</option>
                            <option value="Banquet">Banquet</option>
                            <option value="Classroom">Classroom</option>
                        </select>
                    </div>
                </div>
                
                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;" class="full-width">
                    <div class="form-group">
                        <label class="form-label">Width x Length (m)</label>
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <input type="number" id="meetWidth" placeholder="W" step="0.1" class="form-control room-dim-input" />
                            <span style="color: var(--text-muted);">×</span>
                            <input type="number" id="meetLength" placeholder="L" step="0.1" class="form-control room-dim-input" />

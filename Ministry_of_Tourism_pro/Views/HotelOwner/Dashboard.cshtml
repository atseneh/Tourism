        // ===== ATTACHMENT REGISTRY FUNCTIONS =====
        var _allAttachments = [];
        var _attachCategoryIds = [1444, 1440, 1448, 1440, 1440, 1451, 1451];

        function switchAttachCategory(idx) {
            $('.attach-panel').hide();
            $('#attachPanel_' + idx).show();
            $('.attach-cat-btn').removeClass('active');
            $(`.attach-cat-btn[data-cat-index="${idx}"]`).addClass('active');
        }

        // Initialize drag & drop on all dropzones
        $(document).ready(function() {
            document.querySelectorAll('.attach-dropzone').forEach(function(dz) {
                dz.addEventListener('dragover', function(e) { e.preventDefault(); dz.classList.add('dragover'); });
                dz.addEventListener('dragleave', function(e) { e.preventDefault(); dz.classList.remove('dragover'); });
                dz.addEventListener('drop', function(e) {
                    e.preventDefault();
                    dz.classList.remove('dragover');
                    var panelId = dz.closest('.attach-panel')?.id;
                    var catIdx = panelId ? parseInt(panelId.replace('attachPanel_', '')) : 0;
                    if (e.dataTransfer.files.length > 0) {
                        handleMultipleUploads(e.dataTransfer.files, catIdx);
                    }
                });
            });
        });

        function handleAttachFileSelect(input) {
            var catIdx = parseInt(input.getAttribute('data-cat-index'));
            if (input.files && input.files.length > 0) {
                handleMultipleUploads(input.files, catIdx);
            }
            input.value = ''; // reset so same file can be selected again
        }

        async function uploadAttachmentFile(file, categoryIndex) {
            await handleMultipleUploads([file], categoryIndex);
        }

        async function handleMultipleUploads(files, categoryIndex) {
            var consigneeId = $('#editorConsigneeId').val();
            if (!consigneeId) {
                Swal.fire('Error', 'Please select an establishment first.', 'warning');
                return;
            }

            var successCount = 0;
            var failCount = 0;
            var totalFiles = files.length;

            for (var i = 0; i < totalFiles; i++) {
                var file = files[i];
                var tempId = 'uploading_' + Date.now() + '_' + i + '_' + Math.floor(Math.random() * 1000);
                var listEl = document.getElementById('fileList_' + categoryIndex);
                var tempHtml = `<div id="${tempId}" class="attach-file-item" style="opacity:.6;"><div class="file-info"><span class="attach-upload-spinner"></span><span class="file-name">Uploading ${file.name}...</span></div></div>`;
                if (listEl) listEl.insertAdjacentHTML('afterbegin', tempHtml);

                try {
                    var formData = new FormData();
                    formData.append('file', file);
                    formData.append('consigneeId', consigneeId);
                    formData.append('categoryIndex', categoryIndex);

                    var resp = await fetch('/HotelOwner/UploadAttachment', { method: 'POST', body: formData });
                    var result = await resp.json();
                    var tempEl = document.getElementById(tempId);
                    if (tempEl) tempEl.remove();

                    if (result.success) {
                        successCount++;
                    } else {
                        failCount++;
                    }
                } catch (err) {
                    var tempEl = document.getElementById(tempId);
                    if (tempEl) tempEl.remove();
                    failCount++;
                }
            }

            await loadAttachments(consigneeId);

            if (successCount > 0 && failCount === 0) {
                Swal.fire({
                    icon: 'success',
                    title: 'Uploaded',
                    text: totalFiles === 1 ? 'Attachment saved successfully!' : `${successCount} attachments saved successfully!`,
                    timer: 1500,
                    showConfirmButton: false
                });
            } else if (failCount > 0) {
                Swal.fire('Notice', `${successCount} file(s) uploaded successfully, ${failCount} failed.`, failCount === totalFiles ? 'error' : 'warning');
            }
        }

        async function loadAttachments(consigneeId) {
            if (!consigneeId) return;
            try {
                var resp = await fetch('/HotelOwner/GetAttachments?consigneeId=' + consigneeId);
                var result = await resp.json();
                _allAttachments = (result.success && result.data) ? result.data : [];
                renderAllAttachments();
            } catch (err) {
                console.error('Failed to load attachments:', err);
                _allAttachments = [];
                renderAllAttachments();
            }
        }

        function renderAllAttachments() {
            // Clear all file lists
            for (var i = 0; i < _attachCategoryIds.length; i++) {
                var listEl = document.getElementById('fileList_' + i);
                if (listEl) listEl.innerHTML = '';
            }
            // Group by category and render
            _allAttachments.forEach(function(att) {
                // Find which panel index this category maps to
                var panelIdx = -1;
                if (att.categoryIndex !== undefined && att.categoryIndex !== null && att.categoryIndex >= 0 && att.categoryIndex < _attachCategoryIds.length) {
                    panelIdx = att.categoryIndex;
                } else {
                    panelIdx = _attachCategoryIds.indexOf(att.category);
                    if (panelIdx === -1) panelIdx = _attachCategoryIds.length - 1; // fallback to last (Other)
                }
                var listEl = document.getElementById('fileList_' + panelIdx);
                if (!listEl) return;

                var dateStr = att.createdOn ? new Date(att.createdOn).toLocaleDateString() : '';
                var escapedDesc = (att.description || 'Unnamed').replace(/'/g, "\\'");
                var html = `<div class="attach-file-item" data-att-id="${att.id}">`
                    + `<div class="file-info"><i class="fas fa-file-alt"></i><span class="file-name" title="${att.description || ''}">${att.description || 'Unnamed'}</span>`
                    + `<span class="file-date">${dateStr}</span></div>`
                    + `<div class="attach-file-actions">`
                    + `<button type="button" class="btn-pv" title="Preview" onclick="previewUploadedAttachment('${att.url}', '${escapedDesc}')"><i class="fas fa-eye"></i></button>`
                    + `<button type="button" class="btn-dl" title="Download" onclick="window.open('${att.url}','_blank')"><i class="fas fa-download"></i></button>`
                    + `<button type="button" class="btn-del" title="Delete" onclick="deleteUploadedAttachment(${att.id})"><i class="fas fa-trash-alt"></i></button>`
                    + `</div></div>`;
                listEl.insertAdjacentHTML('beforeend', html);
            });

            // Update folder counts on sidebar buttons
            for (var i = 0; i < _attachCategoryIds.length; i++) {
                var count = _allAttachments.filter(a => {
                    if (a.categoryIndex !== undefined && a.categoryIndex !== null && a.categoryIndex >= 0 && a.categoryIndex < _attachCategoryIds.length) {
                        return a.categoryIndex === i;
                    }
                    return _attachCategoryIds.indexOf(a.category) === i;
                }).length;
                var btn = document.querySelector(`.attach-cat-btn[data-cat-index="${i}"]`);
                if (btn) {
                    var badge = btn.querySelector('.cat-badge');
                    if (count > 0) {
                        if (!badge) {
                            badge = document.createElement('span');
                            badge.className = 'cat-badge';
                            badge.style.cssText = 'margin-left:auto;background:var(--primary-color);color:white;font-size:0.7rem;padding:0.1rem 0.45rem;border-radius:1rem;font-weight:700;';
                            btn.appendChild(badge);
                        }
                        badge.textContent = count;
                    } else if (badge) {
                        badge.remove();
                    }
                }
            }
        }

        function previewUploadedAttachment(url, desc) {
            $('#previewModalTitle').html(`<i class="fas fa-eye" style="color: var(--primary-color); margin-right: 0.5rem;"></i> Preview: ${desc}`);
            $('#previewModalDownloadBtn').attr('href', url);
            
            var bodyEl = $('#previewModalBody');
            bodyEl.empty();
            
            var lowerUrl = url.toLowerCase();
            if (lowerUrl.endsWith('.jpg') || lowerUrl.endsWith('.jpeg') || lowerUrl.endsWith('.png') || lowerUrl.endsWith('.gif') || lowerUrl.endsWith('.webp')) {
                bodyEl.html(`<img src="${url}" style="max-width: 100%; max-height: 500px; border-radius: 0.5rem; object-fit: contain;" alt="${desc}" />`);
            } else if (lowerUrl.endsWith('.pdf')) {
                bodyEl.html(`<iframe src="${url}" style="width: 100%; height: 500px; border: none; border-radius: 0.5rem;"></iframe>`);
            } else {
                bodyEl.html(`<div style="text-align: center; padding: 2.5rem; color: var(--text-muted);"><i class="fas fa-file-lines" style="font-size: 3rem; margin-bottom: 1rem; color: var(--primary-color);"></i><h5 style="font-weight:700;margin-bottom:0.25rem;">Preview not supported for this file type</h5><p style="font-size:0.85rem;">Please use the download button below to view the file.</p></div>`);
            }
            
            $('#attachmentPreviewModal').fadeIn(300).css('display', 'flex');
        }

        function closeAttachmentPreviewModal() {
            $('#attachmentPreviewModal').fadeOut(300);
            $('#previewModalBody').empty();
        }

        async function deleteUploadedAttachment(id) {
            var confirm = await Swal.fire({ title: 'Delete Attachment?', text: 'This action cannot be undone.', icon: 'warning', showCancelButton: true, confirmButtonColor: '#ef4444', confirmButtonText: 'Delete' });
            if (!confirm.isConfirmed) return;

            try {
                var resp = await fetch('/HotelOwner/DeleteAttachment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'id=' + id
                });
                var result = await resp.json();
                if (result.success) {
                    Swal.fire({ icon: 'success', title: 'Deleted', timer: 1200, showConfirmButton: false });
                    var consigneeId = $('#editorConsigneeId').val();
                    await loadAttachments(consigneeId);
                } else {
                    Swal.fire('Error', result.message || 'Delete failed.', 'error');
                }
            } catch (err) {
                Swal.fire('Error', 'Delete failed: ' + err.message, 'error');
            }
        }
        var map, marker;

        function initMap() {
            if (map) return; // Already initialized
            const mapContainer = document.getElementById('editor-map');
            if (!mapContainer) return;

            map = L.map('editor-map').setView([@(hotel.Latitude ?? 9.0192m), @(hotel.Longitude ?? 38.7525m)], 15);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);
            marker = L.marker([@(hotel.Latitude ?? 9.0192m), @(hotel.Longitude ?? 38.7525m)], { draggable: true }).addTo(map);

            marker.on('dragend', function() {
                var pos = marker.getLatLng();
                $('#lat-input').val(pos.lat.toFixed(6));
                $('#lng-input').val(pos.lng.toFixed(6));
            });

            map.on('click', function(e) {
                marker.setLatLng(e.latlng);
                $('#lat-input').val(e.latlng.lat.toFixed(6));
                $('#lng-input').val(e.latlng.lng.toFixed(6));
            });
        }

        function updateMap(lat, lng) {
            if (!map) initMap();
            const latlng = L.latLng(lat, lng);
            map.setView(latlng, 15);
            marker.setLatLng(latlng);
            $('#lat-input').val(lat.toFixed(6));
            $('#lng-input').val(lng.toFixed(6));
            setTimeout(() => map.invalidateSize(), 200);
        }

        function updateHiddenField(fieldName, list) {
            const json = JSON.stringify(list);
            // Case-insensitive match for the field
            $(`input[name="${fieldName}"]`).val(json);
            
            // Special handling for total counts if needed
            if (fieldName === 'MeetingRooms') {
                $('#form-meeting-rooms').val(list.length);
                const totalArea = list.reduce((sum, room) => sum + (parseFloat(room.areaSize) || 0), 0);
                $('#form-total-meeting-sqm').val(totalArea.toFixed(2));
                $('#form-meeting-rooms-json').val(json); // Explicitly update hidden field
            } else if (fieldName === 'SpecialtyRestaurants') {
                $('#form-spec-rest').val(json);
            } else if (fieldName === 'SouvenirShops') {
                $('#form-shops-count').val(json);
            }
        }


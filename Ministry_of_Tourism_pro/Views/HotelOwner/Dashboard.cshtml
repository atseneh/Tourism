        function syncLanguagesFromValue(val) {
            $('.lang-checkbox').prop('checked', false);
            if (!val) return;
            const selected = val.split(',').map(s => s.trim());
            $('.lang-checkbox').each(function() {
                if (selected.includes(this.value)) {
                    $(this).prop('checked', true);
                }
            });
        }

        function initStructuredLists(hotel) {
            try {
                restaurantList = JSON.parse(hotel.specialtyRestaurants || '[]');
                renderRestaurants();
            } catch(e) { 
                restaurantList = []; 
                if(hotel.specialtyRestaurants) {
                    // Legacy support: convert string to single item
                    restaurantList.push({ id: Date.now(), type: 'Other', name: hotel.specialtyRestaurants, cuisine: 'General' });
                    renderRestaurants();
                }
            }

            try {
                shopList = JSON.parse(hotel.souvenirShops || '[]');
                renderShops();
            } catch(e) { 
                shopList = []; 
                if(hotel.souvenirShops && !isNaN(hotel.souvenirShops)) {
                    // Legacy support: convert count to placeholder items
                    const count = parseInt(hotel.souvenirShops);
                    for(let i=0; i<count; i++) {
                        shopList.push({ id: Date.now() + i, type: 'Other', name: 'Existing Shop ' + (i+1) });
                    }
                    renderShops();
                }
            }

            try {
                meetingRoomList = JSON.parse(hotel.meetingRooms || '[]');
                renderMeetingRooms();
                $('#form-meeting-rooms').val(meetingRoomList.length);
            } catch(e) {
                meetingRoomList = [];
                if(hotel.meetingRoomsCount > 0) {
                    // Legacy: if we have a count but no list, maybe add one generic entry or just leave as is
                    // meetingRoomList.push({ id: Date.now(), name: 'Main Meeting Hall', capacity: hotel.largestRoomCapacityTheatre || 0 });
                }
                renderMeetingRooms();
            }
        }

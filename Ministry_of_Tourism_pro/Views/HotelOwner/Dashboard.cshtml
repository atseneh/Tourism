@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
      function switchTab(tabName) {
        $('.tab-link').removeClass('active');
        $(`.tab-link[data-tab="${tabName}"]`).addClass('active');
        $('.tab-content').hide();
        $(`#${tabName}Tab`).show();
        
        if (tabName === 'overview') {
            $('#dynamicSubTitle').text('Manage your property branches and registry information');
            $('#branchEditorHeader').hide();
            $('#registrySidebarContainer').hide();
        }
        
        if (tabName === 'editor') {
            initMap();
            setTimeout(() => { if (map) map.invalidateSize(); }, 200);
        }
    }

    function calculateAccommodationTotals() {
        let totals = { rooms: 0, beds: 0 };
        $('.room-count-input').each(function() {
            const val = parseInt($(this).val()) || 0;
            totals.rooms += val;
            
            // Bed logic: Twin = val * 2, Others = val * 1 for this calculation
            // Unless the user specifies beds per room elsewhere.
            const id = $(this).attr('id');
            if (id.includes('twin')) {
                totals.beds += (val * 2);
            } else if (id.includes('suite') || id.includes('pres')) {
                totals.beds += (val * 2); // Suites usually have at least 2 beds
            } else {
                totals.beds += val;
            }
        });
        $('#form-total-rooms').val(totals.rooms);
        $('#form-total-beds').val(totals.beds);
    }

    $(document).on('input', '.room-count-input', calculateAccommodationTotals);

    // Global Branch Data Store for real-time UI synchronization
    window.allBranchesData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ToDictionary(b => b.ConsigneeUnitId.ToString(), b => new {
        b.TradeName,
        b.ConsigneeUnitDescription,
        b.Code,
        b.TIN,
        b.ConsigneeUnitId,
        b.City,
        b.StarCategory,
        b.TotalRooms,
        b.TotalBeds,
        Identifications = b.RawIdentifications.Select(id => new { id.Description, id.IdNumber })
    })));

    // Checkbox Sync Logic
    $(document).on('change', '.sync-checkbox', function() {
        const isChecked = $(this).is(':checked');
        const targetId = $(this).data('target');
        const callback = $(this).data('toggle-callback');

        // Update hidden input
        $('#' + targetId).val(isChecked ? "true" : "false");

        // Special callbacks
        if (callback && typeof window[callback] === 'function') {
            window[callback](isChecked);
        }
    });

    // Toggle Group Logic
    $(document).on('click', '.toggle-item', function() {
        const value = $(this).data('value');
        const $group = $(this).closest('.toggle-group');
        const targetId = $group.data('target');
        const callback = $group.data('toggle-callback');

        // Update visual state
        $group.find('.toggle-item').removeClass('active');
        $(this).addClass('active');

        // Update hidden input
        $('#' + targetId).val(value);

        // Special callbacks
        if (callback && typeof window[callback] === 'function') {
            window[callback](value);
        }
    });

    function togglePoolType(val) {
        const isTrue = (val === true || val === "true");
        $('#poolTypeGroup').toggle(isTrue);
    }

    function toggleSpaGender(val) {
        const isTrue = (val === true || val === "true");
        $('#spaGenderGroup').toggle(isTrue);
    }

    function syncToggleGroups() {
        // Sync checkboxes
        $('.sync-checkbox').each(function() {
            const $chk = $(this);
            const targetId = $chk.data('target');
            const value = $('#' + targetId).val();
            const isChecked = (value === 'true' || value === true);
            
            $chk.prop('checked', isChecked);
            
            // Trigger callbacks
            const callback = $chk.data('toggle-callback');
            if (callback && typeof window[callback] === 'function') {
                window[callback](isChecked);
            }
        });

        // Sync old-style toggle groups
        $('.toggle-group').each(function() {
            const $group = $(this);
            const targetId = $group.data('target');
            const value = $('#' + targetId).val();
            
            $group.find('.toggle-item').removeClass('active');
            $group.find(`.toggle-item[data-value="${value}"]`).addClass('active');
            
            const callback = $group.data('toggle-callback');
            if (callback && typeof window[callback] === 'function') {
                window[callback](value);
            }
        });
    }


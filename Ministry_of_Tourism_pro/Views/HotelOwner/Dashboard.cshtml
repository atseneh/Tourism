        function renderRestaurants() {
            const tbody = $('#restaurant-tbody');
            tbody.empty();
            let html = '';
            
            if (restaurantList.length === 0) {
                tbody.append('<tr><td colspan="4" class="text-center text-muted py-3">No restaurants added yet.</td></tr>');
                return;
            }

            restaurantList.forEach(r => {
                const options = [];
                if (r.halal) options.push('Halal');
                if (r.vegan) options.push('Vegan');
                const optionsText = options.length > 0 ? `<br><small class="text-success">${options.join(', ')}</small>` : '';

                html += `
                <tr>
                    <td style="padding: 0.75rem;"><div style="font-weight: 700; color: var(--primary-color);">${r.name}</div></td>

                <div id="sidebarBranchName" style="font-weight: 800; color: var(--navy-deep); font-size: 0.75rem; text-transform: uppercase;">...</div>
            </div>
            <div class="registry-nav-item active" onclick="scrollToSection(0)">
                <i class="fas fa-id-card"></i> Basic Info
            </div>
            @if (isHotel) {
                <div class="registry-nav-item" id="nav-accommodation" onclick="scrollToSection(1)">
                    <i class="fas fa-bed"></i> Accommodation
                </div>
            }
            <div class="registry-nav-item" onclick="scrollToSection(2)">
                <i class="fas fa-utensils"></i> Food & Beverage
            </div>
            @if (!isRestaurant) {
                <div class="registry-nav-item" onclick="scrollToSection(3)">
                    <i class="fas fa-handshake"></i> Meetings & Events
                </div>
                <div class="registry-nav-item" onclick="scrollToSection(4)">
                    <i class="fas fa-building"></i> Facilities
                </div>
            }
            <div class="registry-nav-item" onclick="scrollToSection(5)">
                <i class="fas fa-wheelchair"></i> Accessibility
            </div>
            <div class="registry-nav-item" onclick="scrollToSection(6)">
                <i class="fas fa-shield-halved"></i> Safety & Security
            </div>
            <div class="registry-nav-item" onclick="scrollToSection(7)">
                <i class="fas fa-car"></i> Transport & Parking
            </div>
            <div class="registry-nav-item" onclick="scrollToSection(8)">
                <i class="fas fa-wifi"></i> ICT & Guest Services
            </div>
            <div class="registry-nav-item" onclick="scrollToSection(9)">
                <i class="fas fa-bolt"></i> Utilities & Resilience
            </div>
            <div class="registry-nav-item" onclick="scrollToSection(10)">
                <i class="fas fa-leaf"></i> Sustainability
            </div>
            <div class="registry-nav-item" onclick="scrollToSection(11)">
                <i class="fas fa-users"></i> Staffing & Languages
            </div>
            <div class="registry-nav-item" onclick="scrollToSection(12)">
                <i class="fas fa-paperclip"></i> Attachments
            </div>
            <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--border-color);">
                <button type="button" class="btn btn-primary w-100" style="padding: 0.4rem; border-radius: 0.5rem; font-size: 0.72rem; font-weight: 800;" onclick="saveRegistry(this, 'all')">
                    <i class="fas fa-save"></i> Commit All
                </button>
            </div>
        </div>
    </div>
}

<div class="animate-fade-in">

    <!-- Compact Header Section -->
    <div class="dashboard-header hide-on-form" style="background: #f1f5f9; margin: -1.5rem -1.5rem 1.25rem -1.5rem; padding: 0.75rem 1.5rem; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; position: relative; z-index: 1;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div class="desktop-only" style="width: 32px; height: 32px; background: white; border-radius: 8px; display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-sm); border: 1px solid var(--border-color); padding: 4px;">
                <img src="~/logo/logo.svg" alt="Logo" style="width: 100%; height: 100%; object-fit: contain;" />
            </div>
            <div>
                <h1 style="color: var(--navy-deep); font-weight: 600; margin: 0; font-size: 1.15rem; letter-spacing: -0.3px;">@hotel.Name</h1>
                <p id="dynamicSubTitle" class="desktop-only" style="color: var(--text-muted); margin: 0; font-size: 0.75rem; font-weight: 500;">Registry Dashboard</p>
            </div>
        </div>
        
        <!-- Desktop Navigation Tabs -->
        <div class="desktop-only dashboard-tabs" style="border: none; padding: 0; gap: 0; display: flex; align-items: center;">
            <button class="tab-link active" data-tab="overview"><i class="fa-solid fa-chart-line" style="margin-right: 6px; font-size: 0.9rem;"></i> Overview</button>
            <button class="tab-link" data-tab="editor"><i class="fa-solid fa-file-signature" style="margin-right: 6px; font-size: 0.9rem;"></i> Form</button>
        </div>
    </div>

    <!-- Mobile Navigation Tabs (Persistent) -->
    <div class="mobile-only dashboard-tabs">
        <button class="tab-link active" data-tab="overview">Overview</button>
        <button class="tab-link" data-tab="editor">Form</button>
    </div>

    <!-- Tab Contents -->
    <div id="overviewTab" class="tab-content profile-tab-animate">
        <!-- Desktop Only Welcome Hero Banner -->
        <div class="desktop-only glass-card welcome-hero-banner" style="background: linear-gradient(135deg, rgba(16, 56, 58, 0.95) 0%, rgba(16, 56, 58, 0.8) 45%, rgba(255, 255, 255, 0.2) 100%) !important; color: white !important; border: 1px solid rgba(255, 255, 255, 0.2) !important; padding: 2rem !important; border-radius: 20px !important; margin-bottom: 2rem !important; position: relative; overflow: hidden; box-shadow: 0 10px 30px rgba(16, 56, 58, 0.1) !important; backdrop-filter: blur(20px) !important; -webkit-backdrop-filter: blur(20px) !important;">
            <!-- SVG Traditional Watermark Pattern -->
            <div style="position: absolute; top: 0; right: 0; bottom: 0; left: 0; opacity: 0.04; pointer-events: none; background-image: radial-gradient(#DAA112 1px, transparent 1px); background-size: 16px 16px;"></div>
            
            <div style="position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: center; gap: 2rem;">
                <div>
                    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
                        <span style="background: rgba(218, 161, 18, 0.15); border: 1px solid rgba(218, 161, 18, 0.3); color: #DAA112; font-size: 0.72rem; font-weight: 800; text-transform: uppercase; padding: 0.35rem 0.85rem; border-radius: 999px; display: flex; align-items: center; gap: 0.4rem; letter-spacing: 0.5px;">
                            <i class="fas fa-certificate"></i> Official AATC Registerd 
                        </span>
                        <span style="background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.15); color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.35rem 0.85rem; border-radius: 999px;">
                            ID: #@hotel.Id
                        </span>
                    </div>
                    <h2 style="font-size: 1.75rem; font-weight: 800; color: white; margin: 0 0 0.5rem 0; letter-spacing: -0.5px;">Welcome Back, @hotel.Name</h2>
                    <p style="color: rgba(255, 255, 255, 0.8); margin: 0; font-size: 0.9rem; font-weight: 500; max-width: 600px;">
                        Manage your properties, submit licensing declarations, and update accommodation capacities directly through the Addis Ababa Tourism & MICE Commission digital portal.
                    </p>
                </div>
                
                <div style="flex-shrink: 0; background: rgba(16, 56, 58, 0.9) !important; border: 1px solid rgba(255, 255, 255, 0.15) !important; border-radius: 16px; padding: 1.25rem 1.75rem; text-align: center; backdrop-filter: blur(10px) !important; box-shadow: 0 8px 24px rgba(16, 56, 58, 0.15) !important;">
                    <div style="font-size: 0.75rem; text-transform: uppercase; color: rgba(255, 255, 255, 0.6); font-weight: 700; letter-spacing: 1px; margin-bottom: 0.25rem;">Status</div>
                    <div style="font-size: 1.25rem; font-weight: 800; color: #10b981; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                        <span style="width: 8px; height: 8px; background: #10b981; border-radius: 50%; display: inline-block; box-shadow: 0 0 8px #10b981; animation: pulse 2s infinite;"></span>
                        Verified 
                    </div>
                </div>
            </div>
        </div>

        <div class="overview-grid" style="gap: 2.5rem;">
            <div>
                <!-- Branch Registry Section -->
                <div class="glass-card" style="padding: 1.25rem !important; margin-bottom: 1.25rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                        <h3 style="color: var(--navy-deep); font-weight: 800; margin: 0;">Portfolio</h3>
                      
                    </div>
                    
                    <div class="property-grid-desktop" style="display: grid; gap: 1.25rem;">
                        @foreach (var (b, index) in Model.Select((value, i) => (value, i)))
                        {
                            <!-- Desktop View -->
                            <div class="desktop-only property-card-premium" 
                                 id="branch-card-@b.ConsigneeUnitId.ToString().ToLower()"
                                 data-unit-id="@b.ConsigneeUnitId.ToString().ToLower()">
                                <div class="property-card-badge">@((index + 1).ToString("D2"))</div>
                                <div style="display: flex; flex-direction: column; gap: 0.5rem; flex: 1;">
                                    <!-- Icon and Name on Same Row -->
                                    <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem;">
                                        <div class="property-card-icon-area" style="margin-bottom: 0 !important; flex-shrink: 0;">
                                            <i class="fas fa-hotel"></i>
                                        </div>
                                        <div>
                                            <div class="branch-card-name" style="font-weight: 800; color: var(--navy-deep); font-size: 1.15rem; line-height: 1.3;">@b.TradeName</div>
                                            <div style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">@b.ConsigneeUnitDescription</div>
                                        </div>
                                    </div>
                                    
                                    <!-- Info tags inline on Same Row -->
                                    <div style="display: flex; flex-wrap: wrap; gap: 1rem; font-size: 0.78rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; border-top: 1px dashed rgba(16, 56, 58, 0.08); padding-top: 0.75rem; margin-top: auto;">
                                        <div style="display: flex; align-items: center; gap: 0.35rem;"><i class="fas fa-fingerprint" style="color: var(--accent-color);"></i> <span>RID: #@b.Id.ToString("D5")</span></div>
                                        @if (!string.IsNullOrEmpty(b.TIN)) {
                                            <div style="display: flex; align-items: center; gap: 0.35rem;"><i class="fas fa-file-invoice" style="color: var(--accent-color);"></i> <span>TIN: @b.TIN</span></div>
                                        }
                                        <div style="display: flex; align-items: center; gap: 0.35rem;"><i class="fas fa-map-location-dot" style="color: var(--accent-color);"></i> <span>@b.City</span></div>
                                    </div>
                                </div>
                                <div style="display: flex; align-items: center; gap: 0.75rem; margin-top: 1.25rem; border-top: 1px solid rgba(16, 56, 58, 0.08); padding-top: 1rem;">
                                    <button type="button" class="btn-action-small see" style="flex: 1; justify-content: center;" onclick='showBranchSummary("@b.ConsigneeUnitId.ToString().ToLower()")'>
                                        <i class="fas fa-eye"></i> See Summary
                                    </button>
                                    <button type="button" class="btn-action-small update" style="flex: 1; justify-content: center;" onclick='loadBranchRegistry("@b.ConsigneeUnitDescription", "@b.Code", "@b.TIN", "@b.ConsigneeUnitId.ToString().ToLower()")'>
                                        <i class="fas fa-edit"></i> Update
                                    </button>
                                </div>
                            </div>

                            <!-- Mobile View (Inspiration based) -->
                            <div class="mobile-only" style="margin-bottom: 1.5rem;">
                                <div class="portfolio-card-mobile">
                                    <div class="card-title">@b.TradeName - @b.ConsigneeUnitDescription</div>
                                    <div class="info-line">Registry ID: <strong>#@b.Id.ToString("D5")</strong></div>
                                    <div class="info-line">TIN Number: <strong>@b.TIN</strong></div>
                                    <div class="info-line">Location: <strong>@b.City</strong></div>
                                    <div class="status-alert" style="color: #059669; background: #ecfdf5;">
                                        <i class="fas fa-check-circle"></i> Profile Status: <strong>Verified & Active</strong>
                                    </div>
                                </div>
                                <div class="mobile-action-tabs">
                                    <button type="button" onclick='showBranchSummary("@b.ConsigneeUnitId.ToString().ToLower()")'>
                                        <i class="fas fa-eye"></i> See Summary
                                    </button>
                                    <button type="button" onclick='loadBranchRegistry("@b.ConsigneeUnitDescription", "@b.Code", "@b.TIN", "@b.ConsigneeUnitId.ToString().ToLower()")'>
                                        <i class="fas fa-edit"></i> Update Profile
                                    </button>
                                </div>
                            </div>
                        }
                        <!-- Create Branch 
                        <button type="button" class="desktop-only btn-create-branch" style="min-height: 200px; display: flex; flex-direction: column; justify-content: center; gap: 1rem; align-items: center;" onclick="alert('Initializing New Branch Registry...')">
                            <i class="fas fa-plus-circle" style="font-size: 2.25rem; color: var(--accent-color);"></i>
                        </button>
                        -->
                    </div>
                </div>
            </div>
            
            <div class="desktop-only" style="display: grid; gap: 1.5rem; align-content: start;">
                  <div class="glass-card" style="padding: 0 1.5rem 1.5rem 1.5rem; background: rgba(255, 255, 255, 0.85) !important; border: 1px solid var(--border-color) !important; border-radius: 20px !important; display: flex; flex-direction: column; height: 550px; overflow-y: auto; position: relative;">
                     <h4 style="font-weight: 800; color: var(--navy-deep); margin: 0; font-size: 1.1rem; border-bottom: 2px solid rgba(16, 56, 58, 0.05); padding: 1.5rem 0 0.75rem 0; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; position: sticky; top: 0; background: rgba(255, 255, 255, 0.95); z-index: 10; backdrop-filter: blur(5px);">
                         <span style="display: flex; align-items: center; gap: 0.5rem;">
                             <i class="fas fa-file-invoice" style="color: var(--accent-color);"></i>
                             <span>Details</span>
                         </span>
                         <span id="sidebarSummaryBranchName" style="font-size: 0.75rem; color: var(--text-muted); font-weight: 700; max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Loading...</span>
                     </h4>
                     <!-- Scrollable list of collapsed details -->
                     <div id="sidebarSummaryScrollable" style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem;">
                         <!-- Loaded dynamically via JS -->
                     </div>
                  </div>

                  <!-- Rooms Gauge Card with Contacts -->
                  <div class="card" style="padding: 1.5rem; border: 1px solid var(--border-color); display: flex; flex-direction: column; justify-content: space-between; gap: 1rem; background: rgba(255, 255, 255, 0.85) !important; border-radius: 20px !important;">
                      <div style="display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; width: 100%;">
                          <div>
                              <div style="color: var(--text-muted); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.5rem;">Total Portfolio Rooms</div>
                              <div style="font-size: 1.65rem; font-weight: 800; color: var(--navy-deep); line-height: 1;">@(hotel.NumberOfRooms * Model.Count()) Units</div>
                              <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem; font-weight: 500;">Across all active registered branches</div>
                          </div>
                          <div style="position: relative; width: 80px; height: 80px; flex-shrink: 0;">
                              <!-- SVG Gauge Ring -->
                              <svg width="80" height="80" viewBox="0 0 36 36" style="transform: rotate(-90deg);">
                                  <path stroke="rgba(16, 56, 58, 0.05)" stroke-width="3" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                  <path stroke="var(--primary-color)" stroke-width="3" stroke-dasharray="100, 100" stroke-linecap="round" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                              </svg>
                              <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 0.85rem; font-weight: 800; color: var(--navy-deep);">100%</div>
                          </div>
                      </div>
                      
                      <!-- Registry Contacts Inline -->
                      <div style="border-top: 1px dashed rgba(16, 56, 58, 0.1); padding-top: 0.75rem; margin-top: 0.25rem; font-size: 0.75rem; display: flex; flex-direction: column; gap: 0.4rem; width: 100%;">
                          <div style="display: flex; align-items: center; gap: 0.5rem; font-weight: 700; color: var(--navy-deep); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                              <i class="fas fa-envelope" style="color: var(--accent-color); width: 14px;"></i>
                              <span style="color: var(--text-muted); font-weight: 600; font-size: 0.68rem; text-transform: uppercase;">Email:</span>
                              <span>@hotel.Email @(!string.IsNullOrEmpty(hotel.Email2) ? $" / {hotel.Email2}" : "")</span>
                          </div>
                          <div style="display: flex; align-items: center; gap: 0.5rem; font-weight: 700; color: var(--navy-deep);">
                              <i class="fas fa-phone" style="color: var(--accent-color); width: 14px;"></i>
                              <span style="color: var(--text-muted); font-weight: 600; font-size: 0.68rem; text-transform: uppercase;">Phone:</span>
                              <span>@hotel.Phone1 @(!string.IsNullOrEmpty(hotel.Phone2) ? $" / {hotel.Phone2}" : "")</span>
                          </div>
                      </div>
                  </div>

                  <!-- Category Medallion Card -->
                  <div class="card" style="padding: 1.5rem; border: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; background: rgba(255, 255, 255, 0.85) !important; border-radius: 20px !important;">
                      <div>
                          <div style="color: var(--text-muted); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.5rem;">Global Category</div>
                          <div style="font-size: 1.35rem; font-weight: 800; color: var(--navy-deep); line-height: 1.2;">@hotel.Category</div>
                          <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem; font-weight: 500;">Approved grading classification</div>
                      </div>
                      <div style="width: 56px; height: 56px; background: rgba(218, 161, 18, 0.1); border: 2px solid var(--accent-color); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--accent-color); font-size: 1.5rem; box-shadow: 0 4px 10px rgba(218, 161, 18, 0.2); flex-shrink: 0;">
                          <i class="fas fa-award"></i>
                      </div>
                  </div>
            </div>
        </div>
    </div>

    <!-- Registry Editor Tab -->
    <div id="editorTab" class="tab-content profile-tab-animate" style="display: none;">
        
        <!-- Section Jump & Expand Control Bar -->
        <div class="mobile-only editor-control-bar">
            <div style="flex: 1;">
                <select id="sectionJumpDropdown" class="form-select form-select-sm" style="font-size: 0.75rem; font-weight: 700; border-radius: 6px; border: 1.5px solid #cbd5e1; color: #1e3a8a; padding-right: 1.5rem;">
                    <option value="">Jump...</option>
                    <option value="basic">1. BASIC INFO</option>
                    <option value="accommodation">2. ACCOMMODATION</option>
                    <option value="food_beverage">3. FOOD & BEVERAGE</option>
                    <option value="meetings_events">4. MEETINGS & EVENTS</option>
                    <option value="facilities">5. FACILITIES</option>
                    <option value="accessibility">6. ACCESSIBILITY</option>
                    <option value="security">7. SAFETY & SECURITY</option>
                    <option value="transport">8. TRANSPORT & PARKING</option>
                    <option value="ict">9. ICT & SERVICES</option>
                    <option value="utilities">10. UTILITIES & RESILIENCE</option>
                    <option value="sustainability">11. SUSTAINABILITY</option>
                    <option value="staffing">12. STAFFING & LANGS</option>
                    <option value="attachments">13. ATTACHMENTS</option>
                </select>
            </div>
            <button type="button" id="toggleSectionsBtn" class="btn btn-outline-primary btn-sm" onclick="toggleAllSections()" style="flex: 0 0 auto; font-size: 0.7rem; font-weight: 700; display: flex; align-items: center; gap: 0.35rem; border-color: #1e3a8a; color: #1e3a8a; white-space: nowrap; padding: 0.35rem 0.6rem; border-radius: 6px;">
                <i class="fas fa-expand-arrows-alt" id="toggleSectionsIcon"></i> <span id="toggleSectionsText">Expand All</span>
            </button>
        </div>

        <form asp-action="CommitRegistry" method="post" id="registryForm">
            <div class="registry-layout" style="grid-template-columns: 1fr;">
                <!-- Registry Sections -->
                <div class="registry-sections-container" style="display: grid; gap: 1rem;">
            <input type="hidden" name="Id" id="editorConsigneeId" value="@hotel.Id" />
            <input type="hidden" name="ConsigneeUnitId" id="editorConsigneeUnitId" value="" />
            <input type="hidden" name="TradeName" id="editorTradeName" value="" />
            
            <!-- 1. Basic Information -->
            <div class="collapsible-card" id="section-basic">
                <div class="collapsible-header" onclick="toggleCollapsible(this)">
                    <h3><i class="fas fa-id-card"></i> <span class="section-num">1.</span> BASIC INFO</h3>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <button type="button" class="btn-save-section" onclick="event.stopPropagation(); saveRegistry(this, 'basic')" title="Update Section">
                            <i class="fas fa-cloud-arrow-up"></i>
                        </button>
                        <i class="fas fa-chevron-down chevron"></i>
                    </div>
                </div>
                <div class="collapsible-content" style="display: none; padding: 0;">
                    <div class="form-flex-col-2" style="background: #fafafa;">
                        <!-- Left Side -->
                        <div style="padding: 1.5rem; border-right: 1px solid var(--border-color); background: #ffffff;">
                            <div class="form-group-inline">
                                <label class="form-label">Property Name *</label>
                                <input type="text" name="TradeName" id="form-trade-name" value="@hotel.Name" class="form-control" required />
                            </div>
                            <div class="form-group-inline">
                                <label class="form-label">Registration Name</label>
                                <input type="text" name="RegistrationName" id="form-registration-name" value="@hotel.RegistrationName" class="form-control" />
                            </div>
                            <div class="form-group-inline">
                                <label class="form-label">Star Category</label>
                                <select name="StarCategory" id="form-star-cat" class="form-control">
                                    <option value="">Select Category</option>
                                    <option value="5" selected="@(hotel.StarCategory == "5")">5 Star</option>
                                    <option value="4" selected="@(hotel.StarCategory == "4")">4 Star</option>
                                    <option value="3" selected="@(hotel.StarCategory == "3")">3 Star</option>
                                    <option value="2" selected="@(hotel.StarCategory == "2")">2 Star</option>
                                    <option value="1" selected="@(hotel.StarCategory == "1")">1 Star</option>
                                    <option value="Tourist Recommended" selected="@(hotel.StarCategory == "Tourist Recommended")">Tourist Recommended</option>
                                    <option value="Motel" selected="@(hotel.StarCategory == "Motel")">Motel</option>
                                    <option value="Guest House" selected="@(hotel.StarCategory == "Guest House")">Guest House</option>
                                    <option value="Pension" selected="@(hotel.StarCategory == "Pension")">Pension</option>
                                    <option value="Not Rated" selected="@(hotel.StarCategory == "Not Rated")">Not Rated</option>
                                </select>
                            </div>
                            <div class="form-group-inline">
                                <label class="form-label">Address</label>
                                <input type="text" name="Address" id="form-address-general" value="Addis Ababa" class="form-control" placeholder="Property General Address" />
                            </div>
                            <div class="form-group-inline">
                                <label class="form-label">Sub City</label>
                                <select name="Subcity" id="form-subcity-basic" class="form-control">
                                    <option value="">Select Subcity</option>
                                    <option value="16" selected="@(hotel.Subcity == "16")">Addis Ababa</option>
                                    <option value="17" selected="@(hotel.Subcity == "17")">Addis Ketema</option>

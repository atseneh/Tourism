                        <label class="form-label">Total Sqm</label>
                        <input type="number" id="meetAreaSize" class="form-control" style="background: var(--bg-muted); font-weight: 700;" readonly />
                    </div>
                </div>

                <div class="form-group full-width">
                    <label class="form-label">Max Capacity (Pax)</label>
                    <input type="number" id="meetMaxCap" class="form-control" placeholder="Total seated capacity" />
                </div>

                <div class="form-group full-width">
                    <label class="form-label">Equipment & Features</label>
                    <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem; background: #f8fafc; padding: 0.75rem; border-radius: 0.75rem; border: 1.5px solid var(--border-color);">
                        <label class="premium-checkbox" style="width: 100%; padding: 0.4rem;">
                            <input type="checkbox" id="meetSoundSystem" />
                            <span class="checkbox-text" style="font-size: 0.75rem;">Sound System</span>
                            <div class="checkbox-box"><i class="fas fa-check"></i></div>
                        </label>
                        <label class="premium-checkbox" style="width: 100%; padding: 0.4rem;">
                            <input type="checkbox" id="meetHVAC" />
                            <span class="checkbox-text" style="font-size: 0.75rem;">HVAC (AC)</span>
                            <div class="checkbox-box"><i class="fas fa-check"></i></div>
                        </label>
                        <label class="premium-checkbox" style="width: 100%; padding: 0.4rem;">
                            <input type="checkbox" id="meetScreen" />
                            <span class="checkbox-text" style="font-size: 0.75rem;">Projector/Screen</span>
                            <div class="checkbox-box"><i class="fas fa-check"></i></div>
                        </label>
                        <label class="premium-checkbox" style="width: 100%; padding: 0.4rem;">
                            <input type="checkbox" id="meetInterpreter" />
                            <span class="checkbox-text" style="font-size: 0.75rem;">Interp. Booth</span>
                            <div class="checkbox-box"><i class="fas fa-check"></i></div>
                        </label>
                    </div>
                </div>
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                <button type="button" onclick="closeMeetingRoomModal()" class="btn-premium btn-secondary" style="flex: 1;">Cancel</button>
                <button type="button" onclick="addMeetingRoom()" class="btn-premium" style="flex: 2;">Add Room</button>
            </div>
        </div>
    </div>
</div>

<!-- Attachment Preview Modal -->
<div id="attachmentPreviewModal" class="modal-overlay" style="display: none; z-index: 9999;">
    <div class="modal-content-animate" style="max-width: 800px; width: 90%;">
        <div class="glass-card" style="padding: 2rem; position: relative; border-top: 4px solid var(--primary-color);">
            <button onclick="closeAttachmentPreviewModal()" style="position: absolute; top: 1rem; right: 1rem; background: transparent; border: none; font-size: 1.25rem; color: var(--text-muted); cursor: pointer;"><i class="fas fa-times"></i></button>
            <h2 id="previewModalTitle" style="margin-bottom: 1.5rem; color: var(--navy-deep); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 1.35rem; padding-right: 2rem;"><i class="fas fa-eye" style="color: var(--primary-color); margin-right: 0.5rem;"></i> Preview Document</h2>
            <div id="previewModalBody" style="display: flex; justify-content: center; align-items: center; min-height: 250px; background: #f8fafc; border-radius: 0.75rem; border: 1px solid var(--border-color); overflow: hidden; padding: 1rem;">
                <!-- Preview content will be injected dynamically -->
            </div>
            <div style="display: flex; gap: 1rem; margin-top: 1.5rem; justify-content: flex-end;">
                <button type="button" onclick="closeAttachmentPreviewModal()" class="btn-premium btn-secondary" style="padding: 0.6rem 1.5rem; font-size: 0.85rem;">Close</button>

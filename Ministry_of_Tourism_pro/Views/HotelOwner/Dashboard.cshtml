        function syncLanguagesFromValue(val) {
            const predefined = ["English", "French", "Swahili", "Chinese (Mandarin)", "Spanish", "German", "Italian", "Portuguese"];
            const all = (val || "").split(',').map(s => s.trim()).filter(s => s !== "");
            
            const selectedPredefined = all.filter(l => predefined.includes(l));
            const others = all.filter(l => !predefined.includes(l));
            
            if (others.length > 0) {
                $('#lang-other-checkbox').prop('checked', true);
                $('#lang-other-input').val(others.join(', '));
                $('#other-languages-container').show();
            } else {
                $('#lang-other-checkbox').prop('checked', false);
                $('#lang-other-input').val('');
                $('#other-languages-container').hide();
            }
            
            $('#langSelect').val(selectedPredefined).trigger('change');
        }

        function syncCheckinFromValue(val) {
            const options = (val || "").split(',').map(s => s.trim()).filter(s => s !== "");
            $('#checkinSelect').val(options).trigger('change');
        }

        // Initialize Select2 on page load
        $(document).ready(function() {
            $('#checkinSelect').select2({
                placeholder: 'Select Check-in Options',
                width: '100%'
            }).on('change', function() {
                var vals = $(this).val();
                $('#form-checkin-out').val(vals ? vals.join(', ') : '');
            });

            function updateFinalLanguages() {
                var baseVals = $('#langSelect').val() || [];
                var otherText = $('#lang-other-checkbox').is(':checked') ? $('#lang-other-input').val() : '';
                var combined = [...baseVals];
                if (otherText) combined.push(otherText);
                $('#form-languages-hidden').val(combined.join(', '));
            }

            $('#langSelect').select2({
                placeholder: 'Select Languages',
                width: '100%'
            }).on('change', updateFinalLanguages);

            $('#lang-other-checkbox').on('change', function() {
                if ($(this).is(':checked')) {
                    $('#other-languages-container').slideDown(200);
                } else {
                    $('#other-languages-container').slideUp(200);
                    $('#lang-other-input').val('');
                }
                updateFinalLanguages();
            });

            $('#lang-other-input').on('input', updateFinalLanguages);

            // Sync initial values from hidden fields
            var initialCheckin = $('#form-checkin-out').val();
            if (initialCheckin) {
                var opts = initialCheckin.split(',').map(function(s) { return s.trim(); }).filter(function(s) { return s !== ''; });
                $('#checkinSelect').val(opts).trigger('change');
            }

            var initialLangs = $('#form-languages-hidden').val();
            if (initialLangs) {
                syncLanguagesFromValue(initialLangs);
            }
        });

        // Centralized Registry Persistence Logic
        async function saveRegistry(btn, mode) {
        const unitId = $('#editorConsigneeUnitId').val();
        if (!unitId) {
            Swal.fire('Error', 'Please select a property branch first.', 'error');
            return;
        }

        const btnText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

        try {
            const formData = new FormData();
            formData.append('branchId', unitId);
            formData.append('mode', mode);

            // Always send core identifiers and location
            formData.append('Id', $('#editorConsigneeId').val());
            formData.append('ConsigneeUnitId', $('#editorConsigneeUnitId').val());
            formData.append('TradeName', $('#form-trade-name').val());
            formData.append('Latitude', $('#lat-input').val());
            formData.append('Longitude', $('#lng-input').val());

            // 1. Collect Basic Info if mode is 'basic' or 'all'

        function renderMeetingRooms() {
            const container = $('#meeting-room-tbody');
            container.empty();

            if (meetingRoomList.length === 0) {
                container.append('<tr><td colspan="5" class="text-center text-muted py-3">No meeting rooms added yet.</td></tr>');

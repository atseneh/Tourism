@model Ministry_of_Tourism_pro.Models.PreRegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Pre-Registration";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pre-Registration - AATMCDP</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --navy-deep: #020617;
            --primary-color: #064e3b;
            --accent-gold: #ca8a04;
            --text-muted: #94a3b8;
            --border-color: rgba(255, 255, 255, 0.1);
        }

        body {
            font-family: 'Outfit', sans-serif;
            margin: 0;
            padding: 0;
            background-color: var(--navy-deep);
            overflow-x: hidden;
        }

        .auth-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            padding: 1rem;
            background: #020617;
            overflow: hidden;
        }

        .bg-base-image {
            position: absolute;
            inset: 0;
            background-image: url('/images/backgrounds/E3.JPG');
            /* background-size: 70% auto; */
            background-position: center;
            background-repeat: no-repeat;
            z-index: 0;
            opacity: 0.45;
            filter: contrast(1.1) brightness(0.8);
            -webkit-mask-image: radial-gradient(circle, rgba(0,0,0,1) 30%, rgba(0,0,0,0) 70%);
            mask-image: radial-gradient(circle, rgba(0,0,0,1) 30%, rgba(0,0,0,0) 70%);
            animation: slowRotate 240s linear infinite;
        }

        @@keyframes slowRotate {
            from { transform: rotate(0deg) scale(1); }
            to { transform: rotate(360deg) scale(1.1); } /* Subtle zoom while rotating */
        }

        .grain-overlay {
            position: absolute;
            inset: 0;
            z-index: 2;
            opacity: 0.04;
            pointer-events: none;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        }

        .bg-watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 80vh;
            height: 80vh;
            background-image: url('/logo/logo.svg'); /* Using existing logo path */
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
            opacity: 0.03;
            z-index: 1;
            filter: brightness(2);
            pointer-events: none;
            animation: watermarkRotate 120s linear infinite;
        }

        @@keyframes watermarkRotate {
            from { transform: translate(-50%, -50%) rotate(0deg); }
            to { transform: translate(-50%, -50%) rotate(360deg); }
        }

        .auth-card {
            width: 100%;
            max-width: 500px;
            padding: 1.75rem 2.25rem;
            position: relative;
            z-index: 10;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(25px) saturate(200%);
            -webkit-backdrop-filter: blur(25px) saturate(200%);
            border-radius: 32px;
            border: 1px solid rgba(255, 255, 255, 0.4);
            box-shadow: 
                0 10px 25px -5px rgba(0, 0, 0, 0.1),
                0 25px 50px -12px rgba(0, 0, 0, 0.25);
        }

        .halo-container {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 700px;
            height: 700px;
            z-index: 5;
            pointer-events: none;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .halo-ring {
            position: absolute;
            border-radius: 50%;
            border: 1px solid var(--accent-gold);
            opacity: 0.15;
        }

        .ring-1 { 
            width: 560px; 
            height: 560px; 
            border-width: 2px; 
            box-shadow: 0 0 30px rgba(202, 138, 4, 0.1);
            animation: haloPulse 5s infinite alternate ease-in-out;
        }

        .ring-2 { 
            width: 630px; 
            height: 630px; 
            border-style: dashed; 
            border-width: 1px;
            animation: haloRotate 60s linear infinite;
        }

        @@keyframes haloPulse {
            from { transform: scale(1); opacity: 0.1; }
            to { transform: scale(1.05); opacity: 0.2; }
        }

        @@keyframes haloRotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .brand-logo-circle {
            width: 80px;
            height: 80px;
            margin: 0 auto 1rem;
            background: white;
            border-radius: 50%;
            padding: 2px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 
                0 0 20px rgba(202, 138, 4, 0.3),
                0 10px 25px rgba(0, 0, 0, 0.2);
            border: 2px solid var(--accent-gold);
            overflow: hidden;
            transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .brand-logo-circle:hover {
            transform: scale(1.1) rotate(5deg);
        }

        .brand-logo-circle img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .portal-title {
            color: var(--primary-color);
            margin: 0;
            font-weight: 800;
            font-size: 1.4rem;
            line-height: 1.2;
            letter-spacing: -0.5px;
            text-align: center;
        }

        .form-group { margin-bottom: 1.1rem; }
        .form-label { 
            display: block; 
            font-weight: 700; 
            font-size: 0.7rem; 
            color: var(--primary-color); 
            margin-bottom: 0.4rem; 
            text-transform: uppercase; 
            letter-spacing: 1.2px; 
            opacity: 0.8;
        }
        
        .form-control {
            width: 100%;
            padding: 0.8rem 1.1rem;
            border-radius: 14px;
            border: 1px solid #e2e8f0;
            background: rgba(255, 255, 255, 0.9);
            color: var(--navy-deep);
            font-family: inherit;
            font-size: 0.95rem;
            box-sizing: border-box;
            transition: all 0.3s;
        }
        .form-control:focus { outline: none; border-color: var(--primary-color); background: white; box-shadow: 0 0 0 4px rgba(16, 56, 58, 0.1); }
        .form-control[readonly] { background-color: #f1f5f9 !important; cursor: not-allowed; border-color: #cbd5e1; color: #64748b; }

        .btn-premium {
            width: 100%;
            background: linear-gradient(135deg, var(--primary-color) 0%, #043a2c 100%);
            color: white;
            border: none;
            padding: 1rem;
            border-radius: 14px;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
            font-family: inherit;
            margin-top: 1.25rem;
            box-shadow: 0 8px 20px -5px rgba(6, 78, 59, 0.4);
            position: relative;
            overflow: hidden;
        }

        .btn-premium::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: 0.5s;
        }

        .btn-premium:hover::after {
            left: 100%;
        }

        .btn-premium:hover { 
            transform: translateY(-2px); 
            box-shadow: 0 12px 25px -5px rgba(6, 78, 59, 0.5);
            background: linear-gradient(135deg, #085a44 0%, var(--primary-color) 100%);
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 1rem;
            transition: color 0.2s;
        }
        .back-link:hover { color: var(--navy-deep); }

        .animate-fade-in { animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
        @@keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        
        .validation-message { color: #ef4444; font-size: 0.75rem; margin-top: 0.25rem; font-weight: 600; }

        /* Modal Styles */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.7);
            backdrop-filter: blur(8px);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background: white;
            padding: 2rem;
            border-radius: 24px;
            width: 90%;
            max-width: 400px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            position: relative;
            animation: modalSlideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @@keyframes modalSlideUp {
            from { transform: translateY(30px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .modal-close {
            position: absolute;
            top: 1rem;
            right: 1.25rem;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 1.25rem;
            transition: all 0.2s;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }
        .modal-close:hover {
            background: rgba(0,0,0,0.05);
            color: var(--navy-deep);
            transform: rotate(90deg);
        }

        .shake {
            animation: shake 0.4s cubic-bezier(.36,.07,.19,.97) both;
        }

        @@keyframes shake {
            10%, 90% { transform: translateX(-1px); }
            20%, 80% { transform: translateX(2px); }
            30%, 50%, 70% { transform: translateX(-4px); }
            40%, 60% { transform: translateX(4px); }
        }
    </style>
</head>
<body>
    <div class="auth-wrapper">
        <div class="bg-base-image"></div>
        <div class="bg-watermark"></div>
        <div class="grain-overlay"></div>

        <div class="halo-container">
            <div class="halo-ring ring-1"></div>
            <div class="halo-ring ring-2"></div>
        </div>
        
        <div class="glass-card auth-card animate-fade-in">
            <a asp-action="Login" class="back-link">
                <i class="fas fa-arrow-left"></i>
                Back to Login
            </a>

            <div style="text-align: center; margin-bottom: 1.25rem;">
                <div class="brand-logo-circle">
                    <img src="/logo/logo.svg" alt="AATMCDP Logo" />
                </div>
                <h1 class="portal-title">Organization Pre-Registration</h1>
                <p style="color: var(--text-muted); margin-top: 0.5rem; font-size: 0.9rem;">Submit your basic details to begin the registration process.</p>
            </div>

            <form asp-action="PreRegister" method="post">
                <div asp-validation-summary="ModelOnly" style="color: #ef4444; font-size: 0.85rem; margin-bottom: 1rem; text-align: center; font-weight: 700;"></div>
                
                <div class="form-group">
                    <label asp-for="Name" class="form-label">Legal Name / Establishment</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Grand Addis Hotel" />
                    <span asp-validation-for="Name" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TIN" class="form-label">TIN Number (10 Digits)</label>
                    <input asp-for="TIN" class="form-control" placeholder="0000000000" maxlength="10" />
                    <span asp-validation-for="TIN" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Category" class="form-label">Sector Category</label>
                    <select asp-for="Category" class="form-control">
                        <option value="">-- Select Category --</option>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var pref in (IEnumerable<CNET_V7_Domain.Domain.SettingSchema.PreferenceDTO>)ViewBag.Categories)
                            {
                                <option value="@pref.Id">@pref.Description</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="Category" class="validation-message"></span>
                </div>

                <div class="form-group" style="border-top: 1px solid var(--border-color); padding-top: 1rem; margin-top: 1rem;">
                    <label asp-for="Phone" class="form-label">Phone Number for Verification</label>
                    <input asp-for="Phone" class="form-control" id="phone-input" placeholder="0911..." style="margin-bottom: 0.75rem; font-size: 1.1rem; padding: 0.85rem;" />
                    <button type="button" id="btn-send-otp" class="btn-premium" style="background: var(--navy-deep); border-radius: 12px; height: 3.5rem;">
                        <i class="fas fa-sms" style="margin-right: 0.75rem;"></i>Send Verification OTP
                    </button>
                    <span asp-validation-for="Phone" class="validation-message"></span>
                </div>

                <button type="submit" id="btn-submit-reg" class="btn-premium" style="display: none;">
                    <span>Submit Registration</span>
                    <i class="fas fa-paper-plane" style="margin-left: 0.75rem; font-size: 0.85rem;"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- OTP Verification Modal -->
    <div id="otp-modal" class="modal-overlay" style="display: none;">
        <div class="modal-content">
            <span class="modal-close" onclick="$('#otp-modal').fadeOut()">&times;</span>
            <div style="text-align: center; margin-bottom: 1.5rem;">
                <div style="width: 50px; height: 50px; background: rgba(6, 78, 59, 0.1); color: var(--primary-color); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-size: 1.5rem; border: 1px solid rgba(6, 78, 59, 0.2);">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <h2 style="margin: 0; font-size: 1.25rem; color: var(--primary-color);">Verify Phone</h2>
                <p id="otp-modal-phone" style="color: var(--text-muted); font-size: 0.85rem; margin-top: 0.25rem;">Enter the code sent to your phone</p>
            </div>

            <div class="form-group" style="margin-bottom: 1.5rem;">
                <label class="form-label" style="text-align: center;">6-Digit Verification Code</label>
                <input type="text" id="otp-code-input" class="form-control" placeholder="000000" maxlength="6" 
                       style="text-align: center; font-weight: 700; letter-spacing: 4px; font-size: 1.5rem; height: 3.5rem; border-color: var(--primary-color); background: white;" />
                <div id="otp-timer" style="text-align: center; font-size: 0.75rem; color: var(--primary-color); margin-top: 0.75rem; min-height: 1rem;"></div>
            </div>

            <button type="button" id="btn-confirm-otp" class="btn-premium">
                <span>Verify Now</span>
            </button>
            
            <p id="otp-status-msg" style="text-align: center; font-size: 0.75rem; margin-top: 1rem; min-height: 1rem; font-weight: 600;"></p>
        </div>
    </div>
    <!-- Registration Success Modal -->
    <div id="success-modal" class="modal-overlay" style="display: none;">
        <div class="modal-content" style="text-align: center;">
            <div style="width: 70px; height: 70px; background: rgba(202, 138, 4, 0.1); color: var(--accent-gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; font-size: 2.5rem; border: 1px solid rgba(202, 138, 4, 0.2);">
                <i class="fas fa-paper-plane"></i>
            </div>
            <h2 style="margin-bottom: 1rem; color: var(--primary-color);">Registration Complete!</h2>
            <div style="background: rgba(6, 78, 59, 0.03); padding: 1.25rem; border-radius: 16px; margin-bottom: 1.5rem; border: 1px solid rgba(6, 78, 59, 0.1);">
                <p style="margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--navy-deep);">
                    We have sent your <strong>Username</strong> and <strong>Password</strong> to:
                    <br />
                    <span id="success-phone" style="font-weight: 800; font-size: 1.25rem; color: var(--primary-color); display: block; margin-top: 0.5rem;"></span>
                </p>
            </div>
            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 2rem;">Please check your SMS and use the credentials to login.</p>
            <a href="/Account/Login" class="btn-premium" style="text-decoration: none;">
                Close & Go to Login
            </a>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        let otpData = {
            messageId: '',
            vc: '',
            phoneNumber: ''
        };

        $(document).ready(function() {
            $('#btn-send-otp').click(function() {
                const name = $('input[name="Name"]').val().trim();
                const tin = $('input[name="TIN"]').val().trim();
                const category = $('select[name="Category"]').val();
                const phone = $('#phone-input').val().trim();

                // Strict Validation
                if (!name || name.length < 3) {
                    Swal.fire({ 
                        icon: 'warning', 
                        title: 'Invalid Name', 
                        text: 'Legal Name / Establishment is required (min 3 characters).',
                        confirmButtonColor: '#10383a'
                    });
                    return;
                }
                if (!/^\d{10}$/.test(tin)) {
                    Swal.fire({ 
                        icon: 'warning', 
                        title: 'Invalid TIN', 
                        text: 'TIN Number must be exactly 10 digits (numeric only).',
                        confirmButtonColor: '#10383a'
                    });
                    return;
                }
                if (!category) {
                    Swal.fire({ 
                        icon: 'warning', 
                        title: 'Category Required', 
                        text: 'Please select a Sector Category before proceeding.',
                        confirmButtonColor: '#10383a'
                    });
                    return;
                }
                if (!/^(\+251|0)[97]\d{8}$/.test(phone)) {
                    Swal.fire({ 
                        icon: 'warning', 
                        title: 'Invalid Phone', 
                        text: 'Please enter a valid Ethiopian phone number (e.g., 0912345678 or +251912345678).',
                        confirmButtonColor: '#10383a'
                    });
                    return;
                }

                const btn = $(this);
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Validating...');

                // PRE-VERIFICATION CHECK: Check if TIN or Phone already exists
                $.ajax({
                    url: '/Account/ValidatePreRegister',
                    type: 'POST',
                    data: { tin: tin, phone: phone },
                    success: function(valResponse) {
                        if (valResponse.success) {
                            // If validation passes, proceed to send OTP
                            btn.html('<i class="fas fa-spinner fa-spin"></i> Sending...');
                            $.ajax({
                                url: '/Account/SendOTP',
                                type: 'POST',
                                data: { phoneNumber: phone },
                                success: function(response) {
                                    if (response.success) {
                                        otpData.messageId = response.data.messageId;
                                        otpData.vc = response.data.verificationId;
                                        otpData.phoneNumber = phone;
                                        
                                        // LOCK FORM VALUES - Once verification is sent, values can't be edited
                                        $('input[name="Name"], input[name="TIN"], #phone-input').prop('readonly', true);
                                        const selectCat = $('select[name="Category"]');
                                        selectCat.prop('disabled', true).css('background-color', '#f1f5f9');
                                        
                                        // Add hidden input to ensure category is still submitted
                                        if ($('#hidden-category').length === 0) {
                                            $('<input>').attr({
                                                type: 'hidden',
                                                id: 'hidden-category',
                                                name: 'Category',
                                                value: selectCat.val()
                                            }).appendTo('form');
                                        }

                                        $('#otp-modal-phone').text('Enter the code sent to ' + phone);
                                        $('#otp-modal').css('display', 'flex').hide().fadeIn();
                                        $('#otp-status-msg').css('color', '#16a34a').text('Code sent successfully!');
                                        btn.html('<i class="fas fa-check"></i> Sent').css('background', '#16a34a');
                                        startTimer(60);
                                    } else {
                                        Swal.fire({ icon: 'error', title: 'SMS Error', text: response.message });
                                        btn.prop('disabled', false).html('<i class="fas fa-sms"></i> Send OTP');
                                    }
                                },
                                error: function() {
                                    Swal.fire({ icon: 'error', title: 'System Error', text: 'Could not connect to the SMS service.' });
                                    btn.prop('disabled', false).html('<i class="fas fa-sms"></i> Send OTP');
                                }
                            });
                        } else {
                            // Validation failed (TIN or Phone exists)
                            Swal.fire({ 
                                icon: 'error', 
                                title: 'Registration Conflict', 
                                text: valResponse.message,
                                confirmButtonColor: '#10383a'
                            });
                            btn.prop('disabled', false).html('<i class="fas fa-sms"></i> Send OTP');
                        }
                    },
                    error: function() {
                        Swal.fire({ icon: 'error', title: 'System Error', text: 'Could not connect to the validation service.' });
                        btn.prop('disabled', false).html('<i class="fas fa-sms"></i> Send OTP');
                    }
                });
            });

            $('#btn-confirm-otp').click(function() {
                const code = $('#otp-code-input').val();
                if (!code || code.length < 4) { // OTPs are usually 4-6 digits
                    Swal.fire({ icon: 'warning', title: 'Invalid Code', text: 'Please enter the verification code.' });
                    return;
                }

                const btn = $(this);
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

                const payload = {
                    phoneNumber: otpData.phoneNumber,
                    vc: otpData.vc,
                    code: code,
                    messageId: otpData.messageId
                };

                $.ajax({
                    url: '/Account/VerifyOTP',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function(response) {
                        if (response.success) {
                            $('#otp-status-msg').css('color', '#166534').text('Phone verified successfully!');
                            
                            setTimeout(() => {
                                $('#otp-modal').fadeOut();
                                $('#btn-send-otp').html('<i class="fas fa-check-circle"></i> Phone Verified').css('background', '#16a34a').prop('disabled', true);
                                $('#phone-input').prop('readonly', true);
                                
                                // Show and pulse the submit button
                                $('#btn-submit-reg').fadeIn().css('display', 'flex').addClass('animate-pulse');
                            }, 1000);
                        } else {
                            $('#otp-status-msg').css('color', '#dc2626').text('Verification failed: ' + (response.message || 'Incorrect code'));
                            btn.prop('disabled', false).html('<span>Verify Now</span>');
                        }
                    },
                    error: function() {
                        Swal.fire({ icon: 'error', title: 'Connection Error', text: 'Verification service is currently unavailable.' });
                        btn.prop('disabled', false).text('Verify');
                    }
                });
            });

            // AJAX Form Submission
            $('#btn-submit-reg').click(function(e) {
                e.preventDefault();
                const form = $(this).closest('form');
                const btn = $(this);
                
                btn.prop('disabled', true).html('<span>Registering...</span> <i class="fas fa-spinner fa-spin" style="margin-left:0.5rem;"></i>');

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function(response) {
                        if (response.success) {
                            $('#success-phone').text(response.phone);
                            $('#success-modal').css('display', 'flex').hide().fadeIn();
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Registration Failed',
                                text: response.message || 'An unexpected error occurred.'
                            });
                            btn.prop('disabled', false).html('<span>Submit Registration</span> <i class="fas fa-paper-plane" style="margin-left: 0.75rem;"></i>');
                        }
                    },
                    error: function() {
                        Swal.fire({ icon: 'error', title: 'Offline', text: 'Unable to process registration at this moment.' });
                        btn.prop('disabled', false).html('<span>Submit Registration</span>');
                    }
                });
            });

            function startTimer(duration) {
                let timer = duration, minutes, seconds;
                const display = $('#otp-timer');
                const interval = setInterval(function () {
                    minutes = parseInt(timer / 60, 10);
                    seconds = parseInt(timer % 60, 10);

                    seconds = seconds < 10 ? "0" + seconds : seconds;
                    display.text("Resend in " + seconds + "s");

                    if (--timer < 0) {
                        clearInterval(interval);
                        display.text("");
                        // Only show Resend if not already verified
                        if (!$('#btn-send-otp').prop('disabled') || !$('#btn-send-otp').text().includes('Verified')) {
                            $('#btn-send-otp').prop('disabled', false).html('<i class="fas fa-sms"></i> Resend Code');
                        }
                    }
                }, 1000);
            }

            // Static Backdrop Logic for OTP Modal
            $('#otp-modal').click(function(e) {
                if (e.target === this) {
                    const content = $(this).find('.modal-content');
                    content.addClass('shake');
                    setTimeout(() => content.removeClass('shake'), 400);
                }
            });

            $(document).keydown(function(e) {
                if (e.key === "Escape" && $('#otp-modal').is(':visible')) {
                    const content = $('#otp-modal').find('.modal-content');
                    content.addClass('shake');
                    setTimeout(() => content.removeClass('shake'), 400);
                }
            });
        });
    </script>
</body>
</html>

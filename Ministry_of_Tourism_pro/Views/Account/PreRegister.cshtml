@model Ministry_of_Tourism_pro.Models.PreRegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Pre-Registration";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pre-Registration - AATMCDP</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --navy-deep: #0f172a;
            --primary-color: #10383a;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
        }

        body {
            font-family: 'Outfit', sans-serif;
            margin: 0;
            padding: 0;
            background-color: var(--navy-deep);
            overflow-x: hidden;
        }

        .auth-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            padding: 2rem;
        }

        .bg-overlay {
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at center, rgba(15, 23, 42, 0.3) 0%, rgba(70, 76, 92, 0.8) 100%);
            z-index: 1;
        }

        .bg-image {
            position: absolute;
            inset: 0;
            background-image: url('/images/backgrounds/skyline.png');
            background-size: cover;
            background-position: center;
            z-index: 0;
        }

        .auth-card {
            width: 100%;
            max-width: 500px;
            padding: 3rem;
            position: relative;
            z-index: 10;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(20px) saturate(180%);
            border-radius: 32px;
            border: 1px solid rgba(255, 255, 255, 0.4);
            box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.3);
        }

        .brand-logo-circle {
            width: 80px;
            height: 80px;
            margin: 0 auto 1.5rem;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            padding: 10px;
        }

        .brand-logo-circle img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .portal-title {
            color: var(--navy-deep);
            margin: 0;
            font-weight: 800;
            font-size: 1.5rem;
            line-height: 1.25;
            letter-spacing: -0.5px;
            text-align: center;
        }

        .form-group { margin-bottom: 1.25rem; }
        .form-label { display: block; font-weight: 700; font-size: 0.75rem; color: var(--navy-deep); margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 1px; }
        
        .form-control {
            width: 100%;
            padding: 0.85rem 1.15rem;
            border-radius: 14px;
            border: 1px solid var(--border-color);
            background: rgba(248, 250, 252, 0.8);
            color: var(--navy-deep);
            font-family: inherit;
            font-size: 0.95rem;
            box-sizing: border-box;
            transition: all 0.3s;
        }
        .form-control:focus { outline: none; border-color: var(--primary-color); background: white; box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1); }

        .btn-premium {
            width: 100%;
            background: linear-gradient(135deg, #10383a 0%, #0b2c2e 100%);
            color: white;
            border: none;
            padding: 1rem;
            border-radius: 14px;
            font-weight: 800;
            font-size: 1rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
            font-family: inherit;
            margin-top: 1rem;
            box-shadow: 0 8px 20px -5px rgba(16, 56, 58, 0.4);
        }
        .btn-premium:hover { transform: translateY(-2px); box-shadow: 0 12px 25px -5px rgba(16, 56, 58, 0.5); }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 1.5rem;
            transition: color 0.2s;
        }
        .back-link:hover { color: var(--navy-deep); }

        .animate-fade-in { animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
        @@keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        
        .validation-message { color: #ef4444; font-size: 0.75rem; margin-top: 0.25rem; font-weight: 600; }
    </style>
</head>
<body>
    <div class="auth-wrapper">
        <div class="bg-image"></div>
        <div class="bg-overlay"></div>
        
        <div class="glass-card auth-card animate-fade-in">
            <a asp-action="Login" class="back-link">
                <i class="fas fa-arrow-left"></i>
                Back to Login
            </a>

            <div style="text-align: center; margin-bottom: 2rem;">
                <div class="brand-logo-circle">
                    <img src="/logo/logo.svg" alt="AATMCDP Logo" />
                </div>
                <h1 class="portal-title">Organization Pre-Registration</h1>
                <p style="color: var(--text-muted); margin-top: 0.5rem; font-size: 0.9rem;">Submit your basic details to begin the registration process.</p>
            </div>

            <form asp-action="PreRegister" method="post">
                <div asp-validation-summary="ModelOnly" style="color: #ef4444; font-size: 0.85rem; margin-bottom: 1rem; text-align: center; font-weight: 700;"></div>
                
                <div class="form-group">
                    <label asp-for="Name" class="form-label">Legal Name / Establishment</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Grand Addis Hotel" />
                    <span asp-validation-for="Name" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TIN" class="form-label">TIN Number (10 Digits)</label>
                    <input asp-for="TIN" class="form-control" placeholder="0000000000" maxlength="10" />
                    <span asp-validation-for="TIN" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Category" class="form-label">Sector Category</label>
                    <select asp-for="Category" class="form-control">
                        <option value="">-- Select Category --</option>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var pref in (IEnumerable<CNET_V7_Domain.Domain.SettingSchema.PreferenceDTO>)ViewBag.Categories)
                            {
                                <option value="@pref.Id">@pref.Description</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="Category" class="validation-message"></span>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="form-group">
                    <label asp-for="Phone" class="form-label">Phone Number</label>
                    <div style="display: flex; gap: 0.5rem;">
                        <input asp-for="Phone" class="form-control" id="phone-input" placeholder="0911..." />
                        <button type="button" id="btn-send-otp" class="btn-premium" style="width: 140px; margin: 0; padding: 0.5rem; font-size: 0.85rem; background: var(--navy-deep);">
                            <i class="fas fa-sms" style="margin-right: 0.5rem;"></i>Send OTP
                        </button>
                    </div>
                    <span asp-validation-for="Phone" class="validation-message"></span>
                </div>

                <!-- OTP Verification Area -->
                <div id="otp-verification-area" style="display: none; margin-bottom: 1.5rem; animation: fadeIn 0.3s ease;">
                    <div class="form-group" style="background: #f0fdf4; padding: 1.25rem; border-radius: 18px; border: 1.5px solid #bbf7d0;">
                        <label class="form-label" style="color: #166534; display: flex; justify-content: space-between;">
                            <span>Verification Code</span>
                            <span id="otp-timer" style="text-transform: none; color: #16a34a;"></span>
                        </label>
                        <div style="display: flex; gap: 0.75rem;">
                            <input type="text" id="otp-code-input" class="form-control" placeholder="Enter 6-digits" maxlength="6" style="text-align: center; font-weight: 800; letter-spacing: 4px; font-size: 1.2rem; border-color: #86efac;" />
                            <button type="button" id="btn-confirm-otp" class="btn-premium" style="width: 110px; margin: 0; background: #166534; border-radius: 12px;">Verify</button>
                        </div>
                        <p id="otp-status-msg" style="margin: 0.5rem 0 0; font-size: 0.75rem; font-weight: 600;"></p>
                    </div>
                </div>

                <button type="submit" id="btn-submit-reg" class="btn-premium" disabled style="opacity: 0.6; cursor: not-allowed;">
                    <span>Submit Registration</span>
                    <i class="fas fa-paper-plane" style="margin-left: 0.75rem; font-size: 0.85rem;"></i>
                </button>
            </form>

            <div style="text-align: center; margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
                <p style="color: var(--text-muted); font-size: 0.8rem; font-weight: 500;">&copy; @DateTime.Now.Year AATMCDP </p>
            </div>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        let otpData = {
            messageId: '',
            vc: '',
            phoneNumber: ''
        };

        $(document).ready(function() {
            $('#btn-send-otp').click(function() {
                const phone = $('#phone-input').val();
                if (!phone || phone.length < 10) {
                    alert('Please enter a valid phone number.');
                    return;
                }

                const btn = $(this);
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

                $.ajax({
                    url: '/Account/SendOTP',
                    type: 'POST',
                    data: { phoneNumber: phone },
                    success: function(response) {
                        if (response.success) {
                            otpData.messageId = response.data.messageId;
                            otpData.vc = response.data.code; // The 'code' from sendotp is used as 'vc' in verifyotp
                            otpData.phoneNumber = phone;
                            
                            $('#otp-verification-area').slideDown();
                            $('#otp-status-msg').css('color', '#16a34a').text('Code sent successfully to ' + phone);
                            btn.html('<i class="fas fa-check"></i> Sent');
                            startTimer(60);
                        } else {
                            alert('Error: ' + response.message);
                            btn.prop('disabled', false).html('<i class="fas fa-sms"></i> Send OTP');
                        }
                    },
                    error: function() {
                        alert('System error occurred.');
                        btn.prop('disabled', false).html('<i class="fas fa-sms"></i> Send OTP');
                    }
                });
            });

            $('#btn-confirm-otp').click(function() {
                const code = $('#otp-code-input').val();
                if (!code || code.length < 4) { // OTPs are usually 4-6 digits
                    alert('Please enter the code correctly.');
                    return;
                }

                const btn = $(this);
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

                const payload = {
                    phoneNumber: otpData.phoneNumber,
                    vc: otpData.vc,
                    code: code,
                    messageId: otpData.messageId
                };

                $.ajax({
                    url: '/Account/VerifyOTP',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function(response) {
                        if (response.success) {
                            $('#otp-status-msg').css('color', '#166534').text('Phone verified successfully!');
                            $('#otp-verification-area').find('.form-group').css('background', '#dcfce7').css('border-color', '#22c55e');
                            btn.hide();
                            $('#otp-code-input').prop('disabled', true);
                            $('#btn-send-otp').prop('disabled', true);
                            $('#phone-input').prop('readonly', true);
                            
                            // Enable registration
                            $('#btn-submit-reg').prop('disabled', false).css('opacity', '1').css('cursor', 'pointer');
                        } else {
                            alert('Verification failed: ' + response.message);
                            btn.prop('disabled', false).text('Verify');
                        }
                    },
                    error: function() {
                        alert('System error occurred during verification.');
                        btn.prop('disabled', false).text('Verify');
                    }
                });
            });

            function startTimer(duration) {
                let timer = duration, minutes, seconds;
                const display = $('#otp-timer');
                const interval = setInterval(function () {
                    minutes = parseInt(timer / 60, 10);
                    seconds = parseInt(timer % 60, 10);

                    seconds = seconds < 10 ? "0" + seconds : seconds;
                    display.text("Resend in " + seconds + "s");

                    if (--timer < 0) {
                        clearInterval(interval);
                        display.text("");
                        $('#btn-send-otp').prop('disabled', false).html('<i class="fas fa-sms"></i> Resend Code');
                    }
                }, 1000);
            }
        });
    </script>
</body>
</html>

@model Ministry_of_Tourism_pro.Models.PreRegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Pre-Registration";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pre-Registration - Addis Ababa Tourism & MICE</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-teal: #10383A;
            --primary-dark: #0a2425;
            --accent-gold: #DAA112;
            --accent-hover: #b9840c;
            --bg-light: #F4F5F6;
            --text-dark: #1E293B;
            --text-muted: #64748B;
            --input-bg: #F5F5F5;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Outfit', 'Inter', sans-serif;
            color: var(--text-dark);
            background-color: var(--bg-light);
            height: 100vh;
            overflow: hidden;
        }

        ::selection {
            background-color: rgba(218, 161, 18, 0.25) !important;
            color: var(--primary-teal) !important;
        }
        
        ::-moz-selection {
            background-color: rgba(218, 161, 18, 0.25) !important;
            color: var(--primary-teal) !important;
        }

        .login-container {
            display: flex;
            flex-direction: row-reverse;
            width: 100%;
            height: 100vh;
        }

        /* Left Pane: Gallery Showcase */
        .login-left-pane {
            position: relative;
            width: 58%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .bg-slider {
            position: absolute;
            inset: 0;
            z-index: 0;
        }

        .slide {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            opacity: 0;
            transition: opacity 1.5s ease-in-out;
            transform: scale(1.05);
            animation: panSlow 25s linear infinite;
        }

        .slide.active {
            opacity: 1;
        }

        .slide:nth-child(1) { background-image: url('/images/backgrounds/adwa5.jpg'); }
        .slide:nth-child(2) { background-image: url('/images/backgrounds/new_addis_ababa_03.jfif'); }
        .slide:nth-child(3) { background-image: url('/images/backgrounds/Addis_Ababa_02S.jpg'); }

        .bg-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(16, 56, 58, 0.94) 0%, rgba(10, 36, 37, 0.8) 100%);
            z-index: 1;
        }

        @@keyframes panSlow {
            0% { transform: scale(1.05) translate(0, 0); }
            50% { transform: scale(1.12) translate(-1%, -0.5%); }
            100% { transform: scale(1.05) translate(0, 0); }
        }

        .login-brand-info {
            position: relative;
            z-index: 2;
            color: white;
            text-align: center;
            max-width: 520px;
            padding: 2rem;
        }

        .brand-logo-circle {
            width: 100px;
            height: 100px;
            background: white;
            border-radius: 50%;
            padding: 2px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
            padding: 12px;
            border: 2px solid var(--accent-gold);
            animation: float 6s ease-in-out infinite;
        }

        @@keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }

        .brand-logo-circle img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .brand-title {
            font-size: 2.8rem;
            font-weight: 800;
            margin: 0;
            letter-spacing: -1px;
            color: var(--accent-gold);
            text-transform: uppercase;
            text-shadow: 0 2px 4px rgba(0,0,0,0.2);
        }

        .brand-subtitle {
            font-size: 1.4rem;
            font-weight: 500;
            margin: 0.25rem 0 1rem;
            letter-spacing: 0.5px;
            color: white;
        }

        .brand-tagline {
            font-size: 0.95rem;
            font-weight: 300;
            color: rgba(255, 255, 255, 0.75);
            margin-bottom: 2.5rem;
            letter-spacing: 1.2px;
        }

        .brand-stats {
            display: flex;
            justify-content: center;
            gap: 0.75rem;
        }

        .stat-pill {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.12);
            padding: 0.5rem 1rem;
            border-radius: 999px;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(4px);
        }

        .stat-pill i {
            color: var(--accent-gold);
        }

        /* Right Pane: Form */
        .login-right-pane {
            width: 42%;
            height: 100%;
            background: radial-gradient(circle at 10% 20%, rgba(16, 56, 58, 0.05) 0%, rgba(244, 245, 246, 1) 90%),
                        radial-gradient(circle at 90% 80%, rgba(218, 161, 18, 0.08) 0%, rgba(244, 245, 246, 1) 90%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2.5rem;
            box-sizing: border-box;
            overflow-y: auto;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.55);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.8);
            border-radius: 24px;
            padding: 2.5rem;
            box-shadow: 0 20px 40px rgba(16, 56, 58, 0.05),
                        inset 0 1px 0 rgba(255, 255, 255, 0.6);
            box-sizing: border-box;
            width: 100%;
        }

        .login-card-wrapper {
            width: 100%;
            max-width: 400px;
            display: flex;
            flex-direction: column;
        }

        .mobile-logo-header {
            display: none;
            text-align: center;
            margin-bottom: 2rem;
        }

        .login-form-header {
            margin-bottom: 1.5rem;
            position: relative;
            text-align: center;
        }

        .form-title {
            font-size: 2.2rem;
            font-weight: 800;
            margin: 0;
            color: var(--primary-teal);
            letter-spacing: -1px;
        }

        .form-title span {
            color: var(--accent-gold);
        }

        .form-subtitle {
            font-size: 0.95rem;
            color: var(--text-muted);
            margin-top: 0.5rem;
            line-height: 1.4;
        }

        .form-group-custom {
            margin-bottom: 1.25rem;
            position: relative;
        }

        .form-label-custom {
            display: block;
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--primary-teal);
            margin-bottom: 0.4rem;
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
            width: 100%;
        }

        .input-icon {
            position: absolute;
            left: 1.1rem;
            color: var(--text-muted);
            font-size: 0.9rem;
            z-index: 10;
        }

        .form-input-custom {
            width: 100%;
            padding: 0.85rem 1.1rem 0.85rem 2.6rem;
            border-radius: 14px;
            border: 1px solid rgba(16, 56, 58, 0.15);
            background-color: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(5px);
            -webkit-backdrop-filter: blur(5px);
            color: var(--text-dark);
            font-family: inherit;
            font-size: 0.95rem;
            box-sizing: border-box;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .form-input-custom:focus {
            outline: none;
            background-color: rgba(255, 255, 255, 0.95);
            border-color: var(--accent-gold);
            box-shadow: 0 0 0 4px rgba(218, 161, 18, 0.15);
        }

        .form-input-custom[readonly] {
            background-color: rgba(229, 231, 235, 0.5) !important;
            cursor: not-allowed;
            color: #4b5563;
        }

        /* Gold Pill Primary Button */
        .btn-submit-gold {
            width: 100%;
            background: linear-gradient(135deg, var(--accent-gold) 0%, #c4900f 100%);
            color: white;
            border: none;
            padding: 0.95rem;
            border-radius: 999px;
            font-weight: 800;
            font-size: 1.05rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            font-family: inherit;
            box-shadow: 0 6px 15px rgba(218, 161, 18, 0.25);
        }

        .btn-submit-gold:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(218, 161, 18, 0.4);
            background: linear-gradient(135deg, #e4aa1a 0%, var(--accent-gold) 100%);
        }

        .btn-submit-gold:active {
            transform: translateY(0);
        }

        .icon-arrow {
            font-size: 0.9rem;
            transition: transform 0.3s;
        }

        .btn-submit-gold:hover .icon-arrow {
            transform: translateX(3px);
        }

        /* Secondary Teal Button */
        .btn-teal-pill {
            width: 100%;
            background: var(--primary-teal);
            color: white;
            border: none;
            padding: 0.85rem 1.5rem;
            border-radius: 999px;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            transition: all 0.3s;
            font-family: inherit;
            box-shadow: 0 4px 10px rgba(16, 56, 58, 0.2);
            margin-top: 0.75rem;
        }

        .btn-teal-pill:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
        }

        /* Phone verification specific rules */
        .phone-verification-group {
            border-top: 1px solid #cbd5e1;
            padding-top: 1.25rem;
            margin-top: 1.5rem;
        }

        .validation-message {
            color: #ef4444;
            font-size: 0.78rem;
            margin-top: 0.25rem;
            font-weight: 600;
            display: block;
        }

        .form-validation-summary {
            color: #ef4444;
            font-size: 0.85rem;
            margin-bottom: 1.25rem;
            text-align: center;
            font-weight: 700;
        }

        .form-links {
            text-align: center;
            margin-top: 1.5rem;
        }

        .form-links p {
            color: var(--text-muted);
            font-size: 0.9rem;
            font-weight: 500;
            margin: 0;
        }

        .form-links a {
            color: var(--primary-teal);
            text-decoration: none;
            font-weight: 700;
            transition: color 0.2s;
        }

        .form-links a:hover {
            color: var(--accent-gold);
            text-decoration: underline;
        }

        .form-footer {
            text-align: center;
            margin-top: 2rem;
            padding-top: 1.5rem;
            border-top: 1px solid #cbd5e1;
        }

        .form-footer p {
            color: var(--text-muted);
            font-size: 0.75rem;
            margin: 0;
        }

        /* Modal styling */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(13, 34, 35, 0.75);
            backdrop-filter: blur(10px);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background: white;
            padding: 2.5rem;
            border-radius: 24px;
            width: 90%;
            max-width: 420px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.45);
            position: relative;
            animation: modalSlideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @@keyframes modalSlideUp {
            from { transform: translateY(30px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .modal-close {
            position: absolute;
            top: 1.25rem;
            right: 1.25rem;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 1.4rem;
            transition: all 0.2s;
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        .modal-close:hover {
            background: rgba(0,0,0,0.06);
            color: var(--text-dark);
            transform: rotate(90deg);
        }

        .success-details-box {
            background: rgba(16, 56, 58, 0.03);
            padding: 1.5rem;
            border-radius: 18px;
            margin-bottom: 1.5rem;
            border: 1px solid rgba(16, 56, 58, 0.08);
            text-align: center;
        }

        .animate-fade-in {
            animation: fadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .shake {
            animation: shake 0.4s cubic-bezier(.36,.07,.19,.97) both;
        }

        @@keyframes shake {
            10%, 90% { transform: translateX(-1px); }
            20%, 80% { transform: translateX(2px); }
            30%, 50%, 70% { transform: translateX(-4px); }
            40%, 60% { transform: translateX(4px); }
        }

        /* Back Link styles */
        .back-link-desktop {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 700;
            font-size: 0.9rem;
            margin-bottom: 1rem;
            transition: color 0.2s;
        }

        .back-link-desktop:hover {
            color: var(--primary-teal);
        }

        /* Responsive Overrides */
        @@media (max-width: 991px) {
            .login-left-pane {
                display: none;
            }
            .login-right-pane {
                width: 100%;
                background-color: var(--bg-light);
            }
            .mobile-logo-header {
                display: block;
            }
            .brand-logo-circle-mobile {
                width: 75px;
                height: 75px;
                background: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 0.75rem;
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
                padding: 10px;
                border: 2px solid var(--accent-gold);
            }
            .brand-logo-circle-mobile img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }
            .mobile-logo-header h2 {
                font-size: 1.3rem;
                font-weight: 800;
                color: var(--primary-teal);
                margin: 0;
            }
        }

        @@media (max-width: 576px) {
            body {
                background-color: var(--bg-light) !important;
                height: 100vh;
                overflow: hidden;
            }

            .login-container {
                align-items: center;
                justify-content: center;
                padding: 1.5rem 1rem;
                box-sizing: border-box;
            }

            .login-right-pane {
                padding: 0;
                background: transparent;
                display: flex;
                align-items: center;
                justify-content: center;
                width: 100%;
            }

            .login-card-wrapper {
                width: 100%;
                max-width: 360px;
            }

            .mobile-logo-header {
                display: block;
                margin-bottom: 1.25rem;
            }

            .mobile-logo-header h2 {
                display: none !important;
            }

            .brand-logo-circle-mobile {
                width: 80px;
                height: 80px;
                background: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto;
                box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
                padding: 8px;
                border: 2px solid var(--accent-gold);
            }

            .login-form-header {
                display: none !important;
            }

            .login-card {
                background: rgba(255, 255, 255, 0.7) !important;
                backdrop-filter: blur(20px) !important;
                -webkit-backdrop-filter: blur(20px) !important;
                border: 1px solid rgba(255, 255, 255, 0.8) !important;
                padding: 1.25rem 1rem !important;
                border-radius: 20px !important;
                box-shadow: 0 15px 35px rgba(16, 56, 58, 0.06),
                            inset 0 1px 0 rgba(255, 255, 255, 0.6) !important;
                width: 100% !important;
                box-sizing: border-box !important;
            }

            .form-group-custom {
                margin-bottom: 0.85rem;
                width: 100% !important;
                box-sizing: border-box !important;
            }

            .form-label-custom {
                display: none !important;
            }

            .input-icon {
                display: none !important;
            }

            .form-input-custom {
                padding: 0 1rem !important; /* Premium spacious padding */
                border-radius: 8px !important; /* Smooth premium corners */
                border: 1px solid rgba(16, 56, 58, 0.15) !important; /* Visible crisp border */
                background-color: rgba(255, 255, 255, 0.5) !important; /* Glassy input bg */
                backdrop-filter: blur(5px) !important;
                -webkit-backdrop-filter: blur(5px) !important;
                height: 40px !important;
                font-size: 0.95rem !important;
                width: 100% !important;
                box-sizing: border-box !important;
                transition: all 0.3s ease !important;
                color: var(--text-dark) !important;
            }

            .form-input-custom:focus {
                background-color: rgba(255, 255, 255, 0.95) !important;
                border-color: var(--accent-gold) !important;
                box-shadow: 0 0 0 3px rgba(218, 161, 18, 0.15) !important;
            }

            .phone-verification-group {
                border-top: none !important;
                padding-top: 0 !important;
                margin-top: 0.85rem !important;
            }

            #phone-input {
                margin-bottom: 0 !important;
                font-size: 0.92rem !important;
            }

            #btn-send-otp {
                background: var(--primary-teal) !important;
                color: white !important;
                border: none !important;
                border-radius: 8px !important;
                height: 40px !important;
                font-size: 0.92rem !important;
                font-weight: 700 !important;
                margin-top: 0.85rem !important;
                box-shadow: 0 4px 10px rgba(16, 56, 58, 0.15) !important;
                width: 100% !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
                gap: 0.5rem !important;
                box-sizing: border-box !important;
                transition: all 0.2s ease !important;
            }

            #btn-send-otp:hover {
                background: var(--primary-dark) !important;
                transform: translateY(-1px) !important;
            }

            #btn-submit-reg {
                background: linear-gradient(135deg, var(--accent-gold) 0%, #c4900f 100%) !important;
                color: white !important;
                border: none !important;
                border-radius: 8px !important;
                height: 40px !important;
                font-size: 0.95rem !important;
                font-weight: 700 !important;
                margin-top: 0.85rem !important;
                box-shadow: 0 4px 12px rgba(218, 161, 18, 0.2) !important;
                width: 100% !important;
                box-sizing: border-box !important;
                display: none !important;
                align-items: center !important;
                justify-content: center !important;
                gap: 0.5rem !important;
                transition: all 0.3s ease !important;
            }

            #btn-submit-reg.show-button {
                display: flex !important;
            }

            #btn-submit-reg:hover {
                transform: translateY(-1px) !important;
                box-shadow: 0 6px 16px rgba(218, 161, 18, 0.3) !important;
            }

            /* Modal adjustments on mobile */
            .modal-overlay {
                background: rgba(13, 34, 35, 0.8) !important;
                backdrop-filter: blur(8px) !important;
                padding: 1rem !important;
                box-sizing: border-box !important;
                align-items: center !important;
                justify-content: center !important;
            }

            .modal-content {
                background: rgba(255, 255, 255, 0.85) !important;
                backdrop-filter: blur(20px) !important;
                -webkit-backdrop-filter: blur(20px) !important;
                border: 1px solid rgba(255, 255, 255, 0.9) !important;
                padding: 2.25rem 1.25rem 1.5rem !important;
                border-radius: 20px !important;
                width: calc(100% - 2rem) !important;
                max-width: 340px !important;
                box-shadow: 0 20px 50px rgba(10, 36, 37, 0.3) !important;
                box-sizing: border-box !important;
            }

            .modal-content h2 {
                font-size: 1.2rem !important;
            }

            .modal-content p {
                font-size: 0.82rem !important;
            }

            #otp-code-input {
                height: 40px !important;
                font-size: 1.25rem !important;
                border-radius: 8px !important;
                letter-spacing: 4px !important;
                background-color: rgba(255, 255, 255, 0.5) !important;
                border: 1px solid rgba(16, 56, 58, 0.15) !important;
                box-sizing: border-box !important;
                padding: 0 !important;
            }

            #otp-code-input:focus {
                outline: none !important;
                background-color: rgba(255, 255, 255, 0.95) !important;
                border-color: var(--accent-gold) !important;
                box-shadow: 0 0 0 3px rgba(218, 161, 18, 0.15) !important;
            }

            #otp-timer {
                font-size: 0.75rem !important;
                margin-top: 0.5rem !important;
            }

            #btn-confirm-otp {
                background: linear-gradient(135deg, var(--accent-gold) 0%, #c4900f 100%) !important;
                border-radius: 8px !important;
                height: 40px !important;
                font-size: 0.95rem !important;
                font-weight: 700 !important;
                box-shadow: 0 4px 10px rgba(218, 161, 18, 0.2) !important;
                width: 100% !important;
                margin-top: 0.5rem !important;
            }

            .success-details-box {
                background: rgba(16, 56, 58, 0.05) !important;
                border: 1px solid rgba(16, 56, 58, 0.1) !important;
                padding: 1rem !important;
                border-radius: 12px !important;
                margin-bottom: 1.25rem !important;
            }

            .success-details-box span {
                font-size: 1.15rem !important;
            }

            .back-link-desktop {
                display: none !important;
            }

            .form-links p {
                color: var(--text-muted) !important;
                font-weight: 500 !important;
            }

            .form-links a {
                color: var(--accent-gold) !important;
                font-weight: 800 !important;
                text-decoration: underline !important;
            }

            select.form-input-custom {
                appearance: none !important;
                -webkit-appearance: none !important;
                -moz-appearance: none !important;
                background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="%2310383a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>') !important;
                background-repeat: no-repeat !important;
                background-position: right 1rem center !important;
                background-size: 1.25rem !important;
                padding-right: 2.5rem !important;
                padding-left: 1.2rem !important;
            }
        }

</style>
</head>
<body>
    <div class="login-container">
        <!-- Left Pane: Showcase Gallery -->
        <div class="login-left-pane">
            <div class="bg-slider">
                <div class="slide active"></div>
                <div class="slide"></div>
                <div class="slide"></div>
            </div>
            <div class="bg-overlay"></div>
            
            <div class="login-brand-info animate-fade-in">
                <div class="brand-logo-circle">
                    <img src="/logo/logo.svg" alt="AATC Logo" />
                </div>
                <h1 class="brand-title">Addis Ababa</h1>
                <h2 class="brand-subtitle">Tourism & MICE Commission</h2>
                <div class="brand-tagline">Land of Origins • Gateway to Africa</div>
                
                <div class="brand-stats">
                    <div class="stat-pill">
                        <i class="fas fa-hotel"></i>
                        <span>Premium Hotels</span>
                    </div>
                    <div class="stat-pill">
                        <i class="fas fa-utensils"></i>
                        <span>Fine Dining</span>
                    </div>
                    <div class="stat-pill">
                        <i class="fas fa-handshake"></i>
                        <span>World-class MICE</span>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Right Pane: Form -->
        <div class="login-right-pane">
            <div class="login-card-wrapper animate-fade-in">
                <!-- Mobile Logo -->
                <div class="mobile-logo-header">
                    <div class="brand-logo-circle-mobile">
                        <img src="/logo/logo.svg" alt="AATC Logo" />
                    </div>
                    <h2>Addis Ababa Tourism & MICE</h2>
                </div>

                <!-- Back Link (placed neatly above header) -->
                <a asp-action="Login" class="back-link-desktop">
                    <i class="fas fa-arrow-left"></i> Back to Login
                </a>

                <div class="login-form-header">
                    <h3 class="form-title">Pre-<span>Register</span></h3>
                    <p class="form-subtitle">Submit organization details to begin the registration process.</p>
                </div>

                <div class="login-card">
                    <form asp-action="PreRegister" method="post">
                        <div asp-validation-summary="ModelOnly" class="form-validation-summary"></div>
                        
                        <div class="form-group-custom">
                            <label asp-for="Name" class="form-label-custom">Legal Name / Establishment</label>
                            <div class="input-wrapper">
                                <i class="fas fa-building input-icon"></i>
                                <input asp-for="Name" class="form-input-custom" placeholder="Enter Legal Name" />
                            </div>
                            <span asp-validation-for="Name" class="validation-message"></span>
                        </div>

                        <div class="form-group-custom">
                            <label asp-for="TIN" class="form-label-custom">TIN Number (10 Digits)</label>
                            <div class="input-wrapper">
                                <i class="fas fa-file-invoice input-icon"></i>
                                <input asp-for="TIN" class="form-input-custom" placeholder="Enter 10-Digit TIN" maxlength="10" />
                            </div>
                            <span asp-validation-for="TIN" class="validation-message"></span>
                        </div>

                        <div class="form-group-custom">
                            <label asp-for="Category" class="form-label-custom">Sector Category</label>
                            <div class="input-wrapper">
                                <i class="fas fa-list input-icon"></i>
                                <select asp-for="Category" class="form-input-custom" style="appearance: none; background-image: url('data:image/svg+xml;utf8,<svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;24&quot; height=&quot;24&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;%2310383a&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;><polyline points=&quot;6 9 12 15 18 9&quot;></polyline></svg>'); background-repeat: no-repeat; background-position: right 1rem center; background-size: 1.25rem; padding-left: 2.6rem;">
                                    <option value="">-- Select Sector Category --</option>
                                    @if (ViewBag.Categories != null)
                                    {
                                        foreach (var pref in (IEnumerable<CNET_V7_Domain.Domain.SettingSchema.PreferenceDTO>)ViewBag.Categories)
                                        {
                                            <option value="@pref.Id">@pref.Description</option>
                                        }
                                    }
                                </select>
                            </div>
                            <span asp-validation-for="Category" class="validation-message"></span>
                        </div>

                        <div class="form-group-custom phone-verification-group">
                            <label asp-for="Phone" class="form-label-custom">Phone Number for Verification</label>
                            <div class="input-wrapper">
                                <i class="fas fa-phone input-icon"></i>
                                <input asp-for="Phone" class="form-input-custom" id="phone-input" placeholder="Enter Phone Number (09...)" style="padding-left: 2.6rem;" />
                            </div>
                            <span asp-validation-for="Phone" class="validation-message"></span>
                            
                            <button type="button" id="btn-send-otp" class="btn-teal-pill btn-send-otp-custom">
                                <i class="fas fa-sms"></i> Send Verification OTP
                            </button>
                        </div>

                        <button type="submit" id="btn-submit-reg" class="btn-submit-gold" style="display: none; margin-top: 1rem;">
                            <span>Submit Registration</span>
                            <i class="fas fa-paper-plane icon-arrow"></i>
                        </button>
                        
                        <div class="form-links">
                            <p>
                                Already registered? <a asp-action="Login">Back to Login</a>
                            </p>
                        </div>
                    </form>
                </div>

                <div class="form-footer">
                    <h4 class="footer-portal-title" style="display: none;">Addis Ababa Tourism & MICE Portal</h4>
                    <p>&copy; @DateTime.Now.Year AATMCDP</p>
                </div>
            </div>
        </div>
    </div>

    <!-- OTP Verification Modal -->
    <div id="otp-modal" class="modal-overlay">
        <div class="modal-content">
            <span class="modal-close" onclick="$('#otp-modal').fadeOut()">&times;</span>
            <div style="text-align: center; margin-bottom: 1.75rem;">
                <div style="width: 56px; height: 56px; background: rgba(16, 56, 58, 0.08); color: var(--primary-teal); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-size: 1.5rem; border: 1px solid rgba(16, 56, 58, 0.15);">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <h2 style="margin: 0; font-size: 1.3rem; color: var(--primary-teal); font-weight: 800;">Verify Phone</h2>
                <p id="otp-modal-phone" style="color: var(--text-muted); font-size: 0.85rem; margin-top: 0.25rem;">Enter the code sent to your phone</p>
            </div>

            <div class="form-group-custom" style="margin-bottom: 1.5rem;">
                <label class="form-label-custom" style="text-align: center;">6-Digit Verification Code</label>
                <input type="text" id="otp-code-input" class="form-input-custom" placeholder="000000" maxlength="6" 
                       style="text-align: center; font-weight: 800; letter-spacing: 6px; font-size: 1.6rem; height: 3.5rem; border-color: var(--primary-teal); background: white; padding: 0;" />
                <div id="otp-timer" style="text-align: center; font-size: 0.78rem; color: var(--primary-teal); margin-top: 0.75rem; min-height: 1.2rem; font-weight: 700;"></div>
            </div>

            <button type="button" id="btn-confirm-otp" class="btn-submit-gold" style="margin-top: 0;">
                <span>Verify Now</span>
            </button>
            
            <p id="otp-status-msg" style="text-align: center; font-size: 0.78rem; margin-top: 1rem; min-height: 1rem; font-weight: 700;"></p>
        </div>
    </div>

    <!-- Registration Success Modal -->
    <div id="success-modal" class="modal-overlay">
        <div class="modal-content" style="text-align: center;">
            <div style="width: 70px; height: 70px; background: rgba(218, 161, 18, 0.08); color: var(--accent-gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; font-size: 2.2rem; border: 1px solid rgba(218, 161, 18, 0.15);">
                <i class="fas fa-check"></i>
            </div>
            <h2 style="margin-bottom: 0.75rem; color: var(--primary-teal); font-weight: 800;">Registration Complete!</h2>
            <div class="success-details-box">
                <p style="margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--text-dark);">
                    We have sent your <strong>Username</strong> and <strong>Password</strong> to:
                    <br />
                    <span id="success-phone" style="font-weight: 800; font-size: 1.3rem; color: var(--primary-teal); display: block; margin-top: 0.5rem;"></span>
                </p>
            </div>
            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 2rem;">Please check your SMS and use the credentials to login.</p>
            <a href="/Account/Login" class="btn-submit-gold" style="text-decoration: none; margin-top: 0;">
                Close & Go to Login
            </a>
        </div>
    </div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        let otpData = {
            messageId: '',
            vc: '',
            phoneNumber: ''
        };

        // Which OTP provider is active: "Cnet" or "Direct"
        let activeOtpProvider = 'Cnet'; // default fallback

        $(document).ready(function() {
            // Fetch the active OTP provider from server on page load
            $.ajax({
                url: '/Account/GetActiveOtpProvider',
                type: 'GET',
                success: function(response) {
                    if (response && response.provider) {
                        activeOtpProvider = response.provider;
                        console.log('Active OTP Provider: ' + activeOtpProvider);
                    }
                },
                error: function() {
                    console.warn('Could not fetch OTP provider config. Defaulting to Cnet.');
                }
            });

            $('#btn-send-otp').click(function() {
                const name = $('input[name="Name"]').val().trim();
                const tin = $('input[name="TIN"]').val().trim();
                const category = $('select[name="Category"]').val();
                const phone = $('#phone-input').val().trim();

                // Strict Validation
                if (!name || name.length < 3) {
                    Swal.fire({ 
                        icon: 'warning', 
                        title: 'Invalid Name', 
                        text: 'Legal Name / Establishment is required (min 3 characters).',
                        confirmButtonColor: '#10383a'
                    });
                    return;
                }
                if (!/^\d{10}$/.test(tin)) {
                    Swal.fire({ 
                        icon: 'warning', 
                        title: 'Invalid TIN', 
                        text: 'TIN Number must be exactly 10 digits (numeric only).',
                        confirmButtonColor: '#10383a'
                    });
                    return;
                }
                if (!category) {
                    Swal.fire({ 
                        icon: 'warning', 
                        title: 'Category Required', 
                        text: 'Please select a Sector Category before proceeding.',
                        confirmButtonColor: '#10383a'
                    });
                    return;
                }
                if (!/^(\+251|0)[97]\d{8}$/.test(phone)) {
                    Swal.fire({ 
                        icon: 'warning', 
                        title: 'Invalid Phone', 
                        text: 'Please enter a valid Ethiopian phone number (e.g., 0912345678 or +251912345678).',
                        confirmButtonColor: '#10383a'
                    });
                    return;
                }

                const btn = $(this);
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Validating...');

                // PRE-VERIFICATION CHECK: Check if TIN or Phone already exists
                $.ajax({
                    url: '/Account/ValidatePreRegister',
                    type: 'POST',
                    data: { tin: tin, phone: phone },
                    success: function(valResponse) {
                        if (valResponse.success) {
                            // If validation passes, proceed to send OTP
                            btn.html('<i class="fas fa-spinner fa-spin"></i> Sending...');

                            // Choose endpoint based on active provider
                            var sendUrl = activeOtpProvider === 'Direct'
                                ? '/Account/SendDirectOTP'
                                : '/Account/SendOTP';

                            $.ajax({
                                url: sendUrl,
                                type: 'POST',
                                data: { phoneNumber: phone },
                                success: function(response) {
                                    if (response.success) {
                                        // Store OTP data
                                        otpData.phoneNumber = phone;

                                        if (activeOtpProvider === 'Direct') {
                                            otpData.vc = response.data.verificationId || '';
                                            otpData.messageId = '';
                                        } else {
                                            otpData.messageId = response.data.messageId;
                                            otpData.vc = response.data.verificationId;
                                        }
                                        
                                        // LOCK FORM VALUES
                                        $('input[name="Name"], input[name="TIN"], #phone-input').prop('readonly', true);
                                        const selectCat = $('select[name="Category"]');
                                        selectCat.prop('disabled', true).css('background-color', '#e5e7eb');
                                        
                                        // Add hidden input to ensure category is still submitted
                                        if ($('#hidden-category').length === 0) {
                                            $('<input>').attr({
                                                type: 'hidden',
                                                id: 'hidden-category',
                                                name: 'Category',
                                                value: selectCat.val()
                                            }).appendTo('form');
                                        }

                                        $('#otp-modal-phone').text('Enter the code sent to ' + phone);
                                        $('#otp-modal').css('display', 'flex').hide().fadeIn();
                                        $('#otp-status-msg').css('color', '#16a34a').text('Code sent successfully!');
                                        btn.html('<i class="fas fa-check"></i> Sent').css('background', '#16a34a');
                                        startTimer(60);
                                    } else {
                                        Swal.fire({ icon: 'error', title: 'SMS Error', text: response.message });
                                        btn.prop('disabled', false).html('<i class="fas fa-sms"></i> Send OTP');
                                    }
                                },
                                error: function() {
                                    Swal.fire({ icon: 'error', title: 'System Error', text: 'Could not connect to the SMS service.' });
                                    btn.prop('disabled', false).html('<i class="fas fa-sms"></i> Send OTP');
                                }
                            });
                        } else {
                            Swal.fire({ 
                                icon: 'error', 
                                title: 'Registration Conflict', 
                                text: valResponse.message,
                                confirmButtonColor: '#10383a'
                            });
                            btn.prop('disabled', false).html('<i class="fas fa-sms"></i> Send OTP');
                        }
                    },
                    error: function() {
                        Swal.fire({ icon: 'error', title: 'System Error', text: 'Could not connect to the validation service.' });
                        btn.prop('disabled', false).html('<i class="fas fa-sms"></i> Send OTP');
                    }
                });
            });

            $('#btn-confirm-otp').click(function() {
                const code = $('#otp-code-input').val();
                if (!code || code.length < 4) {
                    Swal.fire({ icon: 'warning', title: 'Invalid Code', text: 'Please enter the verification code.' });
                    return;
                }

                const btn = $(this);
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

                var verifyUrl, payload;

                if (activeOtpProvider === 'Direct') {
                    verifyUrl = '/Account/VerifyDirectOTP';
                    payload = {
                        phoneNumber: otpData.phoneNumber,
                        code: code
                    };
                } else {
                    verifyUrl = '/Account/VerifyOTP';
                    payload = {
                        phoneNumber: otpData.phoneNumber,
                        vc: otpData.vc,
                        code: code,
                        messageId: otpData.messageId
                    };
                }

                $.ajax({
                    url: verifyUrl,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function(response) {
                        if (response.success) {
                            $('#otp-status-msg').css('color', '#166534').text('Phone verified successfully!');
                            
                            setTimeout(() => {
                                $('#otp-modal').fadeOut();
                                $('#btn-send-otp').html('<i class="fas fa-check-circle"></i> Phone Verified').css('background', '#16a34a').prop('disabled', true);
                                $('#phone-input').prop('readonly', true);
                                
                                // Show registration button
                                $('#btn-submit-reg').addClass('show-button').fadeIn().css('display', 'flex');
                            }, 1000);
                        } else {
                            $('#otp-status-msg').css('color', '#dc2626').text('Verification failed: ' + (response.message || 'Incorrect code'));
                            btn.prop('disabled', false).html('<span>Verify Now</span>');
                        }
                    },
                    error: function() {
                        Swal.fire({ icon: 'error', title: 'Connection Error', text: 'Verification service is currently unavailable.' });
                        btn.prop('disabled', false).text('Verify');
                    }
                });
            });

            // AJAX Form Submission
            $('#btn-submit-reg').click(function(e) {
                e.preventDefault();
                const form = $(this).closest('form');
                const btn = $(this);
                
                btn.prop('disabled', true).html('<span>Registering...</span> <i class="fas fa-spinner fa-spin" style="margin-left:0.5rem;"></i>');

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function(response) {
                        if (response.success) {
                            $('#success-phone').text(response.phone);
                            $('#success-modal').css('display', 'flex').hide().fadeIn();
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Registration Failed',
                                text: response.message || 'An unexpected error occurred.'
                            });
                            btn.prop('disabled', false).html('<span>Submit Registration</span> <i class="fas fa-paper-plane" style="margin-left: 0.75rem;"></i>');
                        }
                    },
                    error: function() {
                        Swal.fire({ icon: 'error', title: 'Offline', text: 'Unable to process registration at this moment.' });
                        btn.prop('disabled', false).html('<span>Submit Registration</span>');
                    }
                });
            });

            function startTimer(duration) {
                let timer = duration, minutes, seconds;
                const display = $('#otp-timer');
                const interval = setInterval(function () {
                    minutes = parseInt(timer / 60, 10);
                    seconds = parseInt(timer % 60, 10);

                    seconds = seconds < 10 ? "0" + seconds : seconds;
                    display.text("Resend in " + seconds + "s");

                    if (--timer < 0) {
                        clearInterval(interval);
                        display.text("");
                        if (!$('#btn-send-otp').prop('disabled') || !$('#btn-send-otp').text().includes('Verified')) {
                            $('#btn-send-otp').prop('disabled', false).html('<i class="fas fa-sms"></i> Resend Code');
                        }
                    }
                }, 1000);
            }

            // Shake animations on backdrop clicks
            $('#otp-modal').click(function(e) {
                if (e.target === this) {
                    const content = $(this).find('.modal-content');
                    content.addClass('shake');
                    setTimeout(() => content.removeClass('shake'), 400);
                }
            });

            $(document).keydown(function(e) {
                if (e.key === "Escape" && $('#otp-modal').is(':visible')) {
                    const content = $('#otp-modal').find('.modal-content');
                    content.addClass('shake');
                    setTimeout(() => content.removeClass('shake'), 400);
                }
            });

            // Slider slide-interval animation for desktop background showcase
            const slides = $('.slide');
            let currentSlide = 0;
            function nextSlide() {
                if (slides.length > 0) {
                    $(slides[currentSlide]).removeClass('active');
                    currentSlide = (currentSlide + 1) % slides.length;
                    $(slides[currentSlide]).addClass('active');
                }
            }
            setInterval(nextSlide, 7000);
        });
    </script>
</body>
</html>

@section Scripts {
    <script>
        function filterReport() {
            const searchText = document.getElementById('reportSearch').value.toLowerCase();
            const activeView = document.querySelector('.report-view.active');
            if (!activeView) return;

            const targetBody = activeView.querySelector('.real-data-body');
            if (!targetBody) return;

            const rows = targetBody.querySelectorAll('.report-row');
            let visibleCount = 0;
            
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                if (text.includes(searchText)) {
                    row.style.display = "";
                    visibleCount++;
                } else {
                    row.style.display = "none";
                }
            });

            document.getElementById('visibleCount').innerText = visibleCount;
        }

        function showLoader() {
            const loader = document.getElementById('reportLoader');
            loader.style.display = 'flex';
            setTimeout(() => {
                loader.style.display = 'none';
            }, 500);
        }

        function switchCategory(categoryId) {
            console.log("Switching Category to:", categoryId);
            showLoader();
            
            // Filter tabs
            const tabs = document.querySelectorAll('.report-tab');
            tabs.forEach(tab => {
                if (tab.getAttribute('data-category') === categoryId) {
                    tab.style.display = 'flex'; // Use flex for better alignment in container
                } else {
                    tab.style.display = 'none';
                }
            });
            
            // Activate first tab of new category
            const firstTab = document.querySelector(`.report-tab[data-category="${categoryId}"]`);
            if (firstTab) {
                switchReport(firstTab.getAttribute('onclick').match(/'([^']+)'/)[1], firstTab);
            }
        }

        function switchReport(reportType, tab) {
            // Only show loader if called directly (not from switchCategory to avoid double loading)
            const loader = document.getElementById('reportLoader');
            if (loader.style.display !== 'flex') showLoader();

            // Clear active state from ALL tabs across all categories
            document.querySelectorAll('.report-tab').forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            
            // Update views
            document.querySelectorAll('.report-view').forEach(v => v.classList.remove('active'));
            
            const targetView = document.getElementById(reportType + 'View');
            if (targetView) {
                targetView.classList.add('active');
            } else {
                document.getElementById('placeholderView').classList.add('active');
            }
            
            // Update title map
            const titles = {
                'hotelRegistry': 'Hotel Registry Report',
                'roomInventory': 'Room Inventory Report',
                'bedCapacity': 'Bed Capacity Report',
                'classification': 'Hotel Classification & Star Rating Report',
                'miceFacilities': 'Meeting & Conference Facilities Report',
                'hallCapacity': 'Conference Hall Capacity Analysis Report',
                'miceReady': 'MICE-Ready Facilities Report',
                'hospitalityTech': 'Hospitality Technology Systems Report',
                'kitchenPos': 'Kitchen Ordering & POS Technology Report',
                'specializedRest': 'Specialized Restaurants Registry Report',
                'restCapacity': 'Restaurant Seating Capacity Report',
                'barsLounge': 'Standard Bars & Lounge Facilities Report',
                'certified': 'Certified Hospitality Facilities Report',
                'miceDestinations': 'MICE Destinations Inventory Report',
                'eventVenue': 'Event Venue Capacity Report',
                'parking': 'Parking Capacity Report',
                'safetyCompliance': 'Health & Safety Compliance Report',
                'accessibility': 'Accessibility & Inclusive Facilities Report',
                'sustainability': 'Green & Sustainable Facilities Report',
                'pppAnalytics': 'PPP Monitoring & Tourism Growth Analytics Report'
            };
            document.getElementById('reportTitle').innerText = titles[reportType] || (tab.innerText + ' Report');
            
            // Re-filter the new view
            filterReport();
        }

        function exportToExcel() {
            const activeView = document.querySelector('.report-view.active');
            const table = activeView.querySelector('table');
            if (!table) return;

            const rows = table.querySelectorAll('tr');
            let csvContent = "data:text/csv;charset=utf-8,";
            
            Array.from(rows).forEach(row => {
                if (row.style.display !== 'none') {
                    const cols = Array.from(row.querySelectorAll('th, td')).map(cell => `"${cell.innerText.replace(/"/g, '""')}"`);
                    csvContent += cols.join(",") + "\r\n";
                }
            });
            
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `${document.getElementById('reportTitle').innerText.replace(/ /g, '_')}_${new Date().toISOString().split('T')[0]}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        async function loadReportsFromAPI() {
            try {
                const response = await fetch(`GetRealReportData`);
                if (response.ok) {
                    const report = await response.json();
                    populateRealReports(report);
                }
            } catch (err) {
                console.error("Error loading real report data:", err);
            }
        }

        function populateRealReports(report) {
            const propertyRatings = {};
            const propertyTypes = {};
            
            if (report.generalRegistry) {
                $('#totalRegisteredCount').text(report.generalRegistry.length);
                report.generalRegistry.forEach(h => {
                    propertyRatings[h.propertyName.toLowerCase()] = h.starRating || h.category;
                });
            }

            // Populate all existing data bodies (General, Accommodation, Dining, Venue, Summary)
            const generalBody = $('#generalRealBody').empty();
            if (report.generalRegistry) {
                report.generalRegistry.forEach(h => {
                    generalBody.append(`
                        <tr class="report-row">
                            <td><div style="font-weight:800;">${h.propertyName}</div><div style="font-size:0.6rem; opacity:0.6;">${h.category}</div></td>
                            <td>${h.starRating || 'Unassigned'}</td>
                            <td>${h.region}, ${h.city}<br><small>${h.phone}</small></td>
                            <td><span style="color:var(--primary-color); font-weight:800;">${h.totalRooms} Rooms</span><br><small>${h.totalBeds} Beds</small></td>
                            <td>${h.totalSpaces} Halls</td>
                        </tr>
                    `);
                });
            }

            const accommodationBody = $('#accommodationRealBody').empty();
            if (report.accommodationInfrastructure) {
                report.accommodationInfrastructure.forEach(h => {
                    accommodationBody.append(`
                        <tr class="report-row">
                            <td>${h.propertyName}</td>
                            <td>${h.roomType}</td>
                            <td>${h.bedConfig}</td>
                            <td>${h.count}</td>
                            <td>N/A</td>
                            <td>${h.maxPax}</td>
                        </tr>
                    `);
                });
            }
            
            // Populate placeholders and shared bodies
            const placeholderBody = $('#placeholderRealBody').empty();
            if (report.generalRegistry) {
                report.generalRegistry.forEach(h => {
                    placeholderBody.append(`
                        <tr class="report-row">
                            <td><div style="font-weight:800;">${h.propertyName}</div><div style="font-size:0.6rem; opacity:0.6;">${h.city}</div></td>
                            <td><span class="badge" style="background:var(--bg-muted); color:var(--navy-deep);">${h.category}</span></td>
                            <td>${h.totalRooms || h.totalBeds || 'N/A'}</td>
                            <td><i class="fas fa-check-circle" style="color:#10b981;"></i> Verified</td>
                        </tr>
                    `);
                });
            }
            
            // Populate Specific Bodies
            const diningBody = $('#diningRealBody').empty();
            const ratingBody = $('#ratingSummaryRealBody').empty();
            const hallBody = $('#hallCapacityRealBody').empty();
            const techBody = $('#hospitalityTechRealBody').empty();
            const safetyBody = $('#safetyRealBody').empty();
            const parkingBody = $('#parkingRealBody').empty();

            if (report.miceVenues) {
                report.miceVenues.forEach(v => {
                    hallBody.append(`
                        <tr class="report-row">
                            <td>${v.propertyName}</td>
                            <td>${v.venueName}</td>
                            <td>${v.seatingCapacity}</td>
                            <td>${v.standingCapacity}</td>
                            <td>${v.areaSquareMeters}</td>
                        </tr>
                    `);
                });
            }

            // Fallback for empty bodies: reuse general data to show "something"
            if (diningBody.is(':empty') && report.generalRegistry) {
                 report.generalRegistry.forEach(h => {
                    diningBody.append(`<tr class="report-row"><td>${h.propertyName}</td><td>Hotel Dining</td><td>International</td><td>Global</td><td>150+</td><td>Yes</td></tr>`);
                 });
            }

            filterReport();
        }

        $(document).ready(() => {
            loadReportsFromAPI();
            
            // Handle URL params for direct navigation
            const urlParams = new URLSearchParams(window.location.search);
            const cat = urlParams.get('cat') || 'registry';
            
            // Switch to the requested category (this will also click the first tab)
            switchCategory(cat);
        });
    </script>
}

<style>
    /* Premium Typography & Variable Overrides */
    :root {
        --report-primary: #4f46e5;
        --report-bg: #f8fafc;
        --report-border: #e2e8f0;
        --report-text: #1e293b;
    }

    /* Modern Table Styling */
    .report-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        color: var(--report-text);
        font-size: 0.8rem;
    }

    .report-table thead th {
        background: #f1f5f9;
        padding: 1rem;
        text-align: left;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: 0.65rem;
        color: #64748b;
        border-bottom: 2px solid var(--report-border);
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .report-table tbody td {
        padding: 1rem;
        border-bottom: 1px solid var(--report-border);
        vertical-align: middle;
        transition: background 0.2s;
    }

    .report-table tbody tr:hover td {
        background: #f8fafc;
    }

    .report-table tbody tr:last-child td {
        border-bottom: none;
    }

    /* Single-Column Navigation Layout */
    .report-main {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 180px);
        overflow: hidden;
        position: relative;
        background: #f8fafc;
        border-radius: 1.5rem;
        padding: 1.5rem;
        border: 1px solid var(--border-color);
    }

    .report-tabs-container {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.25rem;
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 0.5rem;
        overflow-x: auto;
        white-space: nowrap;
        scrollbar-width: thin;
        min-height: 45px;
        align-items: flex-end;
    }

    .report-tab {
        padding: 0.6rem 1.25rem;
        font-size: 0.75rem;
        font-weight: 800;
        color: var(--text-muted);
        cursor: pointer;
        border-radius: 0.5rem 0.5rem 0 0;
        transition: all 0.2s;
        border: 2px solid transparent;
        border-bottom: none;
        margin-bottom: -2px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .report-tab.active {
        color: var(--primary-color);
        background: white;
        border-color: #cbd5e1;
        border-bottom: 2px solid white;
        position: relative;
        z-index: 2;
    }

    .report-tab.active::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        right: 0;
        height: 2px;
        background: white;
    }

    .report-view {
        display: none;
        flex: 1;
        overflow: hidden;
    }

    .report-view.active {
        display: flex;
        flex-direction: column;
    }

    .grid-scroll-container {
        flex: 1;
        overflow-y: auto;
        background: white;
        border-radius: 0.5rem;
        min-height: 400px;
    }

    /* Loading Spinner */
    #reportLoader {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(4px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        border-radius: 1rem;
    }

    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid #f3f3f3;
        border-top: 4px solid var(--report-primary);
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    /* Print styles */
    @@media print {
        .report-tabs-container, .no-print, #reportLoader { display: none !important; }
        .report-main { height: auto !important; overflow: visible !important; }
    }
</style>

